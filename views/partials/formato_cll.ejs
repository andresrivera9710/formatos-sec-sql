<%
  const comp = (cllState && cllState.complemento) ? cllState.complemento : {};
  const detalles = (cllState && Array.isArray(cllState.detalles)) ? cllState.detalles : [];

  let fechaVal = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaVal = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (comp.Fecha) {
    const d = new Date(comp.Fecha);
    if (!Number.isNaN(d.getTime())) fechaVal = d.toISOString().substring(0, 10);
  }

  const agenteActual = (user && (user.usuario || user.nombreCompleto)) ? String(user.usuario || user.nombreCompleto).trim() : '';
  const agenteSegVal = comp.AgenteSeguridad ? String(comp.AgenteSeguridad).trim() : agenteActual;
  const rawAgenteDelta = comp.AgenteDelta ? String(comp.AgenteDelta).trim() : '';
  const agDeltaParts = rawAgenteDelta.split(',').map(s => s.trim());
  const agenteDeltaVal = agDeltaParts[0] || '';
  const tiaLdVal = agDeltaParts.slice(1).join(', ').trim();
  const agenteTiaVal = comp.AgenteTIA ? String(comp.AgenteTIA).trim() : '';

  const initialCllPayload = {
    formatoId: formato.id,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    fecha: fechaVal,
    station: 'GUA',
    agenteSeguridad: agenteSegVal,
    agenteDelta: agenteDeltaVal,
    agenteTIA: agenteTiaVal,
    tiaLD: tiaLdVal,
    registros: detalles
  };
%>

<form id="formCapturaCLL" novalidate>
  <input type="hidden" id="cllFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="cllItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="cllEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. ENCABEZADO CARGO LOADING LOG -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-dolly-flatbed"></i> Cargo Loading Log — DELTA (<%= vuelo.novuelo || '--' %>)
      </h3>
      <div class="sio-card-header-meta">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary sio-btn-sm">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="cllBadgeEstado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="cllFlight"><i class="fas fa-plane"></i> Flight # <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cllFlight" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cllFecha"><i class="far fa-calendar-alt"></i> Date <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="cllFecha" class="form-control input-locked" value="<%= fechaVal %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="cllStation"><i class="fas fa-map-marker-alt"></i> Station <i class="fas fa-lock input-lock-icon" title="Estación GUA (Solo lectura)"></i></label>
        <input type="text" id="cllStation" class="form-control input-locked" maxlength="10" value="GUA" readonly tabindex="-1">
      </div>
    </div>
  </div>

  <!-- 2. PANEL DE CAPTURA RÁPIDA DE GUÍA AÉREA -->
  <div class="card sio-card-accent">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title"><i class="fas fa-boxes"></i> Agregar Guía Aérea (Airway Bill)</h3>
      <small class="sio-hint-text">Todos los campos con <span class="sio-required-star">*</span> son obligatorios</small>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="cllInputGuia">Airway Bill # (Guía) <span class="sio-required-star">*</span></label>
        <input type="text" id="cllInputGuia" class="form-control" maxlength="100" placeholder="Ej: 006-12345678" autocomplete="off" enterkeyhint="next">
      </div>
      <div class="form-group sio-grid-span-2">
        <label for="cllInputContenido">Contents (Contenido) <span class="sio-required-star">*</span></label>
        <input type="text" id="cllInputContenido" class="form-control" maxlength="200" placeholder="Ej: TEXTILES / GENERAL CARGO" autocomplete="off" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="cllInputPiezas"># Pieces (Piezas) <span class="sio-required-star">*</span></label>
        <input type="number" id="cllInputPiezas" class="form-control" min="1" step="1" inputmode="numeric" placeholder="Ej: 12" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="cllInputBIN">Loaded BIN # <span class="sio-required-star">*</span></label>
        <input type="text" id="cllInputBIN" class="form-control" maxlength="50" placeholder="Ej: BIN 1 / FWD" autocomplete="off" enterkeyhint="done">
      </div>
    </div>

    <div class="sio-form-actions-end cp-form-actions">
      <button type="button" id="btnAgregarFilaVaciaCLL" class="btn btn-secondary">
        <i class="fas fa-table"></i> + Insertar Fila en Blanco
      </button>
      <button type="button" id="btnAgregarRegistroCLL" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Agregar Guía a Cuadrícula
      </button>
    </div>
  </div>

  <!-- 3. CUADRÍCULA FLUIDA -->
  <div class="card" id="cllCardCuadricula">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title"><i class="fas fa-list-ol"></i> Guías de Carga Registradas</h3>
      <div class="sio-card-header-meta">
        <span class="er-total-counter-badge">Guías: <strong id="cllTotalGuiasBadge"><%= detalles.length %></strong></span>
        <span class="er-total-counter-badge">Total Piezas: <strong id="cllTotalPiezasBadge">0</strong></span>
      </div>
    </div>

    <div class="er-fluid-grid-wrapper dl-grid-wrapper" id="cllGridWrapper">
      <table class="er-fluid-table dl-stacked-table" id="cllTablaCuadricula">
        <thead>
          <tr>
            <th class="dl-th-num">NO.</th>
            <th class="dl-th-guia">AIRWAY BILL # <span class="er-req-star">*</span></th>
            <th>CONTENTS <span class="er-req-star">*</span></th>
            <th class="dl-th-qty"># PIECES <span class="er-req-star">*</span></th>
            <th class="dl-th-bin">LOADED BIN # <span class="er-req-star">*</span></th>
            <th class="dl-th-action">ACCIÓN</th>
          </tr>
        </thead>
        <tbody id="cllTbodyRegistros"></tbody>
      </table>
    </div>
  </div>

  <!-- 4. RESPONSABLES Y FIRMAS DIGITALES (Orden 1:1 Power Apps: cada responsable junto a su firma) -->
  <div class="sio-grid-split">
    <div class="card">
      <div class="card-header sio-card-header-flex">
        <h3 class="cp-section-title"><i class="fas fa-user-shield"></i> Security Agent &amp; Signature</h3>
        <button type="button" id="btnLimpiarFirmaSecCLL" class="btn btn-secondary sio-btn-xs">
          <i class="fas fa-eraser"></i> Limpiar
        </button>
      </div>

      <div class="sio-grid-auto sio-mb-14">
        <div class="form-group">
          <label for="cllAgenteSeguridad">Security Agent <i class="fas fa-lock input-lock-icon" title="Agente autenticado en sesión (Solo lectura)"></i></label>
          <input type="text" id="cllAgenteSeguridad" class="form-control input-locked" maxlength="150" value="<%= agenteSegVal %>" readonly tabindex="-1" required>
        </div>
        <div class="form-group">
          <label for="cllAgenteTIA">TIA # (Security) <span class="sio-required-star">*</span></label>
          <input type="text" id="cllAgenteTIA" class="form-control" inputmode="numeric" pattern="[0-9]*" data-numeric-only="true" maxlength="100" value="<%= agenteTiaVal %>" placeholder="Ej: 12345" required>
        </div>
      </div>

      <div class="signature-box" id="cllSigBoxSec">
        <canvas id="cllCanvasFirmaSecurity"></canvas>
      </div>
    </div>

    <div class="card">
      <div class="card-header sio-card-header-flex">
        <h3 class="cp-section-title"><i class="fas fa-user-tie"></i> DL Load / Ramp Agent &amp; Signature</h3>
        <button type="button" id="btnLimpiarFirmaLdCLL" class="btn btn-secondary sio-btn-xs">
          <i class="fas fa-eraser"></i> Limpiar
        </button>
      </div>

      <div class="sio-grid-auto sio-mb-14">
        <div class="form-group">
          <label for="cllAgenteDelta">DL Load / Ramp Agent <span class="sio-required-star">*</span></label>
          <input type="text" id="cllAgenteDelta" class="form-control" maxlength="150" value="<%= agenteDeltaVal %>" placeholder="Nombre representante DL" required>
        </div>
        <div class="form-group">
          <label for="cllTiaLD">TIA # (DL Agent)</label>
          <input type="text" id="cllTiaLD" class="form-control" inputmode="numeric" pattern="[0-9]*" data-numeric-only="true" maxlength="100" value="<%= tiaLdVal %>" placeholder="TIA # agente DL">
        </div>
      </div>

      <div class="signature-box" id="cllSigBoxLd">
        <canvas id="cllCanvasFirmaLD"></canvas>
      </div>
    </div>
  </div>

  <!-- 5. ACCIONES -->
  <div class="sio-bottom-actions">
    <button type="button" id="btnVistaPreliminarCLL" class="btn btn-secondary sio-btn-action">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoCLL" class="btn btn-primary sio-btn-action-primary">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="cllInitialStateJson"><%- JSON.stringify(initialCllPayload).replace(/</g, '\\u003c') %></script>
