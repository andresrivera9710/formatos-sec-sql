<%
  const u = (typeof user !== 'undefined' && user)
    ? user
    : ((typeof currentUser !== 'undefined' && currentUser) ? currentUser : {});
  const loginName = u.usuario || u.nombreCompleto || 'Usuario SEC';
  const userRole = u.puestoSec || 'AGENTE';
  const userDept = u.departamentoNombre || 'E8. SEGURIDAD AEROPORTUARIA';
  const nameParts = String(loginName).trim().split(/\s+/).filter(Boolean);
  const initials = nameParts.length >= 2
    ? (nameParts[0][0] + nameParts[1][0]).toUpperCase()
    : String(loginName).substring(0, 2).toUpperCase();
  const isOperacionesActive = (
    typeof activeTab === 'undefined' ||
    activeTab === 'operaciones' ||
    activeTab === 'formatos'
  );
  const currentRouteAttr = typeof activeTab !== 'undefined' ? activeTab : 'operaciones';
%>
<!-- Tab Bar Inferior Moderno con Efecto Sliding Pill (Bottom Floating Dock en Web y Móvil) -->
<div class="sio-bottom-nav-zone">
  <nav id="sioTabBar" class="sio-tab-bar" data-active-route="<%= currentRouteAttr %>" aria-label="Navegación Principal de Operaciones">
    <span id="navPillIndicator" class="nav-pill-indicator" aria-hidden="true"></span>

    <!-- 1. Operaciones (Activo por defecto en /operaciones) -->
    <a
      href="/operaciones"
      class="tab-bar-item <%= isOperacionesActive ? 'is-active' : '' %>"
      data-tab="operaciones"
      aria-current="<%= isOperacionesActive ? 'page' : 'false' %>"
    >
      <span class="tab-bar-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-svg-icon">
          <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
        </svg>
      </span>
      <span class="tab-bar-label">Operaciones</span>
    </a>

    <!-- 2. Modo Noche (Luna / Sol con persistencia en localStorage) -->
    <button
      type="button"
      id="btnTabThemeToggle"
      class="tab-bar-item"
      data-tab="theme"
      aria-label="Alternar Modo Noche"
      aria-pressed="false"
      title="Alternar entre Modo Claro y Modo Noche"
    >
      <span class="tab-bar-icon tab-theme-icon-wrap" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-svg-icon icon-moon">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-svg-icon icon-sun">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </span>
      <span class="tab-bar-label" id="tabThemeText">Modo Noche</span>
    </button>

    <!-- 3. Indicador de Señal / Conectividad en Tiempo Real + Cola Offline IndexedDB -->
    <button
      type="button"
      id="btnTabNetworkStatus"
      class="tab-bar-item tab-bar-item-network is-online"
      data-tab="network"
      aria-live="polite"
      aria-label="Estado de conexión: En línea"
      title="En línea — Conectado con servidor SIO y Azure SQL"
    >
      <span class="tab-bar-icon tab-network-icon-wrap" aria-hidden="true">
        <!-- Ícono Wi-Fi Activo (Con Señal / En Línea) -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-svg-icon icon-wifi-online">
          <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
          <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
          <line x1="12" y1="20" x2="12.01" y2="20"/>
        </svg>
        <!-- Ícono Wi-Fi Tachado (Sin Señal / Modo Caché Offline) -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-svg-icon icon-wifi-offline">
          <line x1="1" y1="1" x2="23" y2="23"/>
          <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/>
          <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/>
          <path d="M10.71 5.05A16 16 0 0 1 22.58 9"/>
          <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
          <line x1="12" y1="20" x2="12.01" y2="20"/>
        </svg>
        <span id="tabNetworkPulseDot" class="tab-net-dot is-online" aria-hidden="true"></span>
      </span>
      <span class="tab-bar-label" id="tabNetworkText">En línea</span>
      <span id="tabNetworkPendingBadge" class="tab-net-pending-badge" hidden title="Formatos pendientes por sincronizar">0</span>
    </button>

    <!-- 4. Perfil de Usuario (Nombre de Login y Puesto desde req.session.user) -->
    <div
      id="btnTabUserProfile"
      class="tab-bar-item tab-bar-item-profile"
      data-tab="profile"
      role="button"
      tabindex="0"
      aria-expanded="false"
      aria-haspopup="dialog"
      title="Perfil de sesión: <%= loginName %> (<%= userRole %>)"
    >
      <span class="tab-profile-avatar" aria-hidden="true"><%= initials %></span>
      <span class="tab-profile-info">
        <span class="tab-profile-name"><%= loginName %></span>
        <span class="tab-profile-role"><%= userRole %></span>
      </span>

      <div id="tabProfileTooltip" class="tab-profile-tooltip" role="dialog" aria-label="Resumen de sesión del usuario">
        <div class="tab-tooltip-header">
          <span class="tab-tooltip-avatar"><%= initials %></span>
          <div class="tab-tooltip-titles">
            <strong class="tab-tooltip-name"><%= loginName %></strong>
            <span class="tab-tooltip-badge"><%= userRole %></span>
          </div>
        </div>
        <div class="tab-tooltip-body">
          <div class="tab-tooltip-row">
            <span class="tab-tooltip-key">Login SEC</span>
            <span class="tab-tooltip-val"><%= loginName %></span>
          </div>
          <div class="tab-tooltip-row">
            <span class="tab-tooltip-key">Departamento</span>
            <span class="tab-tooltip-val"><%= userDept %></span>
          </div>
          <div class="tab-tooltip-row">
            <span class="tab-tooltip-key">Estado</span>
            <span class="tab-tooltip-status" id="tabTooltipNetState"><span class="tab-status-dot" id="tabTooltipNetDot"></span> <span id="tabTooltipNetLabel">En línea (Sesión Activa)</span></span>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Cerrar Sesión (Acento suave --danger #DC2626) -->
    <a
      href="/logout"
      id="btnTabLogout"
      class="tab-bar-item tab-bar-item-logout"
      data-tab="logout"
      aria-label="Cerrar Sesión"
      title="Cerrar Sesión"
    >
      <span class="tab-bar-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-svg-icon">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </span>
      <span class="tab-bar-label">Cerrar Sesión</span>
    </a>
  </nav>
</div>
