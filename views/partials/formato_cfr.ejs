<%
  const comp = (cfrState && cfrState.complemento) ? cfrState.complemento : {};
  const detalles = (cfrState && Array.isArray(cfrState.detalles)) ? cfrState.detalles : [];

  let fechaInicial = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (comp.Fecha) {
    fechaInicial = String(comp.Fecha instanceof Date ? comp.Fecha.toISOString() : comp.Fecha).substring(0, 10);
  }

  const fmtTime = (val) => {
    if (!val) return '';
    const s = String(val instanceof Date ? val.toISOString() : val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/([01]\d|2[0-3]):([0-5]\d)/);
    return m ? `${m[1]}:${m[2]}` : '';
  };

  const supervisorIdVal = comp.EmpleadoId ? String(comp.EmpleadoId) : '';
  const primeraHoraVal = fmtTime(comp.PrimeraPlataforma);
  const ultimaHoraVal = fmtTime(comp.UltimaPlataforma);
  const inicioOpVal = fmtTime(comp.InicioOperacion);
  const horaCierreVal = fmtTime(comp.HoraCierre);
  const aviCantidadVal = comp.AviCantidad !== undefined && comp.AviCantidad !== null ? Number(comp.AviCantidad) : 0;
  const comatCantidadVal = comp.ComatCantidad !== undefined && comp.ComatCantidad !== null ? Number(comp.ComatCantidad) : 0;
  const agenteActual = (user && (user.usuario || user.nombreCompleto)) ? String(user.usuario || user.nombreCompleto).trim() : '';

  const operadoresCatalogo = (usuariosLogin && usuariosLogin.length > 0)
    ? usuariosLogin.map(u => ({
        EmpleadoId: u.EmpleadoId,
        Nombre: u.Usuario,
        Codigo: u.Codigo || '',
        Puesto: u.PuestoEmpleado || u.Puesto || ''
      }))
    : (empleados || []).map(e => ({
        EmpleadoId: e.EmpleadoId,
        Nombre: e.Nombre,
        Codigo: e.Codigo || '',
        Puesto: e.Puesto || ''
      }));

  const initialCfrPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    fecha: fechaInicial,
    supervisorEmpleadoId: supervisorIdVal,
    primeraPlataforma: primeraHoraVal,
    ultimaPlataforma: ultimaHoraVal,
    inicioOperacion: inicioOpVal,
    horaCierre: horaCierreVal,
    aviCantidad: aviCantidadVal,
    comatCantidad: comatCantidadVal,
    agenteActual,
    maquinaria: maquinaria || [],
    operadores: operadoresCatalogo,
    carretas: detalles
  };
%>

<form id="formCapturaCFR" novalidate>
  <input type="hidden" id="cfrFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="cfrItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="cfrEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. ENCABEZADO OPERATIVO (Orden 1:1 scrARAJET.pa.yaml) -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-barcode"></i> Control de Flejes en Rayos X — <%= vuelo.operador %> (<%= vuelo.novuelo || '--' %>)
      </h3>
      <div class="sio-card-header-meta">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary sio-btn-sm">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="cfrBadgeEstado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="cfrFecha"><i class="far fa-calendar-alt"></i> Fecha de Inspección <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="cfrFecha" class="form-control input-locked" value="<%= fechaInicial %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="cfrNoVuelo"><i class="fas fa-plane"></i> No. Vuelo <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cfrNoVuelo" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cfrDestino"><i class="fas fa-map-marker-alt"></i> Destino <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cfrDestino" class="form-control input-locked" value="<%= vuelo.Destino || vuelo.destino || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cfrMatricula"><i class="fas fa-barcode"></i> Matrícula <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cfrMatricula" class="form-control input-locked" value="<%= vuelo.Matricula || 'Pendiente' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cfrSupervisor"><i class="fas fa-user-tie"></i> Supervisor de Turno (LoginSEC) <span class="sio-required-star">*</span></label>
        <select id="cfrSupervisor" class="form-control" required data-search-placeholder="Buscar supervisor por nombre, código o puesto...">
          <option value="">-- Seleccione Supervisor --</option>
          <% (supervisores || []).forEach(sup => { %>
            <option
              value="<%= sup.EmpleadoId %>"
              data-login-id="<%= sup.LoginId || '' %>"
              data-nombre="<%= sup.Usuario %>"
              data-code="<%= sup.Codigo || '' %>"
              data-puesto="<%= sup.PuestoEmpleado || sup.Puesto || '' %>"
              data-meta="<%= sup.NombreCompleto || '' %>"
              <%= String(supervisorIdVal) === String(sup.EmpleadoId) ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="cfrAgenteAVSEC"><i class="fas fa-user-shield"></i> Agente AVSEC / Seguridad <i class="fas fa-lock input-lock-icon" title="Agente autenticado en sesión (Solo lectura)"></i></label>
        <input type="text" id="cfrAgenteAVSEC" class="form-control input-locked" value="<%= agenteActual %>" readonly tabindex="-1">
      </div>
    </div>

    <div class="sio-grid-auto sio-mt-16 sio-panel-box">
      <div class="form-group">
        <label for="cfrInicioOperacion"><i class="far fa-clock"></i> Inicio de Operación <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="cfrInicioOperacion" class="form-control" value="<%= inicioOpVal %>" required>
          <button type="button" class="cp-clock-btn" data-cfr-clock="cfrInicioOperacion" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cfrPrimeraPlataforma"><i class="far fa-clock"></i> Enviada a Plataforma — 1RA Hora <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="cfrPrimeraPlataforma" class="form-control" value="<%= primeraHoraVal %>" required>
          <button type="button" class="cp-clock-btn" data-cfr-clock="cfrPrimeraPlataforma" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cfrUltimaPlataforma"><i class="far fa-clock"></i> Enviada a Plataforma — ÚLTIMA Hora <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="cfrUltimaPlataforma" class="form-control" value="<%= ultimaHoraVal %>" required>
          <button type="button" class="cp-clock-btn" data-cfr-clock="cfrUltimaPlataforma" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cfrAviCantidad"><i class="fas fa-paw"></i> AVIH (Cantidad)</label>
        <input type="number" id="cfrAviCantidad" class="form-control" min="0" step="1" inputmode="numeric" value="<%= aviCantidadVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="cfrComatCantidad"><i class="fas fa-boxes"></i> COMAT (Cantidad)</label>
        <input type="number" id="cfrComatCantidad" class="form-control" min="0" step="1" inputmode="numeric" value="<%= comatCantidadVal %>" placeholder="0">
      </div>
    </div>
  </div>

  <!-- 2. PANEL DE CAPTURA RÁPIDA DE CARRETA Y FLEJES (MARCHAMOS) -->
  <div class="card sio-card-accent">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-dolly-flatbed"></i> Agregar Carreta y Flejes (Marchamos)
      </h3>
      <small class="sio-hint-text">
        Todos los campos marcados con <strong class="sio-required-star">*</strong> son obligatorios
      </small>
    </div>

    <div class="sio-grid-auto-compact">
      <div class="form-group">
        <label for="cfrInputCarreta"><i class="fas fa-luggage-cart"></i> No. Carreta <span class="sio-required-star">*</span></label>
        <select id="cfrInputCarreta" class="form-control" data-search-placeholder="Buscar No. de carreta...">
          <option value="">-- Seleccione Carreta --</option>
          <% (maquinaria || []).forEach(m => { %>
            <option value="<%= m.MaquinariaEquipoId %>" data-unidad="<%= m.NoUnidad %>" data-code="<%= m.NoUnidad %>"><%= m.NoUnidad %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="cfrInputFlejeUno"><i class="fas fa-tag"></i> Fleje 1 (Marchamo) <span class="sio-required-star">*</span></label>
        <input type="text" id="cfrInputFlejeUno" class="form-control" inputmode="numeric" pattern="[0-9]*" data-numeric-only="true" maxlength="100" placeholder="Ej: 458901" autocomplete="off" enterkeyhint="next">
      </div>

      <div class="form-group">
        <label for="cfrInputFlejeDos"><i class="fas fa-tags"></i> Fleje 2 (Marchamo) <span class="sio-required-star">*</span></label>
        <input type="text" id="cfrInputFlejeDos" class="form-control" inputmode="numeric" pattern="[0-9]*" data-numeric-only="true" maxlength="100" placeholder="Ej: 458902" autocomplete="off" enterkeyhint="next">
      </div>

      <div class="form-group">
        <label for="cfrInputUnidad"><i class="fas fa-truck-pickup"></i> No. Unidad (Tractor) <span class="sio-required-star">*</span></label>
        <select id="cfrInputUnidad" class="form-control" data-search-placeholder="Buscar No. de unidad...">
          <option value="">-- Seleccione Unidad --</option>
          <% (maquinaria || []).forEach(m => { %>
            <option value="<%= m.MaquinariaEquipoId %>" data-unidad="<%= m.NoUnidad %>" data-code="<%= m.NoUnidad %>"><%= m.NoUnidad %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="cfrInputTotalEq"><i class="fas fa-suitcase"></i> Total Equipaje en Carreta <span class="sio-required-star">*</span></label>
        <input type="number" id="cfrInputTotalEq" class="form-control" min="0" step="1" inputmode="numeric" placeholder="Ej: 35" enterkeyhint="done">
      </div>

      <div class="form-group">
        <label for="cfrInputOperador"><i class="fas fa-id-card"></i> Operador <span class="sio-required-star">*</span></label>
        <select id="cfrInputOperador" class="form-control" data-search-placeholder="Buscar operador por nombre o código...">
          <option value="">-- Seleccione Operador --</option>
          <% operadoresCatalogo.forEach(op => { %>
            <option value="<%= op.EmpleadoId %>" data-nombre="<%= op.Nombre %>" data-code="<%= op.Codigo %>" data-puesto="<%= op.Puesto %>"><%= op.Nombre %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="sio-form-actions-end cp-form-actions">
      <button type="button" id="btnAgregarFilaVaciaCFR" class="btn btn-secondary">
        <i class="fas fa-table"></i> + Insertar Fila en Blanco
      </button>
      <button type="button" id="btnAgregarCarretaCFR" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Agregar Carreta a la Cuadrícula
      </button>
    </div>
  </div>

  <!-- 3. CUADRÍCULA FLUIDA DE CARRETAS Y FLEJES (DetalleCFR) -->
  <div class="card" id="cfrCardCuadricula">
    <div class="card-header sio-card-header-flex">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-th-list"></i> Carretas y Flejes Registrados
        </h3>
        <small class="sio-hint-text">
          Puede editar directamente cualquier fila o retirarla (Soft Delete en BD al actualizar).
        </small>
      </div>

      <div class="sio-card-header-meta">
        <span class="er-total-counter-badge">Total Carretas: <strong id="cfrTotalCarretasBadge"><%= detalles.length %></strong></span>
        <span class="er-total-counter-badge dl-badge-total">Total Equipaje: <strong id="cfrTotalEquipajeBadge">0</strong></span>
      </div>
    </div>

    <div class="er-fluid-grid-wrapper dl-grid-wrapper" id="cfrGridWrapper">
      <table class="er-fluid-table dl-stacked-table" id="cfrTablaCarretas">
        <thead>
          <tr>
            <th class="dl-th-num">NO.</th>
            <th class="dl-th-bin">NO. CARRETA <span class="er-req-star">*</span></th>
            <th class="dl-th-bin">FLEJE 1 <span class="er-req-star">*</span></th>
            <th class="dl-th-bin">FLEJE 2 <span class="er-req-star">*</span></th>
            <th class="dl-th-bin">NO. UNIDAD <span class="er-req-star">*</span></th>
            <th class="dl-th-qty">TOTAL EQ. <span class="er-req-star">*</span></th>
            <th>OPERADOR <span class="er-req-star">*</span></th>
            <th class="dl-th-action">ACCIÓN</th>
          </tr>
        </thead>
        <tbody id="cfrTbodyCarretas"></tbody>
      </table>
    </div>
  </div>

  <!-- 4. CIERRE DE OPERACIÓN (Orden 1:1 Power Apps Y:2964) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-flag-checkered"></i> Cierre de Operación en Rayos X</h3>
    </div>
    <div class="sio-grid-auto-lg">
      <div class="form-group">
        <label for="cfrHoraCierre"><i class="far fa-clock"></i> Hora de Cierre de Operación <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="cfrHoraCierre" class="form-control" value="<%= horaCierreVal %>" required>
          <button type="button" class="cp-clock-btn" data-cfr-clock="cfrHoraCierre" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. BOTONES DE ACCIÓN -->
  <div class="sio-bottom-actions">
    <button type="button" id="btnVistaPreliminarCFR" class="btn btn-secondary sio-btn-action">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoCFR" class="btn btn-primary sio-btn-action-primary">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="cfrInitialStateJson"><%- JSON.stringify(initialCfrPayload).replace(/</g, '\\u003c') %></script>
