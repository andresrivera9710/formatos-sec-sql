<!-- Pantalla Global de Carga Corporativa LAATS -->
<div id="sioLoadingOverlay" class="sio-loading-overlay" role="status" aria-live="polite" aria-hidden="true">
  <div class="sio-loading-card">
    <div class="sio-spinner-wrap">
      <div class="sio-spinner-ring"></div>
      <i class="fas fa-plane sio-spinner-icon"></i>
    </div>
    <div id="sioLoadingTitle" class="sio-loading-title">Procesando solicitud...</div>
    <div id="sioLoadingSubtitle" class="sio-loading-subtitle">Conectando con la base de datos de SIO LAATS, por favor espere.</div>
    <div class="sio-loading-status">
      <i class="fas fa-circle-notch fa-spin"></i>
      <span id="sioLoadingTimer">Ejecutando consulta (0.0s)</span>
    </div>
  </div>
</div>

