<%
  const det = (selState && selState.detalle) ? selState.detalle : {};

  const extractHHMM = (val) => {
    if (!val) return '';
    const s = String(val instanceof Date ? val.toISOString() : val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/([01]\d|2[0-3]):([0-5]\d)/);
    return m ? `${m[1]}:${m[2]}` : '';
  };

  let fechaVal = new Date().toISOString().substring(0, 10);
  if (det.Fecha) {
    const d = new Date(det.Fecha);
    if (!Number.isNaN(d.getTime())) fechaVal = d.toISOString().substring(0, 10);
  } else if (vuelo && vuelo.FechaItinerado) {
    fechaVal = String(vuelo.FechaItinerado).substring(0, 10);
  }

  const supCatalogo = (usuariosLogin && usuariosLogin.length > 0)
    ? usuariosLogin.map(u => ({ LoginId: u.LoginId, Usuario: u.Usuario }))
    : (supervisores || []).map(s => ({ LoginId: s.EmpleadoId, Usuario: s.Usuario }));

  const supLoginIdVal = det.LoginId ? String(det.LoginId) : (user && user.loginId ? String(user.loginId) : '');
  const agenteActual = (user && (user.usuario || user.nombreCompleto)) ? String(user.usuario || user.nombreCompleto).trim() : '';
  const ataVal = extractHHMM(vuelo && vuelo.ata);

  const initialSelPayload = {
    formatoId: formato.id,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo)
  };
%>

<form id="formCapturaSEL" novalidate>
  <input type="hidden" id="selFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="selItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="selEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. ENCABEZADO -->
  <div class="card">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-stream"></i> Sequence of Events Log — DELTA (<%= vuelo.novuelo || '--' %>)
      </h3>
      <div style="display: flex; align-items: center; gap: 10px;">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px;">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="selBadgeEstado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label><i class="fas fa-plane"></i> Flight #</label>
        <input type="text" class="form-control" value="<%= vuelo.novuelo || '--' %>" readonly style="background: var(--bg); font-weight: 700;">
      </div>
      <div class="form-group">
        <label for="selFecha"><i class="far fa-calendar-alt"></i> Date</label>
        <input type="date" id="selFecha" class="form-control" value="<%= fechaVal %>">
      </div>
      <div class="form-group">
        <label for="selAircraftArrived"><i class="fas fa-plane-arrival"></i> Aircraft Arrived (Date/Status)</label>
        <input type="text" id="selAircraftArrived" class="form-control" value="<%= fechaVal %>">
      </div>
      <div class="form-group">
        <label for="selAircraftArrivedTime"><i class="far fa-clock"></i> Arrival Time</label>
        <div class="cp-time-row">
          <input type="time" id="selAircraftArrivedTime" class="form-control" value="<%= ataVal %>">
          <button type="button" class="cp-clock-btn" data-sel-clock="selAircraftArrivedTime"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>
      <div class="form-group">
        <label for="selGuard"><i class="fas fa-user-shield"></i> Guard</label>
        <input type="text" id="selGuard" class="form-control" maxlength="150" value="<%= det.CreadoPor || agenteActual %>" placeholder="Guard name">
      </div>
      <div class="form-group">
        <label for="selSupervisor"><i class="fas fa-user-tie"></i> Supervisor (LoginSEC) <span style="color: var(--danger);">*</span></label>
        <select id="selSupervisor" class="form-control" required>
          <option value="">-- Seleccione Supervisor --</option>
          <% supCatalogo.forEach(sup => { %>
            <option
              value="<%= sup.LoginId %>"
              data-usuario="<%= sup.Usuario %>"
              <%= String(sup.LoginId) === supLoginIdVal ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <!-- 2. SECUENCIA DE EVENTOS OPERATIVOS -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-tasks"></i> Sequence of Events (13 Eventos Obligatorios)</h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="selHoraCierreFila">1. Passenger Line Closed <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraCierreFila" class="form-control" value="<%= extractHHMM(det.HoraCierreFila) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraCierreFila"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selCantidadPasajerosFila">2. Number of Passengers in Line <span style="color: var(--danger);">*</span></label>
        <input type="number" id="selCantidadPasajerosFila" class="form-control" min="0" step="1" value="<%= det.CantidadPasajerosFila ?? '' %>" placeholder="0" required>
      </div>

      <div class="form-group">
        <label for="selHoraChequeadoFila">3. Last Passenger in Line Checked In <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraChequeadoFila" class="form-control" value="<%= extractHHMM(det.HoraChequeadoFila) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraChequeadoFila"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selPrimerEqRevisada">4a. First Bags Sniffed / Screened <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selPrimerEqRevisada" class="form-control" value="<%= extractHHMM(det.PrimerEqRevisada) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selPrimerEqRevisada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selUltimoEqRevisado">4b. Last Bags Sniffed / Screened <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selUltimoEqRevisado" class="form-control" value="<%= extractHHMM(det.UltimoEqRevisado) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selUltimoEqRevisado"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selPrimerEqPuerta">5a. First Bags Arrive at Gate <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selPrimerEqPuerta" class="form-control" value="<%= extractHHMM(det.PrimerEqPuerta) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selPrimerEqPuerta"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selUltimoEqPuerta">5b. Last Bags Arrive at Gate <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selUltimoEqPuerta" class="form-control" value="<%= extractHHMM(det.UltimoEqPuerta) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selUltimoEqPuerta"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selCantidadPasajerosEmbarque">6. Passengers Arrived at Boarding Gate <span style="color: var(--danger);">*</span></label>
        <input type="text" id="selCantidadPasajerosEmbarque" class="form-control" maxlength="50" value="<%= det.CantidadPasajerosEmbarque ?? '' %>" placeholder="Ej: 156 o HH:mm" required>
      </div>

      <div class="form-group">
        <label for="selHoraInicioEmbarque">7. Passengers Commence Boarding <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraInicioEmbarque" class="form-control" value="<%= extractHHMM(det.HoraInicioEmbarque) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraInicioEmbarque"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selHoraUltimoAbandona">8. Last Passenger Leaves Gate <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraUltimoAbandona" class="form-control" value="<%= extractHHMM(det.HoraUltimoAbandona) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraUltimoAbandona"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selHoraDescargaEqCarga">9. Unloading Baggage &amp; Cargo Complete <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraDescargaEqCarga" class="form-control" value="<%= extractHHMM(det.HoraDescargaEqCarga) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraDescargaEqCarga"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selHoraInicioEqCarga">10. Baggage &amp; Cargo Loading Begins <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraInicioEqCarga" class="form-control" value="<%= extractHHMM(det.HoraInicioEqCarga) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraInicioEqCarga"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selHoraPuertasCerradasCar">11. Aircraft Cargo Doors Closed <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraPuertasCerradasCar" class="form-control" value="<%= extractHHMM(det.HoraPuertasCerradasCar) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraPuertasCerradasCar"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selHoraPuertasCerradasCab">12. Aircraft Cabin Doors Closed <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraPuertasCerradasCab" class="form-control" value="<%= extractHHMM(det.HoraPuertasCerradasCab) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraPuertasCerradasCab"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="selHoraInicioRodajeNave">13. Aircraft Begins Taxi <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="selHoraInicioRodajeNave" class="form-control" value="<%= extractHHMM(det.HoraInicioRodajeNave) %>" required>
          <button type="button" class="cp-clock-btn" data-sel-clock="selHoraInicioRodajeNave"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. COMMENTS & SUPERVISOR SIGNATURE -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
    <div class="card">
      <div class="card-header">
        <h3 class="cp-section-title"><i class="fas fa-comment-alt"></i> Comments / Observaciones</h3>
      </div>
      <div class="form-group" style="margin-bottom: 0;">
        <textarea id="selObservaciones" class="form-control" rows="5" maxlength="2000" placeholder="(Opcional) Ingrese comentarios adicionales de la secuencia de eventos..."><%= det.Observaciones || '' %></textarea>
      </div>
    </div>

    <div class="card">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 class="cp-section-title"><i class="fas fa-signature"></i> Supervisor Signature</h3>
        <button type="button" id="btnLimpiarFirmaSEL" class="btn btn-secondary" style="padding: 4px 10px; font-size: 11px;">
          <i class="fas fa-eraser"></i> Limpiar Firma
        </button>
      </div>
      <div class="signature-box">
        <canvas id="selCanvasFirmaSupervisor"></canvas>
      </div>
    </div>
  </div>

  <!-- 4. ACCIONES -->
  <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; margin-bottom: 40px;">
    <button type="button" id="btnVistaPreliminarSEL" class="btn btn-secondary" style="padding: 12px 24px;">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoSEL" class="btn btn-primary" style="padding: 12px 28px;">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="selInitialStateJson"><%- JSON.stringify(initialSelPayload).replace(/</g, '\\u003c') %></script>
