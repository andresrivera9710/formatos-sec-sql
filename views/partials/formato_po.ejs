<%
  const comp = (poState && poState.complemento) ? poState.complemento : {};
  const detalles = (poState && Array.isArray(poState.detalles)) ? poState.detalles : [];
  const posicionesCatalog = (posicionesPO && posicionesPO.length > 0) ? posicionesPO : [
    { PosicionId: 1, Posicion: 'CUSTODIO EQ. MOSTRADOR' },
    { PosicionId: 2, Posicion: 'PERIMETRIA' },
    { PosicionId: 3, Posicion: 'SERVICIOS ESPECIALES' },
    { PosicionId: 4, Posicion: 'REVISIONES AVSEC' },
    { PosicionId: 5, Posicion: 'RAYOS X' },
    { PosicionId: 6, Posicion: 'PTA. DEL AVION' },
    { PosicionId: 7, Posicion: 'VERIF. DE CABINA' },
    { PosicionId: 8, Posicion: 'CUST. DE EQ' },
    { PosicionId: 9, Posicion: 'FAJAS ENTRANDO' },
    { PosicionId: 10, Posicion: 'COMP. 1' },
    { PosicionId: 11, Posicion: 'COMP. 2' }
  ];

  let fechaInicial = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (comp.Fecha) {
    fechaInicial = String(comp.Fecha instanceof Date ? comp.Fecha.toISOString() : comp.Fecha).substring(0, 10);
  }

  const supLoginSecIdVal = comp.SupervisorLoginSECId ? String(comp.SupervisorLoginSECId) : '';
  const leadAgentVal = (user && user.usuario) ? String(user.usuario).trim() : '';
  const observacionVal = comp.Observaciones ? String(comp.Observaciones).trim() : '';

  const initialPoPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    posicionesCatalog,
    usuariosSEC: usuariosSEC || [],
    detalles
  };
%>

<form id="formCapturaPO" novalidate>
  <input type="hidden" id="poFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="poItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="poEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. CABECERA DEL FORMATO (PuestosPorOperacionAMX) -->
  <div class="card">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-users-cog"></i> Datos Generales — Puestos por Operación
      </h3>
      <div style="display: flex; align-items: center; gap: 10px;">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px;">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="poFecha"><i class="far fa-calendar-alt"></i> Fecha <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="poFecha" class="form-control input-locked" value="<%= fechaInicial %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="poNoVuelo"><i class="fas fa-plane"></i> No. Vuelo <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="poNoVuelo" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="poLeadAgent"><i class="fas fa-user-shield"></i> Lead Agent / Responsable <i class="fas fa-lock input-lock-icon" title="Agente autenticado en sesión (Solo lectura)"></i></label>
        <input type="text" id="poLeadAgent" class="form-control input-locked" value="<%= leadAgentVal %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="poSupervisor"><i class="fas fa-user-tie"></i> Supervisor de Seguridad (LoginSEC) <span style="color: var(--danger);">*</span></label>
        <select id="poSupervisor" class="form-control" required>
          <option value="">-- Seleccione el Supervisor --</option>
          <% (supervisores || []).forEach(sup => { %>
            <option
              value="<%= sup.LoginId %>"
              data-usuario="<%= sup.Usuario %>"
              <%= String(sup.LoginId) === supLoginSecIdVal ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <!-- 2. ASIGNACIÓN DE AGENTES Y POSICIONES (1..11) -->
  <div class="card" style="border-top: 3px solid var(--brand);" id="poCardMatriz">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-th-list"></i> Matriz de Distribución de Puestos por Operación
        </h3>
        <small style="color: var(--text-3); font-size: 11px;">
          Seleccione al agente y su puesto operativo (o haga clic directamente sobre cualquier casilla 1..11 de la fila para cambiar su posición marcada con <strong>X</strong>).
        </small>
      </div>

      <div class="er-total-counter-badge">
        <span>Total Agentes Asignados:</span>
        <strong id="poTotalAgentesCount">0</strong>
      </div>
    </div>

    <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; margin-bottom: 16px; background: var(--bg); padding: 14px; border-radius: 8px; border: 1px solid var(--border-2);">
      <div class="form-group" style="margin-bottom: 0; min-width: 240px; flex: 2;">
        <label for="poSelectAgente"><i class="fas fa-user-plus"></i> Agente de Seguridad <span style="color: var(--danger);">*</span></label>
        <select id="poSelectAgente" class="form-control">
          <option value="">-- Seleccione Agente SEC --</option>
          <% (usuariosSEC || []).forEach(u => { %>
            <option
              value="<%= u.EmpleadoId %>"
              data-usuario="<%= u.Usuario %>"
            ><%= u.Usuario %> (<%= u.Rol || 'AGENTE' %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0; min-width: 240px; flex: 2;">
        <label for="poSelectPosicion"><i class="fas fa-map-signs"></i> Puesto Operativo Asignado <span style="color: var(--danger);">*</span></label>
        <select id="poSelectPosicion" class="form-control">
          <option value="">-- Seleccione Puesto (1..11) --</option>
          <% posicionesCatalog.forEach(p => { %>
            <option value="<%= p.PosicionId %>"><%= p.PosicionId %> - <%= p.Posicion %></option>
          <% }) %>
        </select>
      </div>

      <button type="button" id="btnAgregarAgentePO" class="btn btn-primary" style="height: 38px;">
        <i class="fas fa-plus-circle"></i> Asignar Agente a la Matriz
      </button>
    </div>

    <!-- Tabla de 13 Columnas idéntica al Formato Oficial AMX -->
    <div class="er-fluid-grid-wrapper">
      <table class="er-fluid-table" id="poTablaMatriz" style="font-size: 11px;">
        <thead>
          <tr>
            <th style="width: 45px; text-align: center;">No.</th>
            <th style="min-width: 170px;">AGENTE DE SEGURIDAD <span class="er-req-star">*</span></th>
            <% posicionesCatalog.forEach(p => { %>
              <th style="width: 68px; text-align: center; font-size: 9px; line-height: 1.15;" title="<%= p.Posicion %>">
                <div style="color: var(--gold); font-weight: 800;">#<%= p.PosicionId %></div>
                <%= p.Posicion %>
              </th>
            <% }) %>
            <th style="width: 60px; text-align: center;">ACCIÓN</th>
          </tr>
        </thead>
        <tbody id="poTbodyMatriz">
          <!-- Renderizado dinámico por public/js/formato-po.js -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- 3. OBSERVACIONES Y FIRMA DEL SUPERVISOR -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
    <div class="card">
      <div class="card-header">
        <h3 class="cp-section-title"><i class="fas fa-comment-alt"></i> Observaciones Operativas</h3>
      </div>
      <div class="form-group">
        <label for="poObservaciones">Observaciones y Novedades de Distribución de Personal</label>
        <textarea id="poObservaciones" class="form-control" rows="5" maxlength="2000" placeholder="(Opcional) Ingrese observaciones sobre la asignación de puestos..."><%= observacionVal %></textarea>
      </div>
    </div>

    <div class="card">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 class="cp-section-title"><i class="fas fa-signature"></i> Firma del Supervisor SEC</h3>
        <button type="button" id="btnLimpiarFirmaPO" class="btn btn-secondary" style="padding: 4px 10px; font-size: 11px;">
          <i class="fas fa-eraser"></i> Limpiar Firma
        </button>
      </div>
      <div class="signature-box">
        <canvas id="poCanvasFirmaSupervisor"></canvas>
      </div>
      <p style="font-size: 11px; color: var(--text-3); text-align: center; margin-top: 4px;">
        Trace la firma del Supervisor para proyectarla en el Formato Controlado AMX.
      </p>
    </div>
  </div>

  <!-- 4. BOTONES DE ACCIÓN -->
  <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; margin-bottom: 40px;">
    <button type="button" id="btnVistaPreliminarPO" class="btn btn-secondary" style="padding: 12px 24px;">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial AMX)
    </button>
    <button type="button" id="btnGuardarDefinitivoPO" class="btn btn-primary" style="padding: 12px 28px;">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="poInitialStateJson"><%- JSON.stringify(initialPoPayload).replace(/</g, '\\u003c') %></script>
