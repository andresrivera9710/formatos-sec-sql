<%
  const comp = (cecState && cecState.complemento) ? cecState.complemento : {};
  const detalles = (cecState && Array.isArray(cecState.detalles)) ? cecState.detalles : [];

  const extractHHMM = (val) => {
    if (!val) return '';
    const s = String(val instanceof Date ? val.toISOString() : val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/(\d{2}:\d{2})/);
    return m ? m[1] : '';
  };

  let fechaInicial = new Date().toISOString().substring(0, 10);
  if (comp.Fecha) {
    fechaInicial = String(comp.Fecha instanceof Date ? comp.Fecha.toISOString() : comp.Fecha).substring(0, 10);
  } else if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  }

  const horaInicioVal = extractHHMM(comp.HoraInicio) || '';
  const supLoginIdVal = comp.SupervisorLoginId ? String(comp.SupervisorLoginId) : '';
  const agenteLoginIdVal = comp.AgenteLoginId
    ? String(comp.AgenteLoginId)
    : (user && user.loginSecId ? String(user.loginSecId) : '');
  const compartimientoVal = comp.Compartimiento !== undefined && comp.Compartimiento !== null ? String(comp.Compartimiento) : '1';
  const compAbiertoVal = extractHHMM(comp.CompAbierto) || '';
  const compCerradoVal = extractHHMM(comp.CompCerrado) || '';

  const embarqueInicioVal = extractHHMM(comp.EmbarqueInicio) || '';
  const embarqueFinalVal = extractHHMM(comp.EmbarqueFinal) || '';

  const desembarqueInicioVal = extractHHMM(comp.DesembarqueInicio) || '';
  const desembarqueFinalVal = extractHHMM(comp.DesembarqueFinal) || '';
  const equipajeVal = comp.Equipaje ?? '';
  const carruajesVal = comp.Carruajes ?? '';
  const correosVal = comp.Correos ?? '';
  const cargaVal = comp.Carga ?? '';
  const cantSinEtiqVal = comp.CantidadSinEtiqueta ?? '';
  const cantConEtiqVal = comp.CantidadConEtiqueta ?? '';

  const nombreOirsaVal = comp.NombreOirsa || '';
  const tiaOirsaVal = comp.TiaOirsa || '';
  const pilotoCombVal = comp.PilotoCombustible || '';
  const tiaPilotoCombVal = comp.TiaPilotoCombustible || '';
  const ayudanteCombVal = comp.AyudanteCombustible || '';
  const tiaAyudanteCombVal = comp.TiaAyudanteCombustible || '';
  const noUnidadCombVal = comp.NoUnidadCombustible || '';
  const combEntradaVal = extractHHMM(comp.CombustibleEntrada) || '';
  const combSalidaVal = extractHHMM(comp.CombustibleSalida) || '';

  const pilotoCocVal = comp.PilotoCocinas || '';
  const tiaPilotoCocVal = comp.TiaPilotoCocinas || '';
  const ayudanteCocVal = comp.AyudanteCocinas || '';
  const tiaAyudanteCocVal = comp.TiaAyudanteCocinas || '';
  const noUnidadCocVal = comp.NoUnidadCocinas || '';
  const cocEntradaVal = extractHHMM(comp.CocinasEntrada) || '';
  const cocSalidaVal = extractHHMM(comp.CocinasSalida) || '';

  const operadoresRampaVal = comp.OperadoresRampa || '';
  const observacionVal = comp.Observacion ? String(comp.Observacion).trim() : '';

  const initialCecPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    detalles
  };
%>

<form id="formCapturaCEC" novalidate>
  <input type="hidden" id="cecFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="cecItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="cecEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. ENCABEZADO DEL FORMATO (ControlEquipajeCompartimientoAMX) -->
  <div class="card">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-luggage-cart"></i> Datos Generales — Control de Equipajes en Compartimentos
      </h3>
      <div style="display: flex; align-items: center; gap: 10px;">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px;">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="cecFecha"><i class="far fa-calendar-alt"></i> Fecha <span style="color: var(--danger);">*</span></label>
        <input type="date" id="cecFecha" class="form-control" value="<%= fechaInicial %>" required>
      </div>

      <div class="form-group">
        <label for="cecHoraInicio"><i class="far fa-clock"></i> Hora de Inicio <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="cecHoraInicio" class="form-control" value="<%= horaInicioVal %>" required>
          <button type="button" class="cp-clock-btn" data-clock-target="cecHoraInicio">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cecCompartimiento"><i class="fas fa-warehouse"></i> Compartimento No. <span style="color: var(--danger);">*</span></label>
        <input type="number" id="cecCompartimiento" class="form-control" min="0" max="10" step="1" value="<%= compartimientoVal %>" required>
      </div>

      <div class="form-group">
        <label for="cecCompAbierto"><i class="fas fa-door-open"></i> Hora Compartimento Abierto</label>
        <div class="cp-time-row">
          <input type="time" id="cecCompAbierto" class="form-control" value="<%= compAbiertoVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecCompAbierto">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cecCompCerrado"><i class="fas fa-door-closed"></i> Hora Compartimento Cerrado</label>
        <div class="cp-time-row">
          <input type="time" id="cecCompCerrado" class="form-control" value="<%= compCerradoVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecCompCerrado">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cecSupervisor"><i class="fas fa-user-tie"></i> Nombre del Supervisor <span style="color: var(--danger);">*</span></label>
        <select id="cecSupervisor" class="form-control" required>
          <option value="">-- Seleccione Supervisor --</option>
          <% (supervisores || []).forEach(sup => { %>
            <option
              value="<%= sup.LoginId %>"
              data-usuario="<%= sup.Usuario %>"
              <%= String(sup.LoginId) === supLoginIdVal ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="cecAgente"><i class="fas fa-user-shield"></i> Nombre del Agente <span style="color: var(--danger);">*</span></label>
        <select id="cecAgente" class="form-control" required>
          <option value="">-- Seleccione Agente --</option>
          <% (usuariosSEC || []).forEach(u => { %>
            <option
              value="<%= u.LoginId %>"
              data-usuario="<%= u.Usuario %>"
              <%= (String(u.LoginId) === agenteLoginIdVal || (!agenteLoginIdVal && user && u.Usuario === user.usuario)) ? 'selected' : '' %>
            ><%= u.Usuario %> (<%= u.Rol || 'AGENTE' %>)</option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <!-- 2. EMBARQUE (Matriz de Secuencias en Compartimento) -->
  <div class="card" style="border-top: 3px solid var(--brand);" id="cecCardMatriz">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-th"></i> 1. Embarque — Matriz de Equipajes en Compartimento
        </h3>
        <small style="color: var(--text-3); font-size: 11px;">
          Ingrese la secuencia del equipaje embarcado. Puede anular una maleta con tache (<strong>✗</strong>).
        </small>
      </div>

      <div class="er-total-counter-badge">
        <span>Total Equipaje Embarcado:</span>
        <strong id="cecTotalEmbarqueCount">0</strong>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 14px;">
      <div class="form-group">
        <label for="cecEmbarqueInicio"><i class="far fa-clock"></i> Hora Inicio Embarque</label>
        <div class="cp-time-row">
          <input type="time" id="cecEmbarqueInicio" class="form-control" value="<%= embarqueInicioVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecEmbarqueInicio">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cecEmbarqueFinal"><i class="far fa-clock"></i> Hora Final Embarque</label>
        <div class="cp-time-row">
          <input type="time" id="cecEmbarqueFinal" class="form-control" value="<%= embarqueFinalVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecEmbarqueFinal">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>

    <!-- Barra de captura de secuencia -->
    <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; margin-bottom: 16px; background: var(--bg); padding: 14px; border-radius: 8px; border: 1px solid var(--border-2);">
      <div class="form-group" style="margin-bottom: 0; min-width: 220px; flex: 1;">
        <label for="cecInputSecuencia"><i class="fas fa-barcode"></i> Número de Secuencia / Etiqueta <span style="color: var(--danger);">*</span></label>
        <input type="number" id="cecInputSecuencia" class="form-control" min="1" step="1" placeholder="Ej: 18 (Presione Enter para agregar)">
      </div>

      <button type="button" id="btnAgregarSecuenciaCEC" class="btn btn-primary" style="height: 38px;">
        <i class="fas fa-plus-circle"></i> Agregar Maleta
      </button>

      <button type="button" id="btnBorrarUltimoCEC" class="btn btn-secondary" style="height: 38px;">
        <i class="fas fa-undo"></i> Borrar Último
      </button>

      <button type="button" id="btnRetirarMaletaCEC" class="btn btn-secondary" style="height: 38px; border-color: var(--danger); color: var(--danger);">
        <i class="fas fa-times-circle"></i> Retirar / Anular Maleta (✗)
      </button>
    </div>

    <!-- Cuadrícula 10 columnas A..J -->
    <div class="er-fluid-grid-wrapper">
      <table class="er-fluid-table" id="cecTablaMatriz" style="text-align: center;">
        <thead>
          <tr>
            <th style="width: 55px; text-align: center;">FILA</th>
            <th style="text-align: center;">A (1)</th>
            <th style="text-align: center;">B (2)</th>
            <th style="text-align: center;">C (3)</th>
            <th style="text-align: center;">D (4)</th>
            <th style="text-align: center;">E (5)</th>
            <th style="text-align: center;">F (6)</th>
            <th style="text-align: center;">G (7)</th>
            <th style="text-align: center;">H (8)</th>
            <th style="text-align: center;">I (9)</th>
            <th style="text-align: center;">J (10)</th>
          </tr>
        </thead>
        <tbody id="cecTbodyMatriz">
          <!-- Renderizado dinámico por public/js/formato-cec.js -->
        </tbody>
      </table>
    </div>

    <% if (formato && formato.id === 'dl-cec') { %>
      <div style="margin-top: 16px; padding: 14px; background: var(--bg); border: 1px solid var(--border-2); border-radius: 8px;">
        <h4 style="font-size: 12px; color: var(--brand-deep); margin: 0 0 10px 0; text-transform: uppercase;">
          <i class="fas fa-boxes"></i> Totales de Embarque Adicionales (DELTA)
        </h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;">
          <div class="form-group" style="margin-bottom: 0;">
            <label for="cecCargaEmbarqueDelta">Carga (Embarque)</label>
            <input type="number" id="cecCargaEmbarqueDelta" class="form-control" min="0" step="1" value="<%= comp.CargaEmbarqueDelta ?? comp.CargaDelta ?? 0 %>" placeholder="0">
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label for="cecEquipajeMostrador">Equipaje Mostrador</label>
            <input type="number" id="cecEquipajeMostrador" class="form-control" min="0" step="1" value="<%= comp.EquipajeMostrador ?? 0 %>" placeholder="0">
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label for="cecEquipajePuerta">Equipaje en Puerta</label>
            <input type="number" id="cecEquipajePuerta" class="form-control" min="0" step="1" value="<%= comp.EquipajePuerta ?? 0 %>" placeholder="0">
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <!-- 3. DESEMBARQUE Y EQUIPAJE MALTRATADO -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-dolly-flatbed"></i> 2. Desembarque y Equipaje Maltratado</h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="cecDesembarqueInicio"><i class="far fa-clock"></i> Hora Inicio Desembarque</label>
        <div class="cp-time-row">
          <input type="time" id="cecDesembarqueInicio" class="form-control" value="<%= desembarqueInicioVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecDesembarqueInicio">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cecDesembarqueFinal"><i class="far fa-clock"></i> Hora Final Desembarque</label>
        <div class="cp-time-row">
          <input type="time" id="cecDesembarqueFinal" class="form-control" value="<%= desembarqueFinalVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecDesembarqueFinal">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cecEquipaje">Equipajes Desembarcados</label>
        <input type="number" id="cecEquipaje" class="form-control" min="0" step="1" value="<%= equipajeVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="cecCarruajes">Carruajes</label>
        <input type="number" id="cecCarruajes" class="form-control" min="0" step="1" value="<%= carruajesVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="cecCorreos">Correos</label>
        <input type="number" id="cecCorreos" class="form-control" min="0" step="1" value="<%= correosVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="cecCarga">Carga</label>
        <input type="number" id="cecCarga" class="form-control" min="0" step="1" value="<%= cargaVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="cecCantidadSinEtiqueta">Maltratado SIN Etiqueta Limited Release</label>
        <input type="number" id="cecCantidadSinEtiqueta" class="form-control" min="0" step="1" value="<%= cantSinEtiqVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="cecCantidadConEtiqueta">Maltratado CON Etiqueta Limited Release</label>
        <input type="number" id="cecCantidadConEtiqueta" class="form-control" min="0" step="1" value="<%= cantConEtiqVal %>" placeholder="0">
      </div>
    </div>
  </div>

  <!-- 4. PERSONAL EN PLATAFORMA (OIRSA, COMBUSTIBLE, COCINAS, OPERADORES EN RAMPA) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-hard-hat"></i> 3. Personal de Apoyo en Plataforma y Observaciones</h3>
    </div>

    <h4 style="font-size: 12px; color: var(--brand-deep); margin: 4px 0 10px 0; text-transform: uppercase;">OIRSA</h4>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 16px;">
      <div class="form-group">
        <label for="cecNombreOirsa">Nombre OIRSA</label>
        <input type="text" id="cecNombreOirsa" class="form-control" value="<%= nombreOirsaVal %>" placeholder="Nombre de inspector OIRSA">
      </div>
      <div class="form-group">
        <label for="cecTiaOirsa">No. TIA OIRSA</label>
        <input type="text" id="cecTiaOirsa" class="form-control" value="<%= tiaOirsaVal %>" placeholder="No. TIA">
      </div>
    </div>

    <h4 style="font-size: 12px; color: var(--brand-deep); margin: 4px 0 10px 0; text-transform: uppercase;">Combustible</h4>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin-bottom: 16px;">
      <div class="form-group">
        <label for="cecPilotoCombustible">Piloto Combustible</label>
        <input type="text" id="cecPilotoCombustible" class="form-control" value="<%= pilotoCombVal %>">
      </div>
      <div class="form-group">
        <label for="cecTiaPilotoCombustible">TIA Piloto Combustible</label>
        <input type="text" id="cecTiaPilotoCombustible" class="form-control" value="<%= tiaPilotoCombVal %>">
      </div>
      <div class="form-group">
        <label for="cecAyudanteCombustible">Ayudante Combustible</label>
        <input type="text" id="cecAyudanteCombustible" class="form-control" value="<%= ayudanteCombVal %>">
      </div>
      <div class="form-group">
        <label for="cecTiaAyudanteCombustible">TIA Ayudante Combustible</label>
        <input type="text" id="cecTiaAyudanteCombustible" class="form-control" value="<%= tiaAyudanteCombVal %>">
      </div>
      <div class="form-group">
        <label for="cecNoUnidadCombustible">No. Unidad Combustible</label>
        <input type="text" id="cecNoUnidadCombustible" class="form-control" value="<%= noUnidadCombVal %>">
      </div>
      <div class="form-group">
        <label for="cecCombustibleEntrada">Hora Entrada Comb.</label>
        <input type="time" id="cecCombustibleEntrada" class="form-control" value="<%= combEntradaVal %>">
      </div>
      <div class="form-group">
        <label for="cecCombustibleSalida">Hora Salida Comb.</label>
        <input type="time" id="cecCombustibleSalida" class="form-control" value="<%= combSalidaVal %>">
      </div>
    </div>

    <h4 style="font-size: 12px; color: var(--brand-deep); margin: 4px 0 10px 0; text-transform: uppercase;">Cocinas (Catering)</h4>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin-bottom: 16px;">
      <div class="form-group">
        <label for="cecPilotoCocinas">Piloto Cocinas</label>
        <input type="text" id="cecPilotoCocinas" class="form-control" value="<%= pilotoCocVal %>">
      </div>
      <div class="form-group">
        <label for="cecTiaPilotoCocinas">TIA Piloto Cocinas</label>
        <input type="text" id="cecTiaPilotoCocinas" class="form-control" value="<%= tiaPilotoCocVal %>">
      </div>
      <div class="form-group">
        <label for="cecAyudanteCocinas">Ayudante Cocinas</label>
        <input type="text" id="cecAyudanteCocinas" class="form-control" value="<%= ayudanteCocVal %>">
      </div>
      <div class="form-group">
        <label for="cecTiaAyudanteCocinas">TIA Ayudante Cocinas</label>
        <input type="text" id="cecTiaAyudanteCocinas" class="form-control" value="<%= tiaAyudanteCocVal %>">
      </div>
      <div class="form-group">
        <label for="cecNoUnidadCocinas">No. Unidad Cocinas</label>
        <input type="text" id="cecNoUnidadCocinas" class="form-control" value="<%= noUnidadCocVal %>">
      </div>
      <div class="form-group">
        <label for="cecCocinasEntrada">Hora Entrada Cocinas</label>
        <input type="time" id="cecCocinasEntrada" class="form-control" value="<%= cocEntradaVal %>">
      </div>
      <div class="form-group">
        <label for="cecCocinasSalida">Hora Salida Cocinas</label>
        <input type="time" id="cecCocinasSalida" class="form-control" value="<%= cocSalidaVal %>">
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 14px;">
      <label for="cecOperadoresRampa"><i class="fas fa-users-cog"></i> Operadores en Rampa (Nombres separados por coma)</label>
      <input type="text" id="cecOperadoresRampa" class="form-control" value="<%= operadoresRampaVal %>" placeholder="Ej: CARLOS PEREZ, MARIO LOPEZ">
    </div>

    <div class="form-group">
      <label for="cecObservaciones"><i class="fas fa-comment-alt"></i> Observaciones Generales</label>
      <textarea id="cecObservaciones" class="form-control" rows="3" maxlength="2000" placeholder="Ingrese observaciones de compartimento..."><%= observacionVal %></textarea>
    </div>
  </div>

  <!-- 5. BOTONES DE ACCIÓN -->
  <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; margin-bottom: 40px;">
    <button type="button" id="btnVistaPreliminarCEC" class="btn btn-secondary" style="padding: 12px 24px;">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoCEC" class="btn btn-primary" style="padding: 12px 28px;">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="cecInitialStateJson"><%- JSON.stringify(initialCecPayload).replace(/</g, '\\u003c') %></script>
