<%
  const comp = (cecState && cecState.complemento) ? cecState.complemento : {};
  const detalles = (cecState && Array.isArray(cecState.detalles)) ? cecState.detalles : [];

  const extractHHMM = (val) => {
    if (!val) return '';
    const s = String(val instanceof Date ? val.toISOString() : val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/(\d{2}:\d{2})/);
    return m ? m[1] : '';
  };

  let fechaInicial = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (comp.Fecha) {
    fechaInicial = String(comp.Fecha instanceof Date ? comp.Fecha.toISOString() : comp.Fecha).substring(0, 10);
  }

  const horaInicioVal = extractHHMM(comp.HoraInicio) || '';
  const supRawVal = String(comp.SupervisorLoginId || comp.Supervisor || '').trim();
  const agenteRawVal = String(
    comp.AgenteLoginId || comp.Agente || (user && user.usuario) || ''
  ).trim();
  const compartimientoRaw = comp.CompartimientoNo ?? comp.Compartimiento;
  const compartimientoVal = compartimientoRaw !== undefined && compartimientoRaw !== null && String(compartimientoRaw).trim() !== ''
    ? String(compartimientoRaw)
    : '1';
  const compAbiertoVal = extractHHMM(comp.CompAbierto) || '';
  const compCerradoVal = extractHHMM(comp.CompCerrado) || '';

  const embarqueInicioVal = extractHHMM(comp.EmbarqueHoraInicio || comp.EmbarqueInicio) || '';
  const embarqueFinalVal = extractHHMM(comp.EmbarqueHoraFinal || comp.EmbarqueFinal) || '';

  const desembarqueInicioVal = extractHHMM(comp.DesembarqueHoraInicio || comp.DesembarqueInicio) || '';
  const desembarqueFinalVal = extractHHMM(comp.DesembarqueHoraFinal || comp.DesembarqueFinal) || '';
  const equipajeVal = comp.Equipaje ?? '';
  const carruajesVal = comp.Carruajes ?? '';
  const correosVal = comp.Correos ?? '';
  const cargaVal = comp.Carga ?? '';
  const cantSinEtiqVal = comp.CantidadSinEtiqueta ?? '';
  const cantConEtiqVal = comp.CantidadConEtiqueta ?? '';

  const splitPair = (raw) => String(raw || '').split(/[,/]/).map(s => s.trim());
  const combNames = splitPair(comp.NombreCombustible);
  const combTias = splitPair(comp.TIACombustible);
  const cocNames = splitPair(comp.NombreCocinas);
  const cocTias = splitPair(comp.TIACocinas);

  const nombreOirsaVal = comp.NombreOirsa || '';
  const tiaOirsaVal = comp.TIAOirsa || comp.TiaOirsa || '';
  const pilotoCombVal = comp.PilotoCombustible || combNames[0] || '';
  const tiaPilotoCombVal = comp.TiaPilotoCombustible || combTias[0] || '';
  const ayudanteCombVal = comp.AyudanteCombustible || combNames[1] || '';
  const tiaAyudanteCombVal = comp.TiaAyudanteCombustible || combTias[1] || '';
  const noUnidadCombVal = comp.NoUnidadCombustible || '';
  const combEntradaVal = extractHHMM(comp.CombustibleEntrada) || '';
  const combSalidaVal = extractHHMM(comp.CombustibleSalida) || '';

  const pilotoCocVal = comp.PilotoCocinas || cocNames[0] || '';
  const tiaPilotoCocVal = comp.TiaPilotoCocinas || cocTias[0] || '';
  const ayudanteCocVal = comp.AyudanteCocinas || cocNames[1] || '';
  const tiaAyudanteCocVal = comp.TiaAyudanteCocinas || cocTias[1] || '';
  const noUnidadCocVal = comp.NoUnidadCocinas || '';
  const cocEntradaVal = extractHHMM(comp.CocinasEntrada) || '';
  const cocSalidaVal = extractHHMM(comp.CocinasSalida) || '';

  const operadoresRampaVal = comp.OperadoresRampa || '';
  const observacionVal = String(comp.Observaciones || comp.Observacion || '').trim();

  const isDeltaCEC = Boolean(formato && formato.id === 'dl-cec');
  const vueloPartsCec = String((vuelo && vuelo.novuelo) || '').split('/').map(s => s.trim()).filter(Boolean);
  const vueloDesembarqueVal = comp.VueloDesembarque || vueloPartsCec[0] || (vuelo && vuelo.novuelo) || '--';
  const vueloEmbarqueVal = comp.VueloEmbarque || vueloPartsCec[vueloPartsCec.length - 1] || (vuelo && vuelo.novuelo) || '--';
  const eqMostradorVal = comp.EquipajeMostrador ?? 0;
  const eqPuertaDeltaVal = comp.EquipajePuerta ?? 0;
  const cargaEmbarqueDeltaVal = comp.CargaEmbarqueDelta ?? comp.CargaDelta ?? 0;

  let resolvedAgenteNombre = (user && user.usuario) ? String(user.usuario).trim() : agenteRawVal;
  const matchedAgUser = (usuariosSEC || []).find(u =>
    agenteRawVal && (
      String(u.LoginId) === agenteRawVal ||
      String(u.EmpleadoId || '') === agenteRawVal ||
      String(u.Usuario || '').trim().toUpperCase() === agenteRawVal.toUpperCase()
    )
  );
  if (matchedAgUser && matchedAgUser.Usuario) {
    resolvedAgenteNombre = String(matchedAgUser.Usuario).trim();
  }

  const initialCecPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    detalles
  };
%>

<form id="formCapturaCEC" novalidate>
  <input type="hidden" id="cecFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="cecItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="cecEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. INGRESE LOS DATOS (Orden Exacto Power Apps grpInfoGeneral Y:201..1181) -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-luggage-cart"></i> Ingrese los Datos — Control de Equipajes en Compartimentos
      </h3>
      <div class="sio-card-header-meta">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary sio-btn-sm">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="cecHoraInicio"><i class="far fa-clock"></i> Hora (Inicia Puesto) <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="cecHoraInicio" class="form-control" value="<%= horaInicioVal %>" required>
          <button type="button" class="cp-clock-btn" data-clock-target="cecHoraInicio">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cecSupervisor"><i class="fas fa-user-tie"></i> Supervisor <span class="sio-required-star">*</span></label>
        <select id="cecSupervisor" class="form-control" required>
          <option value="">-- Seleccione el Supervisor --</option>
          <% (supervisores || []).forEach(sup => {
               const matchSup = supRawVal && (
                 String(sup.LoginId) === supRawVal ||
                 String(sup.EmpleadoId || '') === supRawVal ||
                 String(sup.Usuario || '').trim().toUpperCase() === supRawVal.toUpperCase()
               );
          %>
            <option
              value="<%= sup.LoginId %>"
              data-usuario="<%= sup.Usuario %>"
              <%= matchSup ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="cecAgente"><i class="fas fa-user-shield"></i> Agente <i class="fas fa-lock input-lock-icon" title="Agente autenticado en sesión (Solo lectura)"></i></label>
        <input
          type="text"
          id="cecAgente"
          class="form-control input-locked"
          value="<%= resolvedAgenteNombre %>"
          data-usuario="<%= resolvedAgenteNombre %>"
          readonly
          tabindex="-1"
          required
        >
      </div>

      <div class="form-group">
        <label for="cecFecha"><i class="far fa-calendar-alt"></i> Fecha <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="cecFecha" class="form-control input-locked" value="<%= fechaInicial %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="cecNoVuelo"><i class="fas fa-plane"></i> No. Vuelo <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cecNoVuelo" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cecMatricula"><i class="fas fa-barcode"></i> Matrícula <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cecMatricula" class="form-control input-locked" value="<%= vuelo.Matricula || 'Pendiente' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cecCompartimiento"><i class="fas fa-warehouse"></i> Compartimiento No. <span class="sio-required-star">*</span></label>
        <input type="number" id="cecCompartimiento" class="form-control" min="0" max="10" step="1" inputmode="numeric" value="<%= compartimientoVal %>" placeholder="Ingrese No." required>
      </div>

      <div class="form-group">
        <label for="cecPuerta"><i class="fas fa-door-open"></i> Puerta <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cecPuerta" class="form-control input-locked" value="<%= vuelo.puertaposicion || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cecCompAbierto"><i class="fas fa-door-open"></i> COMP. Abierto</label>
        <div class="cp-time-row">
          <input type="time" id="cecCompAbierto" class="form-control" value="<%= compAbiertoVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecCompAbierto">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. PERSONAL EN PLATAFORMA (Orden Exacto Power Apps grpPersonasEnPlataforma Y:1370..3282) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-hard-hat"></i> 1. Personal en Plataforma</h3>
    </div>

    <h4 class="sio-subsection-title">OIRSA</h4>
    <div class="sio-grid-auto sio-mb-16">
      <div class="form-group">
        <label for="cecNombreOirsa">OIRSA:</label>
        <input type="text" id="cecNombreOirsa" class="form-control" value="<%= nombreOirsaVal %>" placeholder="Ingrese el nombre del personal OIRSA">
      </div>
      <div class="form-group">
        <label for="cecTiaOirsa">TIA:</label>
        <input type="text" id="cecTiaOirsa" class="form-control" value="<%= tiaOirsaVal %>" placeholder="Ingrese No. de TIA OIRSA">
      </div>
    </div>

    <h4 class="sio-subsection-title">Combustible</h4>
    <div class="sio-grid-auto-compact sio-mb-16">
      <div class="form-group">
        <label for="cecPilotoCombustible">Piloto</label>
        <input type="text" id="cecPilotoCombustible" class="form-control" value="<%= pilotoCombVal %>" placeholder="Nombre Piloto">
      </div>
      <div class="form-group">
        <label for="cecTiaPilotoCombustible">TIA (Piloto):</label>
        <input type="text" id="cecTiaPilotoCombustible" class="form-control" value="<%= tiaPilotoCombVal %>" placeholder="Ingrese No. de TIA Piloto">
      </div>
      <div class="form-group">
        <label for="cecAyudanteCombustible">Ayudante:</label>
        <input type="text" id="cecAyudanteCombustible" class="form-control" value="<%= ayudanteCombVal %>" placeholder="Nombre Ayudante">
      </div>
      <div class="form-group">
        <label for="cecTiaAyudanteCombustible">TIA (Ayudante):</label>
        <input type="text" id="cecTiaAyudanteCombustible" class="form-control" value="<%= tiaAyudanteCombVal %>" placeholder="Ingrese No. de TIA Ayudante">
      </div>
      <div class="form-group">
        <label for="cecNoUnidadCombustible">No. Unidad:</label>
        <input type="text" id="cecNoUnidadCombustible" class="form-control" value="<%= noUnidadCombVal %>" placeholder="Ingrese el No. de Unidad">
      </div>
      <div class="form-group">
        <label for="cecCombustibleEntrada">Llega:</label>
        <div class="cp-time-row">
          <input type="time" id="cecCombustibleEntrada" class="form-control" value="<%= combEntradaVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecCombustibleEntrada">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
      <div class="form-group">
        <label for="cecCombustibleSalida">Sale:</label>
        <div class="cp-time-row">
          <input type="time" id="cecCombustibleSalida" class="form-control" value="<%= combSalidaVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecCombustibleSalida">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>

    <h4 class="sio-subsection-title">Cocinas</h4>
    <div class="sio-grid-auto-compact sio-mb-16">
      <div class="form-group">
        <label for="cecPilotoCocinas">Piloto</label>
        <input type="text" id="cecPilotoCocinas" class="form-control" value="<%= pilotoCocVal %>" placeholder="Nombre Piloto">
      </div>
      <div class="form-group">
        <label for="cecTiaPilotoCocinas">TIA (Piloto):</label>
        <input type="text" id="cecTiaPilotoCocinas" class="form-control" value="<%= tiaPilotoCocVal %>" placeholder="Ingrese No. de TIA">
      </div>
      <div class="form-group">
        <label for="cecAyudanteCocinas">Ayudante:</label>
        <input type="text" id="cecAyudanteCocinas" class="form-control" value="<%= ayudanteCocVal %>" placeholder="Nombre Ayudante">
      </div>
      <div class="form-group">
        <label for="cecTiaAyudanteCocinas">TIA (Ayudante):</label>
        <input type="text" id="cecTiaAyudanteCocinas" class="form-control" value="<%= tiaAyudanteCocVal %>" placeholder="Ingrese No. de TIA">
      </div>
      <div class="form-group">
        <label for="cecNoUnidadCocinas">No. Unidad:</label>
        <input type="text" id="cecNoUnidadCocinas" class="form-control" value="<%= noUnidadCocVal %>" placeholder="Ingrese No. de Unidad">
      </div>
      <div class="form-group">
        <label for="cecCocinasEntrada">Llega:</label>
        <div class="cp-time-row">
          <input type="time" id="cecCocinasEntrada" class="form-control" value="<%= cocEntradaVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecCocinasEntrada">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
      <div class="form-group">
        <label for="cecCocinasSalida">Sale:</label>
        <div class="cp-time-row">
          <input type="time" id="cecCocinasSalida" class="form-control" value="<%= cocSalidaVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecCocinasSalida">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>

    <div class="form-group">
      <label for="cecOperadoresRampa"><i class="fas fa-users-cog"></i> Operadores en RAMPA (Nombres separados por coma)</label>
      <input type="text" id="cecOperadoresRampa" class="form-control" value="<%= operadoresRampaVal %>" placeholder="Ej: CARLOS PEREZ, MARIO LOPEZ">
    </div>
  </div>

  <!-- 3. DESEMBARQUE (Orden Exacto Power Apps grpDesembarque Y:3439..5167) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-dolly-flatbed"></i> 2. <%= isDeltaCEC ? 'Desembarque (DELTA)' : 'DESEMBARQUE y Equipajes Dañados Llegando' %></h3>
    </div>

    <div class="sio-grid-auto-compact">
      <div class="form-group">
        <label for="cecVueloDesembarque"><i class="fas fa-plane-arrival"></i> No. Vuelo (Desembarque) <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cecVueloDesembarque" class="form-control input-locked" value="<%= vueloDesembarqueVal %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cecDesembarqueInicio"><i class="far fa-clock"></i> Inicio Desembarque:</label>
        <div class="cp-time-row">
          <input type="time" id="cecDesembarqueInicio" class="form-control" value="<%= desembarqueInicioVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecDesembarqueInicio">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="cecEquipaje">Equipajes:</label>
        <input type="number" id="cecEquipaje" class="form-control" min="0" step="1" inputmode="numeric" value="<%= equipajeVal %>" placeholder="Ingrese Cantidad">
      </div>

      <div class="form-group">
        <label for="cecCarruajes">Carruajes:</label>
        <input type="number" id="cecCarruajes" class="form-control" min="0" step="1" inputmode="numeric" value="<%= carruajesVal %>" placeholder="Ingrese Cantidad">
      </div>

      <% if (!isDeltaCEC) { %>
      <div class="form-group">
        <label for="cecCorreos">Correos:</label>
        <input type="number" id="cecCorreos" class="form-control" min="0" step="1" inputmode="numeric" value="<%= correosVal %>" placeholder="Ingrese Cantidad">
      </div>
      <% } %>

      <div class="form-group">
        <label for="cecCarga">Carga:</label>
        <input type="number" id="cecCarga" class="form-control" min="0" step="1" inputmode="numeric" value="<%= cargaVal %>" placeholder="Ingrese Cantidad">
      </div>

      <% if (!isDeltaCEC) { %>
      <div class="form-group">
        <label for="cecCantidadSinEtiqueta">Dañados — Sin Etiqueta y sin Firma:</label>
        <input type="number" id="cecCantidadSinEtiqueta" class="form-control" min="0" step="1" inputmode="numeric" value="<%= cantSinEtiqVal %>" placeholder="Ingrese Cantidad">
      </div>

      <div class="form-group">
        <label for="cecCantidadConEtiqueta">Dañados — Con Etiqueta y Firma:</label>
        <input type="number" id="cecCantidadConEtiqueta" class="form-control" min="0" step="1" inputmode="numeric" value="<%= cantConEtiqVal %>" placeholder="Ingrese Cantidad">
      </div>
      <% } %>

      <div class="form-group">
        <label for="cecDesembarqueFinal"><i class="far fa-clock"></i> Fin Desembarque:</label>
        <div class="cp-time-row">
          <input type="time" id="cecDesembarqueFinal" class="form-control" value="<%= desembarqueFinalVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecDesembarqueFinal">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. EMBARQUE (Orden Exacto Power Apps grpEmbarque Y:5231..6391) -->
  <div class="card sio-card-accent" id="cecCardMatriz">
    <div class="card-header sio-card-header-flex">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-th"></i> 3. EMBARQUE — <%= isDeltaCEC ? 'Control de Equipaje y Carga Embarcada (DELTA)' : 'Matriz de Equipajes en Compartimento' %>
        </h3>
        <small class="sio-hint-text">
          <%= isDeltaCEC ? 'Registre los horarios y totales de Equipaje Mostrador, Equipaje por Puerta y Carga de Embarque.' : 'Ingrese la secuencia del equipaje embarcado. Toque una celda registrada para seleccionarla y poder retirarla o anularla (✗).' %>
        </small>
      </div>

      <div class="er-total-counter-badge">
        <span>Total Equipaje Embarcado:</span>
        <strong id="cecTotalEmbarqueCount"><%= isDeltaCEC ? ((Number(eqMostradorVal) || 0) + (Number(eqPuertaDeltaVal) || 0)) : 0 %></strong>
      </div>
    </div>

    <div class="sio-grid-auto sio-mb-14">
      <div class="form-group">
        <label for="cecVueloEmbarque"><i class="fas fa-plane-departure"></i> No. Vuelo (Embarque) <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="cecVueloEmbarque" class="form-control input-locked" value="<%= vueloEmbarqueVal %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="cecEmbarqueInicio"><i class="far fa-clock"></i> Inicio Embarque:</label>
        <div class="cp-time-row">
          <input type="time" id="cecEmbarqueInicio" class="form-control" value="<%= embarqueInicioVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecEmbarqueInicio">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>

    <% if (!isDeltaCEC) { %>
    <!-- Barra de captura de secuencia -->
    <div class="sio-inline-bar sio-inline-bar-box">
      <div class="form-group">
        <label for="cecInputSecuencia"><i class="fas fa-barcode"></i> Secuencia: <span class="sio-required-star">*</span></label>
        <input type="number" id="cecInputSecuencia" class="form-control" min="1" step="1" inputmode="numeric" placeholder="Ingrese Secuencia (Enter para agregar)">
      </div>

      <button type="button" id="btnAgregarSecuenciaCEC" class="btn btn-primary sio-btn-bar">
        <i class="fas fa-plus-circle"></i> Agregar Maleta
      </button>

      <button type="button" id="btnBorrarUltimoCEC" class="btn btn-secondary sio-btn-bar">
        <i class="fas fa-undo"></i> Borrar Último
      </button>

      <button type="button" id="btnRetirarMaletaCEC" class="btn btn-secondary sio-btn-bar sio-btn-danger-outline">
        <i class="fas fa-times-circle"></i> Retirar / Anular Maleta (✗)
      </button>
    </div>

    <div id="cecMatrizSelectionBar" class="sio-mx-selection-bar" role="status" aria-live="polite"></div>

    <!-- Cuadrícula 10 columnas A..J (compacta completa en móvil) -->
    <div class="sio-baggage-matrix-wrap">
      <table class="sio-baggage-matrix-table" id="cecTablaMatriz">
        <thead>
          <tr>
            <th class="sio-mx-th-row"><span class="sio-mx-th-full">FILA</span><span class="sio-mx-th-short">#</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">A</span><span class="sio-mx-col-num">(1)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">B</span><span class="sio-mx-col-num">(2)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">C</span><span class="sio-mx-col-num">(3)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">D</span><span class="sio-mx-col-num">(4)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">E</span><span class="sio-mx-col-num">(5)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">F</span><span class="sio-mx-col-num">(6)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">G</span><span class="sio-mx-col-num">(7)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">H</span><span class="sio-mx-col-num">(8)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">I</span><span class="sio-mx-col-num">(9)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">J</span><span class="sio-mx-col-num">(10)</span></th>
          </tr>
        </thead>
        <tbody id="cecTbodyMatriz">
          <!-- Renderizado dinámico por public/js/baggage-matrix.js -->
        </tbody>
      </table>
    </div>
    <% } else { %>
      <div class="sio-panel-box">
        <div class="sio-grid-auto-compact">
          <div class="form-group">
            <label for="cecEquipajeMostrador">Equipaje Mostrador</label>
            <input type="number" id="cecEquipajeMostrador" class="form-control" min="0" step="1" inputmode="numeric" value="<%= eqMostradorVal %>" placeholder="0">
          </div>
          <div class="form-group">
            <label for="cecEquipajePuerta">Equipaje por Puerta</label>
            <input type="number" id="cecEquipajePuerta" class="form-control" min="0" step="1" inputmode="numeric" value="<%= eqPuertaDeltaVal %>" placeholder="0">
          </div>
          <div class="form-group">
            <label for="cecCargaEmbarqueDelta">Carga (Embarque)</label>
            <input type="number" id="cecCargaEmbarqueDelta" class="form-control" min="0" step="1" inputmode="numeric" value="<%= cargaEmbarqueDeltaVal %>" placeholder="0">
          </div>
        </div>
      </div>
    <% } %>

    <div class="sio-grid-auto sio-mt-16">
      <div class="form-group">
        <label for="cecEmbarqueFinal"><i class="far fa-clock"></i> Fin Embarque:</label>
        <div class="cp-time-row">
          <input type="time" id="cecEmbarqueFinal" class="form-control" value="<%= embarqueFinalVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecEmbarqueFinal">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. CIERRE DE COMPARTIMENTO Y OBSERVACIONES (Orden Exacto Power Apps Y:6489..6621) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-door-closed"></i> 4. Cierre de Compartimento y Observaciones</h3>
    </div>

    <div class="sio-grid-auto sio-mb-14">
      <div class="form-group">
        <label for="cecCompCerrado"><i class="fas fa-door-closed"></i> COMP. Cerrado:</label>
        <div class="cp-time-row">
          <input type="time" id="cecCompCerrado" class="form-control" value="<%= compCerradoVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="cecCompCerrado">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>

    <div class="form-group">
      <label for="cecObservaciones"><i class="fas fa-comment-alt"></i> Observaciones:</label>
      <textarea id="cecObservaciones" class="form-control" rows="3" maxlength="2000" placeholder="Observaciones:"><%= observacionVal %></textarea>
    </div>
  </div>

  <!-- 6. BOTONES DE ACCIÓN -->
  <div class="sio-bottom-actions">
    <button type="button" id="btnVistaPreliminarCEC" class="btn btn-secondary sio-btn-action">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoCEC" class="btn btn-primary sio-btn-action-primary">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="cecInitialStateJson"><%- JSON.stringify(initialCecPayload).replace(/</g, '\\u003c') %></script>
