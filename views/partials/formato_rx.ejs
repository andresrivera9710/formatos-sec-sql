<%
  const enc = (rxState && rxState.encabezado) ? rxState.encabezado : {};
  const personalSAG = (rxState && Array.isArray(rxState.personalSAG)) ? rxState.personalSAG : [];
  const personalLaats = (rxState && Array.isArray(rxState.personalLaats)) ? rxState.personalLaats : [];

  const extractHHMM = (val) => {
    if (!val) return '';
    const s = String(val instanceof Date ? val.toISOString() : val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/([01]\d|2[0-3]):([0-5]\d)/);
    return m ? `${m[1]}:${m[2]}` : '';
  };

  let fechaVal = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaVal = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (enc.Fecha) {
    const d = new Date(enc.Fecha);
    if (!Number.isNaN(d.getTime())) fechaVal = d.toISOString().substring(0, 10);
  }

  const supervisorIdVal = enc.SupervisorEmpleadoId ? String(enc.SupervisorEmpleadoId) : (enc.EmpleadoId ? String(enc.EmpleadoId) : '');
  const horaInicioVal = extractHHMM(enc.HoraInicio);
  const pEqRecVal = extractHHMM(enc.PEquipajeRecibidoRX);
  const pCarEnvVal = extractHHMM(enc.PCarretaEnviada);
  const uEqRecVal = extractHHMM(enc.UEquipajeRX);
  const uCarEnvVal = extractHHMM(enc.UCarretaEnviada);
  const obsVal = (enc.Observacion || enc.Observaciones) ? String(enc.Observacion || enc.Observaciones).trim() : '';
  const agenteActual = (user && (user.usuario || user.nombreCompleto)) ? String(user.usuario || user.nombreCompleto).trim() : '';

  const laatsCatalogo = (empleados && empleados.length > 0)
    ? empleados.map(e => ({ EmpleadoId: e.EmpleadoId, Nombre: e.Nombre, Codigo: e.Codigo || '', Puesto: e.Puesto || '' }))
    : (supervisores || []).map(s => ({ EmpleadoId: s.EmpleadoId, Nombre: s.Usuario, Codigo: s.Codigo || '', Puesto: s.PuestoEmpleado || s.Puesto || '' }));

  const initialRxPayload = {
    formatoId: formato.id,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    fecha: fechaVal,
    horaInicio: horaInicioVal,
    supervisorEmpleadoId: supervisorIdVal,
    pEquipajeRecibidoRX: pEqRecVal,
    pCarretaEnviada: pCarEnvVal,
    uEquipajeRX: uEqRecVal,
    uCarretaEnviada: uCarEnvVal,
    observaciones: obsVal,
    agenteActual,
    empleadosLaats: laatsCatalogo,
    personalSAG,
    personalLaats
  };
%>

<form id="formCapturaRX" novalidate>
  <input type="hidden" id="rxFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="rxItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="rxEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. APERTURA / ENCABEZADO (Orden 1:1 scrDELTA.pa.yaml) -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-x-ray"></i> Control de Equipaje en Rayos X — DELTA (<%= vuelo.novuelo || '--' %>)
      </h3>
      <div class="sio-card-header-meta">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary sio-btn-sm">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="rxBadgeEstado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="rxHoraInicio"><i class="far fa-clock"></i> Hora Inicia Puesto <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="rxHoraInicio" class="form-control" value="<%= horaInicioVal %>" required>
          <button type="button" class="cp-clock-btn" data-rx-clock="rxHoraInicio" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="rxFecha"><i class="far fa-calendar-alt"></i> Fecha <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="rxFecha" class="form-control input-locked" value="<%= fechaVal %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="rxNoVuelo"><i class="fas fa-plane"></i> Vuelo <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="rxNoVuelo" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="rxSupervisor"><i class="fas fa-user-tie"></i> Supervisor (LoginSEC) <span class="sio-required-star">*</span></label>
        <select id="rxSupervisor" class="form-control" required data-search-placeholder="Buscar supervisor por nombre, código o puesto...">
          <option value="">-- Seleccione Supervisor --</option>
          <% (supervisores || []).forEach(sup => { %>
            <option
              value="<%= sup.EmpleadoId %>"
              data-nombre="<%= sup.Usuario %>"
              data-code="<%= sup.Codigo || '' %>"
              data-puesto="<%= sup.PuestoEmpleado || sup.Puesto || '' %>"
              data-meta="<%= sup.NombreCompleto || '' %>"
              <%= String(sup.EmpleadoId) === supervisorIdVal ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="rxAgente"><i class="fas fa-user-shield"></i> Agente <i class="fas fa-lock input-lock-icon" title="Agente autenticado en sesión (Solo lectura)"></i></label>
        <input type="text" id="rxAgente" class="form-control input-locked" value="<%= agenteActual %>" readonly tabindex="-1">
      </div>
    </div>
  </div>

  <!-- 2. INICIO DE OPERACIÓN EN MÁQUINA RX (Orden 1:1 Power Apps) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-stopwatch"></i> Inicio de Operación en Rayos X</h3>
    </div>

    <div class="sio-grid-auto-lg">
      <div class="form-group">
        <label for="rxPEquipajeRecibidoRX">Primer Equipaje Recibido en RX <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="rxPEquipajeRecibidoRX" class="form-control" value="<%= pEqRecVal %>" required>
          <button type="button" class="cp-clock-btn" data-rx-clock="rxPEquipajeRecibidoRX"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="rxPCarretaEnviada">Primera Carreta Enviada a Plataforma <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="rxPCarretaEnviada" class="form-control" value="<%= pCarEnvVal %>" required>
          <button type="button" class="cp-clock-btn" data-rx-clock="rxPCarretaEnviada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. CUADRÍCULAS PARALELAS: PERSONAL SAG Y PERSONAL LAATS -->
  <div class="sio-grid-split">
    <!-- PERSONAL SAG -->
    <div class="card sio-card-accent">
      <div class="card-header sio-card-header-flex">
        <h3 class="cp-section-title"><i class="fas fa-user-check"></i> Personal SAG <span class="sio-required-star">*</span></h3>
        <span class="badge badge-brand" id="rxTotalSagBadge"><%= personalSAG.length %></span>
      </div>

      <div class="dl-capture-inline">
        <div class="form-group">
          <label for="rxInputSagNombre">Nombre SAG <span class="sio-required-star">*</span></label>
          <input type="text" id="rxInputSagNombre" class="form-control" maxlength="150" placeholder="Nombre completo" autocomplete="off" enterkeyhint="next">
        </div>
        <div class="form-group">
          <label for="rxInputSagId">ID / TIA <span class="sio-required-star">*</span></label>
          <input type="text" id="rxInputSagId" class="form-control" inputmode="numeric" pattern="[0-9]*" data-numeric-only="true" maxlength="50" placeholder="Solo números" autocomplete="off" enterkeyhint="done">
        </div>
        <button type="button" id="btnAgregarSagRX" class="btn btn-primary sio-btn-bar">
          <i class="fas fa-plus"></i> Agregar
        </button>
      </div>

      <div class="er-fluid-grid-wrapper dl-grid-wrapper" id="rxSagWrapper">
        <table class="er-fluid-table dl-compact-table" id="rxTablaSag">
          <thead>
            <tr>
              <th class="dl-th-num">NO.</th>
              <th>NOMBRE <span class="er-req-star">*</span></th>
              <th class="dl-th-id">ID / TIA <span class="er-req-star">*</span></th>
              <th class="dl-th-action">ACCIÓN</th>
            </tr>
          </thead>
          <tbody id="rxTbodySag"></tbody>
        </table>
      </div>
      <div class="sio-form-actions-end">
        <button type="button" id="btnAgregarFilaSagRX" class="btn btn-secondary sio-btn-sm">
          + Insertar Fila SAG
        </button>
      </div>
    </div>

    <!-- PERSONAL LAATS -->
    <div class="card sio-card-accent">
      <div class="card-header sio-card-header-flex">
        <h3 class="cp-section-title"><i class="fas fa-id-card"></i> Personal LAATS <span class="sio-required-star">*</span></h3>
        <span class="badge badge-brand" id="rxTotalLaatsBadge"><%= personalLaats.length %></span>
      </div>

      <div class="dl-capture-inline">
        <div class="form-group">
          <label for="rxInputLaatsEmpleado">Agente LAATS <span class="sio-required-star">*</span></label>
          <select id="rxInputLaatsEmpleado" class="form-control" data-search-placeholder="Buscar agente LAATS por nombre o código...">
            <option value="">-- Seleccione Agente --</option>
            <% laatsCatalogo.forEach(emp => { %>
              <option value="<%= emp.EmpleadoId %>" data-nombre="<%= emp.Nombre %>" data-code="<%= emp.Codigo %>" data-puesto="<%= emp.Puesto %>"><%= emp.Nombre %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="rxInputLaatsId">ID / TIA <span class="sio-required-star">*</span></label>
          <input type="text" id="rxInputLaatsId" class="form-control" inputmode="numeric" pattern="[0-9]*" data-numeric-only="true" maxlength="50" placeholder="Solo números" autocomplete="off" enterkeyhint="done">
        </div>
        <button type="button" id="btnAgregarLaatsRX" class="btn btn-primary sio-btn-bar">
          <i class="fas fa-plus"></i> Agregar
        </button>
      </div>

      <div class="er-fluid-grid-wrapper dl-grid-wrapper" id="rxLaatsWrapper">
        <table class="er-fluid-table dl-compact-table" id="rxTablaLaats">
          <thead>
            <tr>
              <th class="dl-th-num">NO.</th>
              <th>NOMBRE <span class="er-req-star">*</span></th>
              <th class="dl-th-id">ID / TIA <span class="er-req-star">*</span></th>
              <th class="dl-th-action">ACCIÓN</th>
            </tr>
          </thead>
          <tbody id="rxTbodyLaats"></tbody>
        </table>
      </div>
      <div class="sio-form-actions-end">
        <button type="button" id="btnAgregarFilaLaatsRX" class="btn btn-secondary sio-btn-sm">
          + Insertar Fila LAATS
        </button>
      </div>
    </div>
  </div>

  <!-- 4. FIN DE OPERACIÓN EN MÁQUINA RX (Orden 1:1 Power Apps) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-flag-checkered"></i> Cierre de Operación en Rayos X</h3>
    </div>

    <div class="sio-grid-auto-lg">
      <div class="form-group">
        <label for="rxUEquipajeRX">Último Equipaje Recibido en RX <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="rxUEquipajeRX" class="form-control" value="<%= uEqRecVal %>" required>
          <button type="button" class="cp-clock-btn" data-rx-clock="rxUEquipajeRX"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="rxUCarretaEnviada">Última Carreta Enviada a Plataforma <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="rxUCarretaEnviada" class="form-control" value="<%= uCarEnvVal %>" required>
          <button type="button" class="cp-clock-btn" data-rx-clock="rxUCarretaEnviada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. OBSERVACIONES -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-comment-dots"></i> Observaciones</h3>
    </div>
    <div class="form-group">
      <textarea id="rxObservaciones" class="form-control" rows="3" maxlength="2000" placeholder="(Opcional) Ingrese observaciones relevantes de la revisión en Rayos X..."><%= obsVal %></textarea>
    </div>
  </div>

  <!-- 6. ACCIONES -->
  <div class="sio-bottom-actions">
    <button type="button" id="btnVistaPreliminarRX" class="btn btn-secondary sio-btn-action">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoRX" class="btn btn-primary sio-btn-action-primary">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="rxInitialStateJson"><%- JSON.stringify(initialRxPayload).replace(/</g, '\\u003c') %></script>
