<%
  const comp = (ebState && ebState.complemento) ? ebState.complemento : {};
  const detalles = (ebState && Array.isArray(ebState.detalles)) ? ebState.detalles : [];

  const extractHHMM = (val) => {
    if (!val) return '';
    const s = String(val instanceof Date ? val.toISOString() : val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/(\d{2}:\d{2})/);
    return m ? m[1] : '';
  };

  let fechaInicial = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (comp.Fecha) {
    fechaInicial = String(comp.Fecha instanceof Date ? comp.Fecha.toISOString() : comp.Fecha).substring(0, 10);
  }

  const horaInicioVal = extractHHMM(comp.Hora) || '';
  const horaCierreVal = extractHHMM(comp.HoraCierre) || '';
  const supLoginIdVal = comp.LoginId ? String(comp.LoginId) : '';
  const nombreOperadorVal = comp.NombreOperador ? String(comp.NombreOperador).trim() : (user && user.usuario ? String(user.usuario).trim() : '');
  const correosVal = comp.CorreosCantidad ?? comp.Correos ?? '';
  const comatVal = comp.ComatCantidad ?? comp.Comat ?? '';
  const eqTransitoVal = comp.EqTransitoCantidad ?? comp.EqTransito ?? '';
  const observacionVal = (comp.Observaciones ?? comp.Observacion) ? String(comp.Observaciones ?? comp.Observacion).trim() : '';

  const initialEbPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    fecha: fechaInicial,
    horaInicio: horaInicioVal,
    horaCierre: horaCierreVal,
    supervisorLoginId: supLoginIdVal,
    nombreOperador: nombreOperadorVal,
    correos: correosVal,
    comat: comatVal,
    eqTransito: eqTransitoVal,
    observaciones: observacionVal,
    detalles
  };
%>

<form id="formCapturaEB" novalidate>
  <input type="hidden" id="ebFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="ebItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="ebEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. CABECERA DEL FORMATO (ControlEquipajeBandaSalidaAMX) -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-conveyor-belt"></i> Datos Generales — Control de Equipajes en Banda de Salida (Rayos X)
      </h3>
      <div class="sio-card-header-meta">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary sio-btn-sm">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="ebFecha"><i class="far fa-calendar-alt"></i> Fecha <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="ebFecha" class="form-control input-locked" value="<%= fechaInicial %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="ebNoVuelo"><i class="fas fa-plane"></i> No. Vuelo <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="ebNoVuelo" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="ebHoraInicio"><i class="far fa-clock"></i> Hora de Inicio <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="ebHoraInicio" class="form-control" value="<%= horaInicioVal %>" required>
          <button type="button" id="btnRelojHoraInicioEB" class="cp-clock-btn" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="ebSupervisor"><i class="fas fa-user-tie"></i> Nombre del Supervisor (LoginSEC) <span class="sio-required-star">*</span></label>
        <select id="ebSupervisor" class="form-control" required data-search-placeholder="Buscar supervisor por nombre, código o puesto...">
          <option value="">-- Seleccione Supervisor --</option>
          <% (supervisores || []).forEach(sup => { %>
            <option
              value="<%= sup.LoginId %>"
              data-usuario="<%= sup.Usuario %>"
              data-code="<%= sup.Codigo || '' %>"
              data-puesto="<%= sup.PuestoEmpleado || sup.Puesto || '' %>"
              data-meta="<%= sup.NombreCompleto || '' %>"
              <%= String(sup.LoginId) === supLoginIdVal ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="ebNombreOperador"><i class="fas fa-user-shield"></i> Agente de Seguridad <i class="fas fa-lock input-lock-icon" title="Agente autenticado en sesión (Solo lectura)"></i></label>
        <input type="text" id="ebNombreOperador" class="form-control input-locked" value="<%= nombreOperadorVal %>" readonly tabindex="-1" required>
      </div>
    </div>
  </div>

  <!-- 2. MATRIZ DE EQUIPAJES EN BANDA DE SALIDA (10 Columnas A..J x Filas — Orden Power Apps Y:922..1672) -->
  <div class="card sio-card-accent" id="ebCardMatriz">
    <div class="card-header sio-card-header-flex">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-th"></i> MATRIZ — Control de Secuencias en Banda de Salida (Rayos X)
        </h3>
        <small class="sio-hint-text">
          Ingrese el número de secuencia de cada equipaje (se asigna automáticamente en orden A..J). Toque una celda registrada para seleccionarla y poder retirarla o anularla (<strong>✗</strong>).
        </small>
      </div>

      <div class="sio-card-header-meta">
        <div class="er-total-counter-badge">
          <span>Total Equipajes Activos:</span>
          <strong id="ebTotalEquipajeCount">0</strong>
        </div>
      </div>
    </div>

    <!-- Barra de captura rápida de secuencia -->
    <div class="sio-inline-bar sio-inline-bar-box">
      <div class="form-group">
        <label for="ebInputSecuencia"><i class="fas fa-barcode"></i> Secuencia: <span class="sio-required-star">*</span></label>
        <input type="number" id="ebInputSecuencia" class="form-control" min="1" step="1" inputmode="numeric" enterkeyhint="done" autocomplete="off" placeholder="Ingrese No. (Enter / Sig.)">
      </div>

      <button type="button" id="btnAgregarSecuenciaEB" class="btn btn-primary sio-btn-bar">
        <i class="fas fa-plus-circle"></i> Agregar Maleta
      </button>

      <button type="button" id="btnBorrarUltimoEB" class="btn btn-secondary sio-btn-bar">
        <i class="fas fa-undo"></i> Borrar Último
      </button>

      <button type="button" id="btnRetirarMaletaEB" class="btn btn-secondary sio-btn-bar sio-btn-danger-outline">
        <i class="fas fa-times-circle"></i> Retirar / Anular Maleta (✗)
      </button>
    </div>

    <!-- Cuadrícula 10 columnas A..J (compacta completa en móvil) -->
    <div class="sio-baggage-matrix-wrap">
      <table class="sio-baggage-matrix-table" id="ebTablaMatriz">
        <thead>
          <tr>
            <th class="sio-mx-th-row"><span class="sio-mx-th-full">FILA</span><span class="sio-mx-th-short">#</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">A</span><span class="sio-mx-col-num">(1)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">B</span><span class="sio-mx-col-num">(2)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">C</span><span class="sio-mx-col-num">(3)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">D</span><span class="sio-mx-col-num">(4)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">E</span><span class="sio-mx-col-num">(5)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">F</span><span class="sio-mx-col-num">(6)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">G</span><span class="sio-mx-col-num">(7)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">H</span><span class="sio-mx-col-num">(8)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">I</span><span class="sio-mx-col-num">(9)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">J</span><span class="sio-mx-col-num">(10)</span></th>
          </tr>
        </thead>
        <tbody id="ebTbodyMatriz">
          <!-- Renderizado dinámico por public/js/baggage-matrix.js -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- 3. CONTEOS ADICIONALES, TOTAL EQUIPAJES, HORA DE CIERRE Y OBSERVACIONES (Orden Exacto Power Apps Y:1791..2410) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-boxes"></i> Conteos Complementarios, Cierre de Banda y Observaciones</h3>
    </div>

    <div class="sio-grid-auto-compact">
      <div class="form-group">
        <label for="ebCorreos"><i class="fas fa-envelope"></i> Correos:</label>
        <input type="number" id="ebCorreos" class="form-control" min="0" step="1" inputmode="numeric" value="<%= correosVal %>" placeholder="Ingrese Cantidad">
      </div>

      <div class="form-group">
        <label for="ebComat"><i class="fas fa-box"></i> COMAT:</label>
        <input type="number" id="ebComat" class="form-control" min="0" step="1" inputmode="numeric" value="<%= comatVal %>" placeholder="Ingrese Cantidad">
      </div>

      <div class="form-group">
        <label for="ebEqTransito"><i class="fas fa-exchange-alt"></i> EQ. Tránsito:</label>
        <input type="number" id="ebEqTransito" class="form-control" min="0" step="1" inputmode="numeric" value="<%= eqTransitoVal %>" placeholder="Indique el equipo">
      </div>

      <div class="form-group">
        <label for="ebTotalEquipajeReadout"><i class="fas fa-calculator"></i> Total Equipajes <i class="fas fa-lock input-lock-icon" title="Calculado automáticamente de la matriz activa"></i></label>
        <input type="text" id="ebTotalEquipajeReadout" class="form-control input-locked" value="0" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="ebHoraCierre"><i class="far fa-clock"></i> Hora de Cierre:</label>
        <div class="cp-time-row">
          <input type="time" id="ebHoraCierre" class="form-control" value="<%= horaCierreVal %>">
          <button type="button" id="btnRelojHoraCierreEB" class="cp-clock-btn" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>

    <div class="form-group sio-mt-16">
      <label for="ebObservaciones"><i class="fas fa-comment-alt"></i> Observaciones (Opcional — incluye motivos de maletas retiradas)</label>
      <textarea id="ebObservaciones" class="form-control" rows="3" maxlength="2000" placeholder="(Opcional)"><%= observacionVal %></textarea>
    </div>
  </div>

  <!-- 4. BOTONES DE ACCIÓN -->
  <div class="sio-bottom-actions">
    <button type="button" id="btnVistaPreliminarEB" class="btn btn-secondary sio-btn-action">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoEB" class="btn btn-primary sio-btn-action-primary">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="ebInitialStateJson"><%- JSON.stringify(initialEbPayload).replace(/</g, '\\u003c') %></script>
