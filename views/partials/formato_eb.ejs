<%
  const comp = (ebState && ebState.complemento) ? ebState.complemento : {};
  const detalles = (ebState && Array.isArray(ebState.detalles)) ? ebState.detalles : [];

  const extractHHMM = (val) => {
    if (!val) return '';
    const s = String(val instanceof Date ? val.toISOString() : val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/(\d{2}:\d{2})/);
    return m ? m[1] : '';
  };

  let fechaInicial = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (comp.Fecha) {
    fechaInicial = String(comp.Fecha instanceof Date ? comp.Fecha.toISOString() : comp.Fecha).substring(0, 10);
  }

  const horaInicioVal = extractHHMM(comp.Hora) || '';
  const horaCierreVal = extractHHMM(comp.HoraCierre) || '';
  const supLoginIdVal = comp.LoginId ? String(comp.LoginId) : '';
  const nombreOperadorVal = comp.NombreOperador ? String(comp.NombreOperador).trim() : (user && user.usuario ? String(user.usuario).trim() : '');
  const correosVal = comp.Correos ?? '';
  const comatVal = comp.Comat ?? '';
  const eqTransitoVal = comp.EqTransito ?? '';
  const observacionVal = comp.Observacion ? String(comp.Observacion).trim() : '';

  const initialEbPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    fecha: fechaInicial,
    horaInicio: horaInicioVal,
    horaCierre: horaCierreVal,
    supervisorLoginId: supLoginIdVal,
    nombreOperador: nombreOperadorVal,
    correos: correosVal,
    comat: comatVal,
    eqTransito: eqTransitoVal,
    observaciones: observacionVal,
    detalles
  };
%>

<form id="formCapturaEB" novalidate>
  <input type="hidden" id="ebFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="ebItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="ebEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. CABECERA DEL FORMATO (ControlEquipajeBandaSalidaAMX) -->
  <div class="card">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-conveyor-belt"></i> Datos Generales — Control de Equipajes en Banda de Salida (Rayos X)
      </h3>
      <div style="display: flex; align-items: center; gap: 10px;">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px;">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="ebFecha"><i class="far fa-calendar-alt"></i> Fecha <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="ebFecha" class="form-control input-locked" value="<%= fechaInicial %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="ebNoVuelo"><i class="fas fa-plane"></i> No. Vuelo <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="ebNoVuelo" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="ebHoraInicio"><i class="far fa-clock"></i> Hora de Inicio <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="ebHoraInicio" class="form-control" value="<%= horaInicioVal %>" required>
          <button type="button" id="btnRelojHoraInicioEB" class="cp-clock-btn" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="ebSupervisor"><i class="fas fa-user-tie"></i> Nombre del Supervisor (LoginSEC) <span style="color: var(--danger);">*</span></label>
        <select id="ebSupervisor" class="form-control" required>
          <option value="">-- Seleccione Supervisor --</option>
          <% (supervisores || []).forEach(sup => { %>
            <option
              value="<%= sup.LoginId %>"
              data-usuario="<%= sup.Usuario %>"
              <%= String(sup.LoginId) === supLoginIdVal ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="ebNombreOperador"><i class="fas fa-user-shield"></i> Agente de Seguridad <i class="fas fa-lock input-lock-icon" title="Agente autenticado en sesión (Solo lectura)"></i></label>
        <input type="text" id="ebNombreOperador" class="form-control input-locked" value="<%= nombreOperadorVal %>" readonly tabindex="-1" required>
      </div>
    </div>
  </div>

  <!-- 2. MATRIZ DE EQUIPAJES EN BANDA DE SALIDA (10 Columnas A..J x Filas) -->
  <div class="card" style="border-top: 3px solid var(--brand);" id="ebCardMatriz">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-th"></i> Matriz de Control de Secuencias en Banda de Salida (Rayos X)
        </h3>
        <small style="color: var(--text-3); font-size: 11px;">
          Ingrese el número de secuencia de cada equipaje (se asigna automáticamente a la casilla 1..100). Puede anular/retirar una maleta con tache (<strong>✗</strong>).
        </small>
      </div>

      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
        <div class="er-total-counter-badge">
          <span>Total Equipaje Activo:</span>
          <strong id="ebTotalEquipajeCount">0</strong>
        </div>
      </div>
    </div>

    <!-- Barra de captura rápida de secuencia -->
    <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; margin-bottom: 16px; background: var(--bg); padding: 14px; border-radius: 8px; border: 1px solid var(--border-2);">
      <div class="form-group" style="margin-bottom: 0; min-width: 220px; flex: 1;">
        <label for="ebInputSecuencia"><i class="fas fa-barcode"></i> Número de Secuencia / Etiqueta <span style="color: var(--danger);">*</span></label>
        <input type="number" id="ebInputSecuencia" class="form-control" min="1" step="1" placeholder="Ej: 15 (Presione Enter para agregar)">
      </div>

      <button type="button" id="btnAgregarSecuenciaEB" class="btn btn-primary" style="height: 38px;">
        <i class="fas fa-plus-circle"></i> Agregar Maleta
      </button>

      <button type="button" id="btnBorrarUltimoEB" class="btn btn-secondary" style="height: 38px;">
        <i class="fas fa-undo"></i> Borrar Último
      </button>

      <button type="button" id="btnRetirarMaletaEB" class="btn btn-secondary" style="height: 38px; border-color: var(--danger); color: var(--danger);">
        <i class="fas fa-times-circle"></i> Retirar / Anular Maleta (✗)
      </button>
    </div>

    <!-- Cuadrícula 10 columnas A..J -->
    <div class="er-fluid-grid-wrapper">
      <table class="er-fluid-table" id="ebTablaMatriz" style="text-align: center;">
        <thead>
          <tr>
            <th style="width: 55px; text-align: center;">FILA</th>
            <th style="text-align: center;">A (1)</th>
            <th style="text-align: center;">B (2)</th>
            <th style="text-align: center;">C (3)</th>
            <th style="text-align: center;">D (4)</th>
            <th style="text-align: center;">E (5)</th>
            <th style="text-align: center;">F (6)</th>
            <th style="text-align: center;">G (7)</th>
            <th style="text-align: center;">H (8)</th>
            <th style="text-align: center;">I (9)</th>
            <th style="text-align: center;">J (10)</th>
          </tr>
        </thead>
        <tbody id="ebTbodyMatriz">
          <!-- Renderizado dinámico por public/js/formato-eb.js -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- 3. CONTEOS ADICIONALES, HORA DE CIERRE Y OBSERVACIONES -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-boxes"></i> Conteos Complementarios, Cierre de Banda y Observaciones</h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="ebCorreos"><i class="fas fa-envelope"></i> Correos (Opcional)</label>
        <input type="number" id="ebCorreos" class="form-control" min="0" step="1" value="<%= correosVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="ebComat"><i class="fas fa-box"></i> COMAT (Opcional)</label>
        <input type="number" id="ebComat" class="form-control" min="0" step="1" value="<%= comatVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="ebEqTransito"><i class="fas fa-exchange-alt"></i> Equipajes en Tránsito (Opcional)</label>
        <input type="number" id="ebEqTransito" class="form-control" min="0" step="1" value="<%= eqTransitoVal %>" placeholder="0">
      </div>

      <div class="form-group">
        <label for="ebHoraCierre"><i class="far fa-clock"></i> Hora de Cierre de Banda</label>
        <div class="cp-time-row">
          <input type="time" id="ebHoraCierre" class="form-control" value="<%= horaCierreVal %>">
          <button type="button" id="btnRelojHoraCierreEB" class="cp-clock-btn" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>

    <div class="form-group" style="margin-top: 16px;">
      <label for="ebObservaciones"><i class="fas fa-comment-alt"></i> Observaciones (Maletas retiradas y novedades)</label>
      <textarea id="ebObservaciones" class="form-control" rows="3" maxlength="2000" placeholder="Ingrese observaciones operativas..."><%= observacionVal %></textarea>
    </div>
  </div>

  <!-- 4. BOTONES DE ACCIÓN -->
  <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; margin-bottom: 40px;">
    <button type="button" id="btnVistaPreliminarEB" class="btn btn-secondary" style="padding: 12px 24px;">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoEB" class="btn btn-primary" style="padding: 12px 28px;">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="ebInitialStateJson"><%- JSON.stringify(initialEbPayload).replace(/</g, '\\u003c') %></script>
