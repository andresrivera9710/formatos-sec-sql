<%
  const enc = (ciecState && ciecState.encabezado) ? ciecState.encabezado : {};
  const comp = (ciecState && ciecState.complemento) ? ciecState.complemento : {};
  const initialRegistros = (ciecState && Array.isArray(ciecState.detalles)) ? ciecState.detalles : [];
  const initialEquipajePuerta = (ciecState && Array.isArray(ciecState.equipajePuerta)) ? ciecState.equipajePuerta : [];
  const observacionCiecVal = (ciecState && ciecState.observacionesLimpia !== undefined)
    ? ciecState.observacionesLimpia
    : String(comp.Observaciones || comp.Observacion || '').trim();
  const empresasCIEC = (formato && formato.id === 'dl-ciec')
    ? ['LAATS', 'DELTA', 'SAG', 'ODA', 'GODARD', 'GODARD(Cocinas)', 'ODA (Combustible)', 'OIRSA', 'DGAC (Operaciones)', 'OTROS...']
    : [
        'LAATS', 'GODARD(Cocinas)', 'ODA (Combustible)', 'OIRSA',
        'DGAC (Operaciones)', 'AEROEXPRESS',
        (formato && formato.id === 'ara-ciec')
          ? 'ARAJET'
          : ((formato && formato.id === 'latam-ciec')
            ? 'LAN CARGO'
            : ((formato && formato.id === 'ajt-ciec') ? 'AMERIJET' : 'AEROMEXICO')),
        'OTROS...'
      ];

  const extractHHMM = (val) => {
    if (!val) return '';
    const s = String(val instanceof Date ? val.toISOString() : val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/(\d{2}:\d{2})/);
    return m ? m[1] : '';
  };

  let fechaValue = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaValue = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else {
    const fechaSrc = enc.Fecha || comp.Fecha;
    if (fechaSrc) {
      const d = new Date(fechaSrc);
      if (!Number.isNaN(d.getTime())) fechaValue = d.toISOString().substring(0, 10);
    }
  }

  const horaInicioVal = extractHHMM(enc.HoraInicio || comp.HoraInicio) || '';
  const supSelectedId = (enc.EmpleadoId || comp.EncabezadoEmpleadoId)
    ? String(enc.EmpleadoId || comp.EncabezadoEmpleadoId)
    : '';
  const trSelectedId = comp && comp.MaquinariaEmpleadoId ? String(comp.MaquinariaEmpleadoId) : '';
  const unitSelectedId = comp && comp.MaquinariaEquipoId ? String(comp.MaquinariaEquipoId) : '';

  const arriboVal = extractHHMM(comp.ArriboVuelo || comp.ArriboDelVuelo) || extractHHMM(vuelo && vuelo.ata) || '';
  const aseguradaVal = extractHHMM(comp.AeronaveAsegurada) || '';
  const pasarelaVal = extractHHMM(comp.PasarelaAcoplada) || '';
  const puertaAbiertaVal = extractHHMM(comp.PuertaAbierta) || '';
  const egresoTripVal = extractHHMM(comp.EgresoTripulacion) || '';
  const ingresoTripVal = extractHHMM(comp.IngresoTripulacion) || '';
  const paxEntrandoVal = comp.PaxEntrando ?? '';
  const primerPaxVal = extractHHMM(comp.PrimerPax) || '';
  const ultimoPaxVal = extractHHMM(comp.UltimoPax) || '';
  const paxAbordosVal = comp.PaxAbordos ?? '';
  const puertaCerradaVal = extractHHMM(comp.PuertaCerrada) || '';
  const desacopleVal = extractHHMM(comp.DesacoplePasarela) || '';
  const pushbackVal = extractHHMM(comp.PushBack) || '';
  const despegueVal = extractHHMM(comp.Despegue) || extractHHMM(vuelo && vuelo.atd) || '';

  const aleroIdsRaw = comp && comp.AlerosEmpleadoIds
    ? String(comp.AlerosEmpleadoIds).split(',').map(x => x.trim()).filter(Boolean)
    : [];
  const initialAleros = aleroIdsRaw.map(idStr => {
    const emp = (empleados || []).find(e => String(e.EmpleadoId) === idStr);
    return {
      EmpleadoId: parseInt(idStr, 10),
      Nombre: emp ? emp.Nombre : `Empleado #${idStr}`
    };
  }).filter(a => Number.isFinite(a.EmpleadoId) && a.EmpleadoId > 0);

  const initialCiecPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    registros: initialRegistros,
    equipajePuerta: initialEquipajePuerta,
    aleros: initialAleros
  };
%>

<form id="formControlCIEC" novalidate>
  <input type="hidden" id="ciecFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="ciecItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="ciecEncabezadoId" value="<%= encabezadoId || '' %>">
  <input type="hidden" id="ciecAgentesEmpleadoIds" value="<%= comp && comp.AgentesEmpleadoIds ? comp.AgentesEmpleadoIds : (user.empleadoId || '') %>">

  <!-- Bloque 1: Tiempos de Llegada y Desembarque (Orden Exacto Power Apps Y:196..781) -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title"><i class="fas fa-plane-arrival"></i> Tiempos Operativos de Llegada y Desembarque</h3>
      <div class="sio-card-header-meta">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary sio-btn-sm">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div class="sio-grid-auto-compact">
      <div class="form-group">
        <label for="ciecArriboVuelo"><i class="far fa-clock"></i> Arribo del Vuelo <i class="fas fa-lock input-lock-icon" title="Hora ATA vinculada al itinerario (Solo lectura)"></i></label>
        <input type="text" id="ciecArriboVuelo" class="form-control input-locked" value="<%= arriboVal || '--:--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="ciecAeronaveAsegurada">Aeronave Asegurada</label>
        <div class="cp-time-row">
          <input type="time" id="ciecAeronaveAsegurada" class="form-control" value="<%= aseguradaVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecAeronaveAsegurada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecPasarelaAcoplada">Pasarela Acoplada</label>
        <div class="cp-time-row">
          <input type="time" id="ciecPasarelaAcoplada" class="form-control" value="<%= pasarelaVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecPasarelaAcoplada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecPuertaAbierta">Puerta Abierta</label>
        <div class="cp-time-row">
          <input type="time" id="ciecPuertaAbierta" class="form-control" value="<%= puertaAbiertaVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecPuertaAbierta"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecEgresoTripulacion">Egreso Tripulación</label>
        <div class="cp-time-row">
          <input type="time" id="ciecEgresoTripulacion" class="form-control" value="<%= egresoTripVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecEgresoTripulacion"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecPaxEntrando">PAX entrando a GUA</label>
        <input type="number" id="ciecPaxEntrando" class="form-control" min="0" step="1" value="<%= paxEntrandoVal %>" placeholder="Ingrese Total de PAX">
      </div>
    </div>
  </div>

  <!-- Bloque 2: Ingrese los Datos (Cabecera de Inspección — Orden Exacto Power Apps Y:907..1622) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-clipboard-list"></i> Ingrese los Datos</h3>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="ciecFecha"><i class="far fa-calendar-alt"></i> Fecha <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="ciecFecha" class="form-control input-locked" value="<%= fechaValue %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="ciecHoraInicio"><i class="far fa-clock"></i> Hora de Revisión <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="ciecHoraInicio" class="form-control" value="<%= horaInicioVal %>" required>
          <button type="button" class="cp-clock-btn" data-clock-target="ciecHoraInicio">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecPuerta"><i class="fas fa-door-open"></i> Puerta <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="ciecPuerta" class="form-control input-locked" value="<%= vuelo.puertaposicion || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="ciecNoVuelo"><i class="fas fa-plane"></i> No. Vuelo <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="ciecNoVuelo" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="ciecMatricula"><i class="fas fa-barcode"></i> Matrícula <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="ciecMatricula" class="form-control input-locked" value="<%= vuelo.Matricula || 'Pendiente' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="ciecSupervisor"><i class="fas fa-user-tie"></i> Supervisor <span class="sio-required-star">*</span></label>
        <select id="ciecSupervisor" class="form-control" required data-search-placeholder="Buscar supervisor por nombre, código o puesto...">
          <option value="">-- Seleccione el Supervisor --</option>
          <% (supervisores || []).forEach(sup => { %>
            <option
              value="<%= sup.EmpleadoId %>"
              data-usuario="<%= sup.Usuario %>"
              data-code="<%= sup.Codigo || '' %>"
              data-puesto="<%= sup.PuestoEmpleado || sup.Puesto || '' %>"
              data-meta="<%= sup.NombreCompleto || '' %>"
              <%= String(sup.EmpleadoId) === supSelectedId ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="ciecAgente"><i class="fas fa-user-shield"></i> Agente <i class="fas fa-lock input-lock-icon" title="Agente autenticado en sesión (Solo lectura)"></i></label>
        <input type="text" id="ciecAgente" class="form-control input-locked" value="<%= user.usuario || user.nombreCompleto %>" readonly tabindex="-1">
      </div>
    </div>
  </div>

  <!-- Bloque 3: REGISTRO (Ingreso de Personas a Cabina) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-user-plus"></i> REGISTRO (Ingreso de Personal a Cabina)</h3>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="ciecRegNombre">Nombre <span class="sio-required-star">*</span></label>
        <input type="text" id="ciecRegNombre" class="form-control" placeholder="Ingrese Nombre" autocomplete="off" enterkeyhint="next">
      </div>

      <div class="form-group">
        <label for="ciecRegNoTIA">No. TIA <span class="sio-required-star">*</span></label>
        <input type="text" id="ciecRegNoTIA" class="form-control" inputmode="numeric" pattern="[0-9]*" data-numeric-only="true" maxlength="20" placeholder="Ingrese No. TIA (solo números)" autocomplete="off" enterkeyhint="next">
      </div>

      <div class="form-group">
        <label for="ciecRegHoraIngreso">Hora de Ingreso <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="ciecRegHoraIngreso" class="form-control" enterkeyhint="next">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecRegHoraIngreso">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecRegEmpresa">Empresa <span class="sio-required-star">*</span></label>
        <select id="ciecRegEmpresa" class="form-control">
          <option value="">-- Seleccione la Empresa --</option>
          <% empresasCIEC.forEach(emp => { %>
            <option value="<%= emp %>"><%= emp %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group sio-field-hidden" id="grupoCiecEmpresaOtros">
        <label for="ciecRegEmpresaOtros">Especificar Nueva Empresa <span class="sio-required-star">*</span></label>
        <input type="text" id="ciecRegEmpresaOtros" class="form-control" placeholder="Ingrese la nueva empresa" autocomplete="off" enterkeyhint="next">
      </div>
    </div>

    <div class="form-group sio-mt-14">
      <label for="ciecRegMotivo">Motivo <span class="sio-required-star">*</span></label>
      <textarea id="ciecRegMotivo" rows="2" class="form-control" placeholder="Ingrese Motivo de ingreso a cabina..." enterkeyhint="done"></textarea>
    </div>

    <div class="sio-form-actions-end">
      <button type="button" id="btnCiecAgregarRegistro" class="btn btn-primary sio-btn-wide">
        <i class="fas fa-plus-circle"></i> GUARDAR REGISTRO
      </button>
    </div>
  </div>

  <!-- Bloque 4: Buscador y Lista de Registros en Cabina -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title"><i class="fas fa-users"></i> Registros en Cabina (Control Ingreso y Egreso)</h3>
      <div id="ciecRegistrosEstadoBadge"></div>
    </div>

    <div class="sio-search-bar">
      <div class="sio-search-input-wrap">
        <i class="fas fa-search sio-search-icon"></i>
        <input
          type="text"
          id="ciecBuscador"
          class="form-control sio-search-input"
          placeholder="Buscador: Ingrese nombre, empresa, TIA, motivo u hora a buscar..."
          autocomplete="off"
        >
      </div>
      <button type="button" id="btnCiecLimpiarBuscador" class="btn btn-secondary" title="Limpiar filtro">
        <i class="fas fa-sync-alt"></i> Limpiar
      </button>
    </div>

    <div id="ciecRegistrosLista" class="cp-registros-grid"></div>
  </div>

  <!-- Bloque 5: Equipajes Entregados en Puerta del Avión (Matriz A..J — Orden Power Apps Y:3299..4053) -->
  <div class="card sio-card-accent" id="ciecCardMatrizPuerta">
    <div class="card-header sio-card-header-flex">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-suitcase"></i> Control de Equipajes en Puerta del Avión (Secuencias)
        </h3>
        <small class="sio-hint-text">
          Opcional: Ingrese secuencias de equipaje entregadas en puerta del avión. Toque una celda registrada para seleccionarla y poder retirarla o anularla (<strong>✗</strong>).
        </small>
      </div>

      <div class="er-total-counter-badge">
        <span>Total Equipaje Puerta:</span>
        <strong id="ciecTotalPuertaCount">0</strong>
      </div>
    </div>

    <div class="sio-inline-bar sio-inline-bar-box">
      <div class="form-group">
        <label for="ciecInputSecuenciaPuerta"><i class="fas fa-barcode"></i> Secuencia:</label>
        <input type="number" id="ciecInputSecuenciaPuerta" class="form-control" min="1" step="1" inputmode="numeric" enterkeyhint="done" autocomplete="off" placeholder="Ingrese Secuencia (Enter / Sig.)">
      </div>

      <button type="button" id="btnAgregarSecuenciaPuertaCIEC" class="btn btn-primary sio-btn-bar">
        <i class="fas fa-plus-circle"></i> Agregar Equipaje Puerta
      </button>

      <button type="button" id="btnBorrarUltimoPuertaCIEC" class="btn btn-secondary sio-btn-bar">
        <i class="fas fa-undo"></i> Borrar Último
      </button>

      <button type="button" id="btnRetirarMaletaPuertaCIEC" class="btn btn-secondary sio-btn-bar sio-btn-danger-outline">
        <i class="fas fa-times-circle"></i> Retirar / Anular Maleta (✗)
      </button>
    </div>

    <div class="sio-baggage-matrix-wrap">
      <table class="sio-baggage-matrix-table" id="ciecTablaMatrizPuerta">
        <thead>
          <tr>
            <th class="sio-mx-th-row"><span class="sio-mx-th-full">FILA</span><span class="sio-mx-th-short">#</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">A</span><span class="sio-mx-col-num">(1)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">B</span><span class="sio-mx-col-num">(2)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">C</span><span class="sio-mx-col-num">(3)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">D</span><span class="sio-mx-col-num">(4)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">E</span><span class="sio-mx-col-num">(5)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">F</span><span class="sio-mx-col-num">(6)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">G</span><span class="sio-mx-col-num">(7)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">H</span><span class="sio-mx-col-num">(8)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">I</span><span class="sio-mx-col-num">(9)</span></th>
            <th class="sio-mx-th-col"><span class="sio-mx-col-letter">J</span><span class="sio-mx-col-num">(10)</span></th>
          </tr>
        </thead>
        <tbody id="ciecTbodyMatrizPuerta">
          <!-- Renderizado dinámico por public/js/baggage-matrix.js -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bloque 6: Tiempos Operativos de Embarque y Salida, Maquinaria PushBack, Aleros y Observaciones (Orden Exacto Power Apps Y:4307..6415) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-plane-departure"></i> Tiempos Operativos de Embarque y Salida, Maquinaria PushBack y Aleros</h3>
    </div>

    <div class="sio-grid-auto-compact sio-divider-bottom">
      <div class="form-group">
        <label for="ciecIngresoTripulacion">Ingreso Tripulación</label>
        <div class="cp-time-row">
          <input type="time" id="ciecIngresoTripulacion" class="form-control" value="<%= ingresoTripVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecIngresoTripulacion"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecPrimerPax">1er. PAX Abordo</label>
        <div class="cp-time-row">
          <input type="time" id="ciecPrimerPax" class="form-control" value="<%= primerPaxVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecPrimerPax"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecUltimoPax">Ult. PAX Abordo</label>
        <div class="cp-time-row">
          <input type="time" id="ciecUltimoPax" class="form-control" value="<%= ultimoPaxVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecUltimoPax"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecPaxAbordos">PAX Abordos</label>
        <input type="number" id="ciecPaxAbordos" class="form-control" min="0" step="1" value="<%= paxAbordosVal %>" placeholder="Ingrese Total de PAX Abordos">
      </div>

      <div class="form-group">
        <label for="ciecPuertaCerrada">Puerta Cerrada</label>
        <div class="cp-time-row">
          <input type="time" id="ciecPuertaCerrada" class="form-control" value="<%= puertaCerradaVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecPuertaCerrada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecDesacoplePasarela">Desacople Pasarela</label>
        <div class="cp-time-row">
          <input type="time" id="ciecDesacoplePasarela" class="form-control" value="<%= desacopleVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecDesacoplePasarela"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecPushBack">PushBack</label>
        <div class="cp-time-row">
          <input type="time" id="ciecPushBack" class="form-control" value="<%= pushbackVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecPushBack"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ciecDespegue">Despegue</label>
        <div class="cp-time-row">
          <input type="time" id="ciecDespegue" class="form-control" value="<%= despegueVal %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ciecDespegue"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>
    </div>

    <% if (formato && formato.id === 'dl-ciec') { %>
      <div class="sio-grid-auto-lg">
        <div class="form-group">
          <label for="ciecTractoristaDelta"><i class="fas fa-hard-hat"></i> Tractorista</label>
          <input
            type="text"
            id="ciecTractoristaDelta"
            class="form-control"
            value="<%= comp.TractoristaDelta ?? comp.Tractorista ?? comp.NombreTractorista ?? (ciecState && ciecState.tractoristaDelta) ?? '' %>"
            placeholder="Nombre del tractorista PushBack"
            autocomplete="off"
          >
        </div>

        <div class="form-group">
          <label for="ciecMaquinariaDelta"><i class="fas fa-tractor"></i> No. Unidad / Maquinaria</label>
          <input
            type="text"
            id="ciecMaquinariaDelta"
            class="form-control"
            value="<%= comp.MaquinariaDelta ?? comp.Maquinaria ?? (ciecState && ciecState.maquinariaDelta) ?? '' %>"
            placeholder="Ej: TR-04"
            autocomplete="off"
          >
        </div>

        <div class="form-group">
          <label for="ciecAlerosDelta"><i class="fas fa-user-friends"></i> Aleros</label>
          <input
            type="text"
            id="ciecAlerosDelta"
            class="form-control"
            value="<%= comp.AlerosDelta ?? comp.Aleros ?? (ciecState && ciecState.alerosDelta) ?? '' %>"
            placeholder="Nombres de los aleros"
            autocomplete="off"
          >
        </div>
      </div>
    <% } else { %>
      <div class="sio-grid-auto-lg">
        <div class="form-group">
          <label for="ciecTractorista"><i class="fas fa-hard-hat"></i> Tractorista</label>
          <select id="ciecTractorista" class="form-control" data-search-placeholder="Buscar tractorista por nombre, código o puesto...">
            <option value="">-- Seleccione a la persona que realiza PushBack --</option>
            <% (empleados || []).forEach(emp => { %>
              <option
                value="<%= emp.EmpleadoId %>"
                data-code="<%= emp.Codigo || '' %>"
                data-puesto="<%= emp.Puesto || '' %>"
                data-depto="<%= emp.DepartamentoInterno || '' %>"
                <%= String(emp.EmpleadoId) === trSelectedId ? 'selected' : '' %>
              ><%= emp.Nombre %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="ciecNoUnidad"><i class="fas fa-tractor"></i> No. Unidad</label>
          <select id="ciecNoUnidad" class="form-control" data-search-placeholder="Buscar No. de Unidad o tipo de maquinaria...">
            <option value="">-- Seleccione la unidad --</option>
            <% (maquinaria || []).forEach(m => { %>
              <option
                value="<%= m.MaquinariaEquipoId %>"
                data-code="<%= m.NoUnidad || '' %>"
                data-puesto="<%= m.TipoMaquinaria || '' %>"
                <%= String(m.MaquinariaEquipoId) === unitSelectedId ? 'selected' : '' %>
              ><%= m.NoUnidad %><%= m.TipoMaquinaria ? ` — ${m.TipoMaquinaria}` : '' %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="ciecAleroSelect"><i class="fas fa-user-friends"></i> Aleros (Máximo 2)</label>
          <select id="ciecAleroSelect" class="form-control" data-search-placeholder="Buscar agente por nombre, código o puesto...">
            <option value="">-- Seleccionar agentes para aleros --</option>
            <% (empleados || []).forEach(emp => { %>
              <option
                value="<%= emp.EmpleadoId %>"
                data-code="<%= emp.Codigo || '' %>"
                data-puesto="<%= emp.Puesto || '' %>"
                data-depto="<%= emp.DepartamentoInterno || '' %>"
              ><%= emp.Nombre %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="sio-mt-18">
        <label class="sio-aleros-label">
          <i class="fas fa-users"></i> Aleros Seleccionados:
        </label>
        <div id="ciecAlerosLista"></div>
      </div>
    <% } %>

    <div class="form-group sio-mt-18">
      <label for="ciecObservaciones"><i class="fas fa-comment-alt"></i> Observaciones</label>
      <textarea
        id="ciecObservaciones"
        rows="3"
        class="form-control"
        placeholder="Ingrese Observaciones (Opcional)..."
      ><%= observacionCiecVal %></textarea>
    </div>
  </div>

  <!-- Botones Finales -->
  <div class="sio-bottom-actions">
    <button type="button" id="btnVistaPreliminarCIEC" class="btn btn-secondary sio-btn-action">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoCIEC" class="btn btn-primary sio-btn-action-primary">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="ciecInitialStateJson"><%- JSON.stringify(initialCiecPayload).replace(/</g, '\\u003c') %></script>
