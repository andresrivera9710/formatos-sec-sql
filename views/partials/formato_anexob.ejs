<%
  const enc = (anexoBState && anexoBState.encabezado) ? anexoBState.encabezado : {};
  const dm = (enc.DocMeta && typeof enc.DocMeta === 'object') ? enc.DocMeta : {};
  const zones = (anexoBState && Array.isArray(anexoBState.zones)) ? anexoBState.zones : [];

  const extractHHMM = (val) => {
    if (!val) return '';
    const s = String(val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/(\d{2}:\d{2})/);
    return m ? m[1] : '';
  };

  let fechaInicial = '';
  if (enc.Fecha) {
    fechaInicial = String(enc.Fecha instanceof Date ? enc.Fecha.toISOString() : enc.Fecha).substring(0, 10);
  } else if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else {
    fechaInicial = new Date().toISOString().substring(0, 10);
  }

  const tipoOperacionInicial = dm.tipoOperacion || 'Tránsito';
  const genSearchInicial = dm.generalSearchType || 'Física';
  const idValInicial = dm.idValidationRequired || 'NO';

  const initialAnexoBPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    noVuelo: vuelo.novuelo || '',
    matricula: vuelo.Matricula || '',
    tipoOperacion: tipoOperacionInicial,
    fecha: fechaInicial,
    departureStation: dm.departureStation || 'GUA',
    originInbound: dm.originInbound || vuelo.Origen || '',
    destinationOutbound: dm.destinationOutbound || vuelo.Destino || 'GUA',
    searchStartTime: extractHHMM(dm.searchStartTime),
    timeSearchCompleted: extractHHMM(dm.timeSearchCompleted),
    generalSearchType: genSearchInicial,
    overheadBins: dm.overheadBins || 'Realizado',
    closetsStorageCrew: dm.closetsStorageCrew || 'Realizado',
    lavatoriesAndSeals: dm.lavatoriesAndSeals || 'Realizado',
    seatsUnderPocketsBetween: dm.seatsUnderPocketsBetween || 'Realizado',
    seatBacksPocketsTrays: dm.seatBacksPocketsTrays || 'Realizado',
    galleyAreasAndTrolleys: dm.galleyAreasAndTrolleys || 'Realizado',
    seatsUnderCushions: dm.seatsUnderCushions || 'Realizado',
    lifeVestPackagesHolders: dm.lifeVestPackagesHolders || 'Realizado',
    crewRestAreas: dm.crewRestAreas || 'N/A',
    idValidationRequired: idValInicial,
    idValidationReport: dm.idValidationReport || '',
    leadSupervisorLoginId: dm.leadSupervisorLoginId || (enc.LoginId || (user && user.loginId) || 1),
    leadName: dm.leadName || (user && (user.nombreCompleto || user.usuario)) || '',
    leadEmployeeNumber: dm.leadEmployeeNumber || (user && user.empleadoId ? String(user.empleadoId) : ''),
    leadSignature: dm.leadSignature || '',
    csmName: dm.csmName || '',
    csmSignature: dm.csmSignature || '',
    zonesSearch: zones
  };

  const checklistRows = [
    { key: 'overheadBins', id: 'axBChkOverheadBins', label: 'Overhead bins' },
    { key: 'closetsStorageCrew', id: 'axBChkClosets', label: 'Closets, storage compartments and crew lockers' },
    { key: 'lavatoriesAndSeals', id: 'axBChkLavatories', label: 'Lavatories and safety seals' },
    { key: 'seatsUnderPocketsBetween', id: 'axBChkSeatsUnder', label: 'Seats (under and pockets between)' },
    { key: 'seatBacksPocketsTrays', id: 'axBChkSeatBacks', label: 'Seat backs, pockets and tray tables' },
    { key: 'galleyAreasAndTrolleys', id: 'axBChkGalley', label: 'Galley areas and trolleys' },
    { key: 'seatsUnderCushions', id: 'axBChkCushions', label: 'Seats: under seat cushions (Physical only)' },
    { key: 'lifeVestPackagesHolders', id: 'axBChkLifeVests', label: 'Life vest packages / holders (Physical only)' },
    { key: 'crewRestAreas', id: 'axBChkCrewRest', label: 'Crew rest areas (OFAR / OFCR)' }
  ];
%>

<form id="formCapturaAnexoB" novalidate>
  <input type="hidden" id="axBFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="axBItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="axBEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. ENCABEZADO DEL VUELO Y TIPO DE OPERACIÓN -->
  <div class="card">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-clipboard-check"></i> Annex B — Aircraft Cabin Search Report (ACF632)
      </h3>
      <div style="display: flex; align-items: center; gap: 10px;">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px;">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="axBBadgeEstadoEncabezado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="axBTipoOperacion"><i class="fas fa-exchange-alt"></i> Tipo de Operación <span style="color: var(--danger);">*</span></label>
        <select id="axBTipoOperacion" class="form-control" required>
          <option value="Tránsito" <%= tipoOperacionInicial === 'Tránsito' ? 'selected' : '' %>>Tránsito (Parte 1 + Parte 2 obligatorias)</option>
          <option value="Recepción" <%= tipoOperacionInicial === 'Recepción' ? 'selected' : '' %>>Recepción (Parte 1 obligatoria)</option>
          <option value="Despacho" <%= tipoOperacionInicial === 'Despacho' ? 'selected' : '' %>>Despacho (Parte 2 Zonas obligatoria)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="axBNoVuelo"><i class="fas fa-plane"></i> Flight # <span style="color: var(--danger);">*</span></label>
        <input type="text" id="axBNoVuelo" class="form-control" value="<%= vuelo.novuelo || '' %>" readonly style="background-color: var(--bg); font-weight: 700; color: var(--brand-deep);">
      </div>

      <div class="form-group">
        <label for="axBMatricula"><i class="fas fa-hashtag"></i> FIN / Tail # <span style="color: var(--danger);">*</span></label>
        <input type="text" id="axBMatricula" class="form-control" value="<%= vuelo.Matricula || 'Pendiente' %>" readonly style="background-color: var(--bg); font-weight: 700;">
      </div>

      <div class="form-group">
        <label for="axBFecha"><i class="far fa-calendar-alt"></i> Date <span style="color: var(--danger);">*</span></label>
        <input type="date" id="axBFecha" class="form-control" value="<%= fechaInicial %>" required>
      </div>

      <div class="form-group">
        <label for="axBDepartureStation"><i class="fas fa-map-marker-alt"></i> Departure Station <span style="color: var(--danger);">*</span></label>
        <input type="text" id="axBDepartureStation" class="form-control" maxlength="20" value="<%= initialAnexoBPayload.departureStation %>" required>
      </div>

      <div class="form-group">
        <label for="axBOriginInbound"><i class="fas fa-plane-arrival"></i> Origin Inbound <span style="color: var(--danger);">*</span></label>
        <input type="text" id="axBOriginInbound" class="form-control" maxlength="100" value="<%= initialAnexoBPayload.originInbound %>" placeholder="Ej. YYZ" required>
      </div>

      <div class="form-group">
        <label for="axBDestinationOutbound"><i class="fas fa-route"></i> Destination Outbound <span style="color: var(--danger);">*</span></label>
        <input type="text" id="axBDestinationOutbound" class="form-control" maxlength="100" value="<%= initialAnexoBPayload.destinationOutbound %>" placeholder="Ej. YUL" required>
      </div>
    </div>

    <div id="axBHintOperacion" style="margin-top: 12px; padding: 10px 14px; border-radius: 8px; background: #EFF6FF; border: 1px solid #BFDBFE; color: #1E40AF; font-size: 12px; font-weight: 600;">
      Modo Tránsito: tanto la Parte 1 (Tiempos y Checklist General) como la Parte 2 (al menos 1 zona inspeccionada) son obligatorias.
    </div>
  </div>

  <!-- 2. PARTE 1: TIEMPOS Y CHECKLIST GENERAL -->
  <div class="card" id="axBParte1Card" style="border-top: 3px solid var(--brand);">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-tasks"></i> Parte 1 — Búsqueda General de Cabina</h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; margin-bottom: 18px;">
      <div class="form-group">
        <label for="axBSearchStartTime">
          <i class="far fa-clock"></i> Search Start Time <span class="axb-req-p1" style="color: var(--danger);">*</span>
        </label>
        <div class="cp-time-row">
          <input type="time" id="axBSearchStartTime" class="form-control" value="<%= initialAnexoBPayload.searchStartTime %>">
          <button type="button" id="btnAxBStartTimeAhora" class="cp-clock-btn" title="Usar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="axBTimeSearchCompleted">
          <i class="fas fa-clock"></i> Time Search Completed <span class="axb-req-p1" style="color: var(--danger);">*</span>
        </label>
        <div class="cp-time-row">
          <input type="time" id="axBTimeSearchCompleted" class="form-control" value="<%= initialAnexoBPayload.timeSearchCompleted %>">
          <button type="button" id="btnAxBEndTimeAhora" class="cp-clock-btn" title="Usar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="axBGeneralSearchType"><i class="fas fa-search"></i> General Search Type</label>
        <select id="axBGeneralSearchType" class="form-control">
          <option value="Física" <%= genSearchInicial === 'Física' ? 'selected' : '' %>>Física (Physical)</option>
          <option value="Visual" <%= genSearchInicial === 'Visual' ? 'selected' : '' %>>Visual</option>
        </select>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
      <% checklistRows.forEach((item, idx) => { const curVal = initialAnexoBPayload[item.key]; %>
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg);">
          <label for="<%= item.id %>" style="margin: 0; font-size: 12px; font-weight: 600; color: var(--text);">
            <%= idx + 1 %>. <%= item.label %>
          </label>
          <select id="<%= item.id %>" data-check-key="<%= item.key %>" class="form-control axb-check-select" style="width: 125px; flex-shrink: 0;">
            <option value="Realizado" <%= curVal === 'Realizado' ? 'selected' : '' %>>Realizado</option>
            <option value="N/A" <%= curVal === 'N/A' ? 'selected' : '' %>>N/A</option>
          </select>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- 3. PARTE 2: ZONAL SEARCH (MAX 5 ZONAS) -->
  <div class="card" id="axBParte2Card">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-th-list"></i> Parte 2 — Búsqueda Zonal (Zones 1 - 5) <span id="axBZonasBadge" class="badge badge-brand">0 / 5 Zonas</span>
      </h3>
      <button type="button" id="btnAxBAgregarZona" class="btn btn-primary" style="padding: 8px 14px; font-size: 12px;">
        <i class="fas fa-plus"></i> Agregar Zona
      </button>
    </div>

    <datalist id="axBZonasSugeridas">
      <option value="Zone 1 - Flight Deck &amp; Fwd Galley"></option>
      <option value="Zone 2 - Forward Cabin"></option>
      <option value="Zone 3 - Mid Cabin / Overwing"></option>
      <option value="Zone 4 - Aft Cabin"></option>
      <option value="Zone 5 - Aft Galley &amp; Crew Rest"></option>
    </datalist>

    <div class="er-table-wrap" id="axBGridWrapper">
      <table class="er-table">
        <thead>
          <tr>
            <th style="width: 65px; text-align: center;">Zone</th>
            <th style="min-width: 195px;">Employee Info (Nombre / TIA) <span class="er-req-star">*</span></th>
            <th style="min-width: 195px;">Zona de Cabina <span class="er-req-star">*</span></th>
            <th style="width: 120px;">Search Type <span class="er-req-star">*</span></th>
            <th style="width: 130px; text-align: center;">Time Started <span class="er-req-star">*</span></th>
            <th style="width: 130px; text-align: center;">Time Completed <span class="er-req-star">*</span></th>
            <th style="min-width: 165px;">Remarks (Opcional)</th>
            <th style="width: 66px; text-align: center;">Acción</th>
          </tr>
        </thead>
        <tbody id="axBTbodyZones"></tbody>
      </table>
    </div>
  </div>

  <!-- 4. VALIDACIÓN DE ID, LEAD SUPERVISOR & CSM SIGNATURES -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title"><i class="fas fa-signature"></i> Validación de Identificación y Firmas (Lead &amp; CSM)</h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 18px;">
      <div class="form-group">
        <label for="axBIdValidationRequired">ID Validation Required? <span style="color: var(--danger);">*</span></label>
        <select id="axBIdValidationRequired" class="form-control">
          <option value="NO" <%= idValInicial === 'NO' ? 'selected' : '' %>>NO</option>
          <option value="SÍ" <%= idValInicial === 'SÍ' ? 'selected' : '' %>>SÍ</option>
        </select>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <label for="axBIdValidationReport">
          ID Validation Report / Detalle <span id="axBReqIdReportStar" style="color: var(--danger); display: none;">*</span>
        </label>
        <input type="text" id="axBIdValidationReport" class="form-control" maxlength="2000" value="<%= initialAnexoBPayload.idValidationReport %>" placeholder="Obligatorio únicamente si seleccionó SÍ arriba...">
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 18px;">
      <div class="form-group">
        <label for="axBLeadName"><i class="fas fa-user-tie"></i> Lead / Supervisor Name (LAATS) <span style="color: var(--danger);">*</span></label>
        <input type="text" id="axBLeadName" class="form-control" list="axBSupervisoresList" maxlength="150" value="<%= initialAnexoBPayload.leadName %>" required>
        <datalist id="axBSupervisoresList">
          <% (supervisores || []).forEach(sup => { %>
            <option value="<%= sup.Nombre || sup.Usuario %>"></option>
          <% }) %>
        </datalist>
      </div>

      <div class="form-group">
        <label for="axBLeadEmployeeNumber"><i class="fas fa-id-badge"></i> Lead Employee Number / TIA <span style="color: var(--danger);">*</span></label>
        <input type="text" id="axBLeadEmployeeNumber" class="form-control" maxlength="50" value="<%= initialAnexoBPayload.leadEmployeeNumber %>" placeholder="Ej. 1024" required>
      </div>

      <div class="form-group">
        <label for="axBCsmName"><i class="fas fa-user-check"></i> Cabin Service Manager (CSM Name - Opcional)</label>
        <input type="text" id="axBCsmName" class="form-control" maxlength="150" value="<%= initialAnexoBPayload.csmName %>" placeholder="(Opcional) Nombre del CSM de Air Canada">
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <label style="font-size: 12px; font-weight: 700;">Lead Signature (LAATS) <span style="color: var(--danger);">*</span></label>
          <button type="button" id="btnLimpiarLeadFirmaAnexoB" class="btn btn-secondary" style="padding: 3px 10px; font-size: 11px;">
            <i class="fas fa-eraser"></i> Limpiar
          </button>
        </div>
        <% if (initialAnexoBPayload.leadSignature) { %>
          <div id="axBNoticeLeadFirma" style="background-color: var(--success-light); border: 1px solid #BBF7D0; color: var(--success); padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; margin-bottom: 6px; display: flex; align-items: center; justify-content: space-between;">
            <span><i class="fas fa-check-circle"></i> Firma Lead guardada.</span>
            <img src="<%= initialAnexoBPayload.leadSignature %>" alt="Lead Firma" style="max-height: 24px; background: #fff; border-radius: 3px;">
          </div>
        <% } %>
        <div class="signature-box" id="axBLeadSignatureBox">
          <canvas id="axBCanvasLeadFirma"></canvas>
        </div>
      </div>

      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <label style="font-size: 12px; font-weight: 700;">CSM Signature (Air Canada - Opcional)</label>
          <button type="button" id="btnLimpiarCsmFirmaAnexoB" class="btn btn-secondary" style="padding: 3px 10px; font-size: 11px;">
            <i class="fas fa-eraser"></i> Limpiar
          </button>
        </div>
        <% if (initialAnexoBPayload.csmSignature) { %>
          <div id="axBNoticeCsmFirma" style="background-color: var(--success-light); border: 1px solid #BBF7D0; color: var(--success); padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; margin-bottom: 6px; display: flex; align-items: center; justify-content: space-between;">
            <span><i class="fas fa-check-circle"></i> Firma CSM guardada.</span>
            <img src="<%= initialAnexoBPayload.csmSignature %>" alt="CSM Firma" style="max-height: 24px; background: #fff; border-radius: 3px;">
          </div>
        <% } %>
        <div class="signature-box" id="axBCsmSignatureBox">
          <canvas id="axBCanvasCsmFirma"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. ACCIONES -->
  <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; margin-bottom: 40px;">
    <button type="button" id="btnVistaPreliminarAnexoB" class="btn btn-secondary" style="padding: 12px 24px;">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoAnexoB" class="btn btn-primary" style="padding: 12px 28px;">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="anexoBInitialStateJson"><%- JSON.stringify(initialAnexoBPayload).replace(/</g, '\\u003c') %></script>
