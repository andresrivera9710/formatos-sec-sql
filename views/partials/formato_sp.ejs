<%
  const enc = (spState && spState.encabezado) ? spState.encabezado : {};
  const detalles = (spState && Array.isArray(spState.detalles)) ? spState.detalles : [];

  let fechaVal = new Date().toISOString().substring(0, 10);
  if (vuelo && vuelo.FechaItinerado) {
    fechaVal = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (enc.Fecha) {
    const d = new Date(enc.Fecha);
    if (!Number.isNaN(d.getTime())) fechaVal = d.toISOString().substring(0, 10);
  }

  const supCatalogo = (supervisores && supervisores.length > 0)
    ? supervisores.map(s => ({
        LoginId: s.LoginId || s.EmpleadoId,
        Usuario: s.Usuario,
        Codigo: s.Codigo || '',
        Puesto: s.PuestoEmpleado || s.Puesto || '',
        NombreCompleto: s.NombreCompleto || ''
      }))
    : (usuariosLogin || []).map(u => ({
        LoginId: u.LoginId,
        Usuario: u.Usuario,
        Codigo: '',
        Puesto: '',
        NombreCompleto: ''
      }));

  const supLoginIdVal = enc.LoginId ? String(enc.LoginId) : (user && user.loginId ? String(user.loginId) : '');
  const supExists = !supLoginIdVal || supCatalogo.some(s => String(s.LoginId) === supLoginIdVal);
  const agenteActual = (user && (user.usuario || user.nombreCompleto)) ? String(user.usuario || user.nombreCompleto).trim() : '';

  const initialSpPayload = {
    formatoId: formato.id,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    fecha: fechaVal,
    supervisorLoginId: supLoginIdVal,
    agenteActual,
    registros: detalles
  };
%>

<form id="formCapturaSP" novalidate>
  <input type="hidden" id="spFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="spItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="spEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. ENCABEZADO -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-user-check"></i> Selected Passenger — DELTA (<%= vuelo.novuelo || '--' %>)
      </h3>
      <div class="sio-card-header-meta">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary sio-btn-sm">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="spBadgeEstado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div class="sio-grid-auto">
      <div class="form-group">
        <label for="spFlight"><i class="fas fa-plane"></i> Flight # <i class="fas fa-lock input-lock-icon" title="Vinculado al itinerario (Solo lectura)"></i></label>
        <input type="text" id="spFlight" class="form-control input-locked" value="<%= vuelo.novuelo || '--' %>" readonly tabindex="-1">
      </div>

      <div class="form-group">
        <label for="spFecha"><i class="far fa-calendar-alt"></i> Date <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input type="date" id="spFecha" class="form-control input-locked" value="<%= fechaVal %>" readonly tabindex="-1" required>
      </div>

      <div class="form-group">
        <label for="spSupervisor"><i class="fas fa-user-tie"></i> Supervisor (LoginSEC) <span class="sio-required-star">*</span></label>
        <select id="spSupervisor" class="form-control" required data-search-placeholder="Buscar supervisor por nombre, código o puesto...">
          <option value="">-- Seleccione Supervisor --</option>
          <% supCatalogo.forEach(sup => { %>
            <option
              value="<%= sup.LoginId %>"
              data-usuario="<%= sup.Usuario %>"
              data-code="<%= sup.Codigo %>"
              data-puesto="<%= sup.Puesto %>"
              data-meta="<%= sup.NombreCompleto %>"
              <%= String(sup.LoginId) === supLoginIdVal ? 'selected' : '' %>
            ><%= sup.Usuario %></option>
          <% }) %>
          <% if (!supExists && supLoginIdVal) { %>
            <option value="<%= supLoginIdVal %>" selected><%= agenteActual || `Supervisor #${supLoginIdVal}` %></option>
          <% } %>
        </select>
      </div>
    </div>
  </div>

  <!-- 2. PANEL DE CAPTURA RÁPIDA DE PASAJERO -->
  <div class="card sio-card-accent">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title"><i class="fas fa-user-plus"></i> Agregar Pasajero Seleccionado</h3>
      <small class="sio-hint-text">Todos los campos con <span class="sio-required-star">*</span> son obligatorios</small>
    </div>

    <div class="sio-grid-auto-compact">
      <div class="form-group">
        <label for="spInputApellido">Last Name (Apellido) <span class="sio-required-star">*</span></label>
        <input type="text" id="spInputApellido" class="form-control" maxlength="150" placeholder="Ej: GARCIA" autocomplete="off" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="spInputNombre">First Name (Nombre) <span class="sio-required-star">*</span></label>
        <input type="text" id="spInputNombre" class="form-control" maxlength="150" placeholder="Ej: MARIA" autocomplete="off" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="spInputSeleccion">Selection (R / S / I) <span class="sio-required-star">*</span></label>
        <select id="spInputSeleccion" class="form-control" data-no-searchable="true">
          <option value="1">R Random</option>
          <option value="2">S Selected</option>
          <option value="3">I Interview</option>
        </select>
      </div>
      <div class="form-group">
        <label for="spInputAsiento">Seat No. <span class="sio-required-star">*</span></label>
        <input type="text" id="spInputAsiento" class="form-control" maxlength="20" placeholder="Ej: 14A" autocomplete="off" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="spInputBCN">BCN <span class="sio-required-star">*</span></label>
        <input type="number" id="spInputBCN" class="form-control" min="0" step="1" inputmode="numeric" placeholder="Ej: 1" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="spInputScreener">Screener Name &amp; Sig <span class="sio-required-star">*</span></label>
        <input type="text" id="spInputScreener" class="form-control" maxlength="150" value="<%= agenteActual %>" placeholder="Nombre del screener" autocomplete="off" enterkeyhint="done">
      </div>
    </div>

    <div class="dl-sp-sig-row">
      <div class="dl-sp-sig-col">
        <div class="dl-sig-toolbar">
          <label class="dl-sig-label" for="spCanvasFirmaScreener">
            <i class="fas fa-signature"></i> Screener Signature (Firma Digital):
          </label>
          <button type="button" id="btnLimpiarFirmaScreenerSP" class="btn btn-secondary sio-btn-xs">
            <i class="fas fa-eraser"></i> Limpiar Firma
          </button>
        </div>
        <div class="signature-box dl-sig-box-compact" id="spSignatureBoxScreener">
          <canvas id="spCanvasFirmaScreener"></canvas>
        </div>
      </div>

      <div class="sio-form-actions-end cp-form-actions">
        <button type="button" id="btnAgregarFilaVaciaSP" class="btn btn-secondary">
          <i class="fas fa-table"></i> + Insertar Fila en Blanco
        </button>
        <button type="button" id="btnAgregarRegistroSP" class="btn btn-primary">
          <i class="fas fa-plus-circle"></i> Agregar Pasajero a Cuadrícula
        </button>
      </div>
    </div>
  </div>

  <!-- 3. CUADRÍCULA FLUIDA + RESUMEN POR CÓDIGO -->
  <div class="card" id="spCardCuadricula">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title"><i class="fas fa-th-list"></i> Listado de Pasajeros Seleccionados</h3>
      <div class="sio-card-header-meta">
        <span class="er-total-counter-badge">R Random: <strong id="spTotalRandomBadge">0</strong></span>
        <span class="er-total-counter-badge">S Selected: <strong id="spTotalSelectedBadge">0</strong></span>
        <span class="er-total-counter-badge">I Interview: <strong id="spTotalInterviewBadge">0</strong></span>
        <span class="er-total-counter-badge dl-badge-total">Total: <strong id="spTotalGeneralBadge">0</strong></span>
      </div>
    </div>

    <div class="er-fluid-grid-wrapper dl-grid-wrapper" id="spGridWrapper">
      <table class="er-fluid-table dl-stacked-table" id="spTablaCuadricula">
        <thead>
          <tr>
            <th class="dl-th-num">NO.</th>
            <th>APELLIDO <span class="er-req-star">*</span></th>
            <th>NOMBRE <span class="er-req-star">*</span></th>
            <th class="dl-th-sel">SELECTION <span class="er-req-star">*</span></th>
            <th class="dl-th-seat">SEAT NO. <span class="er-req-star">*</span></th>
            <th class="dl-th-bcn">BCN <span class="er-req-star">*</span></th>
            <th>SCREENER NAME <span class="er-req-star">*</span></th>
            <th class="dl-th-action">ACCIÓN</th>
          </tr>
        </thead>
        <tbody id="spTbodyRegistros"></tbody>
      </table>
    </div>
  </div>

  <!-- 4. ACCIONES -->
  <div class="sio-bottom-actions">
    <button type="button" id="btnVistaPreliminarSP" class="btn btn-secondary sio-btn-action">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoSP" class="btn btn-primary sio-btn-action-primary">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="spInitialStateJson"><%- JSON.stringify(initialSpPayload).replace(/</g, '\\u003c') %></script>
