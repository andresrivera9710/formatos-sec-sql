<%
  const enc = (ccdaState && ccdaState.encabezado) ? ccdaState.encabezado : {};
  const detalles = (ccdaState && Array.isArray(ccdaState.detalles)) ? ccdaState.detalles : [];
  const empresasCCDA = (ccdaState && Array.isArray(ccdaState.empresas) && ccdaState.empresas.length > 0)
    ? ccdaState.empresas
    : ['LAATS', 'FEDEX', 'OTROS...'];

  const extractHHMM = (val) => {
    if (!val) return '';
    if (val instanceof Date) return val.toISOString().substring(11, 16);
    const s = String(val).trim();
    if (s.includes('T') && s.length >= 16) return s.substring(11, 16);
    const m = s.match(/(\d{2}:\d{2})/);
    return m ? m[1] : '';
  };

  let fechaInicial = '';
  if (enc.Fecha) {
    fechaInicial = String(enc.Fecha instanceof Date ? enc.Fecha.toISOString() : enc.Fecha).substring(0, 10);
  } else if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else {
    fechaInicial = new Date().toISOString().substring(0, 10);
  }

  // Lista unificada y deduplicada de personal (LogIn + Empleados activos)
  const personalCatalogMap = new Map();
  (usuariosLogin || []).forEach((u) => {
    const eid = parseInt(u.EmpleadoId, 10) || 0;
    if (!eid) return;
    const label = String(u.NombreCompleto || u.Usuario || '').trim();
    if (!label) return;
    personalCatalogMap.set(eid, {
      EmpleadoId: eid,
      Nombre: label,
      Usuario: String(u.Usuario || label).trim()
    });
  });
  (empleados || []).forEach((emp) => {
    const eid = parseInt(emp.EmpleadoId, 10) || 0;
    if (!eid || personalCatalogMap.has(eid)) return;
    const label = String(emp.Nombre || '').trim();
    if (!label) return;
    personalCatalogMap.set(eid, {
      EmpleadoId: eid,
      Nombre: label,
      Usuario: label
    });
  });
  const personalCatalog = Array.from(personalCatalogMap.values()).sort((a, b) =>
    a.Nombre.localeCompare(b.Nombre, 'es', { sensitivity: 'base' })
  );

  const operarioIdVal = enc.OperarioEmpleadoId ? String(enc.OperarioEmpleadoId) : '';
  const operarioNombreVal = String(enc.OperarioNombre || '').trim();
  const operarioEmpresaVal = String(enc.OperarioEmpresa || 'LAATS').trim() || 'LAATS';
  const operarioInCatalog = !operarioIdVal || personalCatalogMap.has(parseInt(operarioIdVal, 10));

  const llegadaDefault = extractHHMM(enc.LlegadaMeta)
    || extractHHMM(enc.Llegada && enc.Llegada !== 'NA' ? enc.Llegada : '')
    || extractHHMM(vuelo && vuelo.ata)
    || extractHHMM(vuelo && vuelo.eta)
    || '';
  const arriboDefault = extractHHMM(enc.Arribo) || extractHHMM(vuelo && vuelo.ata) || '';
  const salidaDefault = extractHHMM(enc.Salida)
    || extractHHMM(vuelo && vuelo.atd)
    || extractHHMM(vuelo && vuelo.etd)
    || '';

  const supVal = String(enc.Supervisor || '').trim();
  const supList = (supervisores || []).map(s => String(s.Usuario || s.NombreCompleto || '').trim()).filter(Boolean);
  const supExistsInList = !supVal || supList.some(s => s.toUpperCase() === supVal.toUpperCase());

  const initialPersonal = detalles.map((d) => ({
    DetalleIngresoCCDAId: parseInt(d.DetalleIngresoCCDAId, 10) || 0,
    EmpleadoId: parseInt(d.EmpleadoId, 10) || 0,
    Personal: String(d.Personal || d.NombreEmpleado || '').trim(),
    Empresa: String(d.Empresa || 'LAATS').trim() || 'LAATS',
    Entrada: extractHHMM(d.Entrada),
    Salida: extractHHMM(d.Salida),
    SegundaEntrada: extractHHMM(d.SegundaEntrada),
    SegundaSalida: extractHHMM(d.SegundaSalida)
  }));

  const initialCcdaPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    fecha: fechaInicial,
    llegada: llegadaDefault,
    arribo: arriboDefault,
    operarioEmpleadoId: operarioIdVal,
    operarioNombre: operarioNombreVal,
    operarioEmpresa: operarioEmpresaVal,
    acopla: extractHHMM(enc.Acopla),
    puertaAbierta: extractHHMM(enc.PuertaAbierta),
    escaleraAcoplada: extractHHMM(enc.EscaleraAcoplada),
    aperturaAeronave: extractHHMM(enc.AperturaAeronave),
    inicioDescargue: extractHHMM(enc.InicioDescargue),
    iniciaCargue: extractHHMM(enc.IniciaCargue),
    terminaDescargue: extractHHMM(enc.TerminaDescargue),
    terminaCargue: extractHHMM(enc.TerminaCargue),
    cierreAeronave: extractHHMM(enc.CierreAeronave),
    desacopla: extractHHMM(enc.Desacopla),
    puertaCerrada: extractHHMM(enc.PuertaCerrada),
    escaleraDesacoplada: extractHHMM(enc.EscaleraDesacoplada),
    pushBack: extractHHMM(enc.PushBack),
    salida: salidaDefault,
    cantCombustible: enc.CantCombustible !== undefined && enc.CantCombustible !== null ? String(enc.CantCombustible) : '',
    observaciones: String(enc.Observaciones || '').trim(),
    supervisor: supVal,
    agenteSeguridad: String((user && (user.usuario || user.nombreCompleto)) || enc.AgenteSeguridad || '').trim(),
    empresas: empresasCCDA,
    personal: initialPersonal
  };
%>

<form id="formCapturaCCDA" novalidate>
  <input type="hidden" id="ccdaFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="ccdaItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="ccdaEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. DATOS DEL VUELO Y ARRIBO -->
  <div class="card">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-plane-arrival"></i> 1. Datos del Vuelo y Arribo — Control Cargue y Descargue Aeronave (FEDEX)
      </h3>
      <div style="display: flex; align-items: center; gap: 10px;">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px;">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="ccdaBadgeEstadoEncabezado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="ccdaFecha"><i class="far fa-calendar-alt"></i> Fecha <span style="color: var(--danger);">*</span></label>
        <input type="date" id="ccdaFecha" class="form-control" value="<%= fechaInicial %>" required>
      </div>

      <div class="form-group">
        <label for="ccdaNoVuelo"><i class="fas fa-plane"></i> No. Vuelo</label>
        <input type="text" id="ccdaNoVuelo" class="form-control" value="<%= vuelo.novuelo || '' %>" readonly style="background-color: var(--bg); font-weight: 700; color: var(--brand-deep);">
      </div>

      <div class="form-group">
        <label for="ccdaMatricula"><i class="fas fa-hashtag"></i> Matrícula</label>
        <input type="text" id="ccdaMatricula" class="form-control" value="<%= vuelo.Matricula || 'Pendiente' %>" readonly style="background-color: var(--bg); font-weight: 700;">
      </div>

      <div class="form-group">
        <label for="ccdaDestino"><i class="fas fa-map-marker-alt"></i> Destino</label>
        <input type="text" id="ccdaDestino" class="form-control" value="<%= vuelo.Destino || vuelo.destino || 'N/A' %>" readonly style="background-color: var(--bg); font-weight: 700;">
      </div>

      <div class="form-group">
        <label for="ccdaLlegada"><i class="far fa-clock"></i> Llegada (ATA)</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaLlegada" class="form-control" value="<%= initialCcdaPayload.llegada %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaLlegada" title="Establecer hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaArribo"><i class="fas fa-plane-arrival"></i> Arribo Aeronave</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaArribo" class="form-control" value="<%= initialCcdaPayload.arribo %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaArribo" title="Establecer hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. OPERARIO DE LOADER O FAJA (LAATS) -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title">
        <i class="fas fa-dolly"></i> 2. Operario de Loader o Faja (LAATS)
      </h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
      <div class="form-group" style="grid-column: span 2; min-width: 260px;">
        <label for="ccdaOperarioSelect"><i class="fas fa-user-hard-hat"></i> Operario de Loader o Faja (LAATS) <span style="color: var(--danger);">*</span></label>
        <select id="ccdaOperarioSelect" class="form-control" required>
          <option value="">-- Seleccione Operario LAATS --</option>
          <% if (!operarioInCatalog && operarioIdVal) { %>
            <option value="<%= operarioIdVal %>" data-nombre="<%= operarioNombreVal || `Operario #${operarioIdVal}` %>" selected>
              <%= operarioNombreVal || `Operario #${operarioIdVal}` %> (ID: <%= operarioIdVal %>)
            </option>
          <% } %>
          <% personalCatalog.forEach(emp => { %>
            <option
              value="<%= emp.EmpleadoId %>"
              data-nombre="<%= emp.Nombre %>"
              <%= String(emp.EmpleadoId) === operarioIdVal ? 'selected' : '' %>
            ><%= emp.Nombre %> (ID: <%= emp.EmpleadoId %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="ccdaOperarioId"><i class="fas fa-id-badge"></i> ID# Empleado <span style="color: var(--danger);">*</span></label>
        <input type="number" id="ccdaOperarioId" class="form-control" min="1" step="1" value="<%= operarioIdVal %>" placeholder="ID Empleado" readonly style="background-color: var(--bg); font-weight: 700;">
      </div>

      <div class="form-group">
        <label for="ccdaOperarioEmpresa"><i class="fas fa-building"></i> Empresa <span style="color: var(--danger);">*</span></label>
        <input type="text" id="ccdaOperarioEmpresa" class="form-control" maxlength="100" value="<%= operarioEmpresaVal %>" placeholder="LAATS" required>
      </div>

      <div class="form-group">
        <label for="ccdaAcopla"><i class="far fa-clock"></i> Hora Acopla Loader <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="ccdaAcopla" class="form-control" value="<%= initialCcdaPayload.acopla %>" required>
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaAcopla" title="Establecer hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. APERTURA E INICIO DE OPERACIONES -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title">
        <i class="fas fa-door-open"></i> 3. Apertura e Inicio de Operaciones
      </h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="ccdaPuertaAbierta"><i class="far fa-clock"></i> Puerta Abierta</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaPuertaAbierta" class="form-control" value="<%= initialCcdaPayload.puertaAbierta %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaPuertaAbierta"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaEscaleraAcoplada"><i class="far fa-clock"></i> Escalera Acoplada</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaEscaleraAcoplada" class="form-control" value="<%= initialCcdaPayload.escaleraAcoplada %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaEscaleraAcoplada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaAperturaAeronave"><i class="far fa-clock"></i> Apertura Compuerta (Bodega)</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaAperturaAeronave" class="form-control" value="<%= initialCcdaPayload.aperturaAeronave %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaAperturaAeronave"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaInicioDescargue"><i class="far fa-clock"></i> Inicia Descarga</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaInicioDescargue" class="form-control" value="<%= initialCcdaPayload.inicioDescargue %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaInicioDescargue"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaIniciaCargue"><i class="far fa-clock"></i> Inicia Carga</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaIniciaCargue" class="form-control" value="<%= initialCcdaPayload.iniciaCargue %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaIniciaCargue"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. REGISTRO DE PERSONAL EN AERONAVE (LAATS) — CUADRÍCULA FLUIDA -->
  <div class="card" style="border-top: 3px solid var(--brand);">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-user-plus"></i> 4. Registro de Personal en Aeronave (LAATS)
      </h3>
      <span style="font-size: 11px; color: var(--text-3);">
        La <strong>1° Salida</strong> puede registrarse al egreso; todo el personal debe tener <strong>1° Salida</strong> antes del Guardado Definitivo.
      </span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(185px, 1fr)); gap: 12px; align-items: end;">
      <div class="form-group" style="grid-column: span 2; min-width: 240px; margin-bottom: 0;">
        <label for="ccdaQuickPersonalSelect"><i class="fas fa-user-check"></i> Buscar Personal (Catálogo LAATS)</label>
        <select id="ccdaQuickPersonalSelect" class="form-control">
          <option value="">-- Seleccione o ingrese manualmente --</option>
          <% personalCatalog.forEach(emp => { %>
            <option value="<%= emp.EmpleadoId %>" data-nombre="<%= emp.Nombre %>"><%= emp.Nombre %> (ID: <%= emp.EmpleadoId %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label for="ccdaQuickNombre">Nombre Personal <span style="color: var(--danger);">*</span></label>
        <input type="text" id="ccdaQuickNombre" class="form-control" maxlength="150" placeholder="Nombre completo">
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label for="ccdaQuickEmpleadoId">ID# Empleado / TIA <span style="color: var(--danger);">*</span></label>
        <input type="number" id="ccdaQuickEmpleadoId" class="form-control" min="1" step="1" placeholder="Ej. 213">
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label for="ccdaQuickEmpresa">Empresa <span style="color: var(--danger);">*</span></label>
        <select id="ccdaQuickEmpresa" class="form-control">
          <% empresasCCDA.forEach(empr => { %>
            <option value="<%= empr %>"><%= empr %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group" id="ccdaQuickEmpresaOtrosGroup" style="display: none; margin-bottom: 0;">
        <label for="ccdaQuickEmpresaOtros">Especificar Empresa <span style="color: var(--danger);">*</span></label>
        <input type="text" id="ccdaQuickEmpresaOtros" class="form-control" maxlength="100" placeholder="Nombre de la empresa">
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label for="ccdaQuickEntrada">Hora 1° Entrada <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="ccdaQuickEntrada" class="form-control">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaQuickEntrada" title="Establecer hora actual">
            <i class="far fa-clock"></i>
          </button>
        </div>
      </div>

      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button type="button" id="btnCcdaAgregarPersonal" class="btn btn-primary" style="flex: 1;">
          <i class="fas fa-plus"></i> Agregar Personal
        </button>
        <button type="button" id="btnCcdaFilaManual" class="btn btn-secondary" title="Insertar fila editable vacía en cuadrícula">
          <i class="fas fa-table"></i> + Fila
        </button>
      </div>
    </div>

    <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-2);">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px;">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
          <span class="er-total-counter-badge">
            <i class="fas fa-users"></i> Personal Registrado: <strong id="ccdaTotalBadge">0</strong>
          </span>
          <span class="badge badge-danger" id="ccdaPendientesBadge" style="display: none;">0 sin 1° salida</span>
        </div>
        <input type="search" id="ccdaFiltroPersonal" class="form-control" style="max-width: 260px; padding: 6px 10px; font-size: 12px;" placeholder="Filtrar por nombre, ID o empresa...">
      </div>

      <div class="er-fluid-grid-wrapper" id="ccdaGridWrapper">
        <table class="er-fluid-table">
          <thead>
            <tr>
              <th style="width: 44px; text-align: center;">#</th>
              <th style="min-width: 210px;">Personal <span class="er-req-star">*</span></th>
              <th style="width: 110px; text-align: center;">ID# <span class="er-req-star">*</span></th>
              <th style="min-width: 150px;">Empresa <span class="er-req-star">*</span></th>
              <th style="width: 150px; text-align: center;">1° Entrada <span class="er-req-star">*</span></th>
              <th style="width: 155px; text-align: center;">1° Salida <span class="er-req-star">*</span></th>
              <th style="width: 150px; text-align: center;">2° Entrada</th>
              <th style="width: 150px; text-align: center;">2° Salida</th>
              <th style="width: 68px; text-align: center;">Acción</th>
            </tr>
          </thead>
          <tbody id="ccdaTbodyPersonal"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 5. FINALIZACIÓN Y CIERRE DE OPERACIONES -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title">
        <i class="fas fa-flag-checkered"></i> 5. Finalización y Cierre de Operaciones
      </h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="ccdaTerminaDescargue"><i class="far fa-clock"></i> Termina Descarga</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaTerminaDescargue" class="form-control" value="<%= initialCcdaPayload.terminaDescargue %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaTerminaDescargue"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaTerminaCargue"><i class="far fa-clock"></i> Termina Carga</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaTerminaCargue" class="form-control" value="<%= initialCcdaPayload.terminaCargue %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaTerminaCargue"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaCierreAeronave"><i class="far fa-clock"></i> Cierre Compuerta (Bodega)</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaCierreAeronave" class="form-control" value="<%= initialCcdaPayload.cierreAeronave %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaCierreAeronave"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaDesacopla"><i class="far fa-clock"></i> Desacopla Loader</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaDesacopla" class="form-control" value="<%= initialCcdaPayload.desacopla %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaDesacopla"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaPuertaCerrada"><i class="far fa-clock"></i> Puerta Cerrada</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaPuertaCerrada" class="form-control" value="<%= initialCcdaPayload.puertaCerrada %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaPuertaCerrada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaEscaleraDesacoplada"><i class="far fa-clock"></i> Escalera Desacoplada</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaEscaleraDesacoplada" class="form-control" value="<%= initialCcdaPayload.escaleraDesacoplada %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaEscaleraDesacoplada"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. SALIDA DEL VUELO, OBSERVACIONES Y CIERRE -->
  <div class="card">
    <div class="card-header">
      <h3 class="cp-section-title">
        <i class="fas fa-plane-departure"></i> 6. Salida del Vuelo, Observaciones y Cierre
      </h3>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="ccdaPushBack"><i class="far fa-clock"></i> Push Back</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaPushBack" class="form-control" value="<%= initialCcdaPayload.pushBack %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaPushBack"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaSalida"><i class="far fa-clock"></i> Salida (ETD / ATD)</label>
        <div class="cp-time-row">
          <input type="time" id="ccdaSalida" class="form-control" value="<%= initialCcdaPayload.salida %>">
          <button type="button" class="cp-clock-btn" data-clock-target="ccdaSalida"><i class="far fa-clock"></i> Ahora</button>
        </div>
      </div>

      <div class="form-group">
        <label for="ccdaCantCombustible"><i class="fas fa-gas-pump"></i> Combustible (Galones)</label>
        <input type="number" id="ccdaCantCombustible" class="form-control" min="0" step="1" inputmode="numeric" value="<%= initialCcdaPayload.cantCombustible %>" placeholder="Cantidad en galones">
      </div>

      <div class="form-group">
        <label for="ccdaSupervisor"><i class="fas fa-user-tie"></i> Supervisor LAATS <span style="color: var(--danger);">*</span></label>
        <select id="ccdaSupervisor" class="form-control" required>
          <option value="">-- Seleccione el Supervisor --</option>
          <% if (!supExistsInList && supVal) { %>
            <option value="<%= supVal %>" selected><%= supVal %></option>
          <% } %>
          <% (supervisores || []).forEach(sup => {
               const supName = String(sup.Usuario || sup.NombreCompleto || '').trim();
               const isSel = supVal && supName.toUpperCase() === supVal.toUpperCase();
          %>
            <option value="<%= supName %>" <%= isSel ? 'selected' : '' %>><%= supName %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="ccdaAgente"><i class="fas fa-user-shield"></i> Agente de Seguridad LAATS <span style="color: var(--danger);">*</span></label>
        <input type="text" id="ccdaAgente" class="form-control" value="<%= initialCcdaPayload.agenteSeguridad %>" readonly style="background-color: var(--bg); font-weight: 700; color: var(--brand);">
      </div>
    </div>

    <div class="form-group" style="margin-top: 10px; margin-bottom: 0;">
      <label for="ccdaObservaciones"><i class="fas fa-comment-alt"></i> Observaciones (Opcional)</label>
      <textarea id="ccdaObservaciones" class="form-control" rows="3" maxlength="3500" placeholder="Ingrese observaciones adicionales sobre la operación de cargue/descargue..."><%= initialCcdaPayload.observaciones %></textarea>
    </div>
  </div>

  <!-- BOTONES DE ACCIÓN -->
  <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; margin-bottom: 40px;">
    <button type="button" id="btnVistaPreliminarCCDA" class="btn btn-secondary" style="padding: 12px 24px;">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoCCDA" class="btn btn-primary" style="padding: 12px 28px;">
      <i class="fas fa-save"></i> <%= esNuevo ? 'Guardar Formato Definitivo' : 'Actualizar Formato Definitivo' %>
    </button>
  </div>
</form>

<script type="application/json" id="ccdaInitialStateJson"><%- JSON.stringify(initialCcdaPayload).replace(/</g, '\\u003c') %></script>
