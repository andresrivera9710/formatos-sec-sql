<%
  const comp = (erState && erState.complemento) ? erState.complemento : {};
  const detalles = (erState && Array.isArray(erState.detalles)) ? erState.detalles : [];

  let fechaInicial = '';
  if (comp.Fecha) {
    fechaInicial = String(comp.Fecha instanceof Date ? comp.Fecha.toISOString() : comp.Fecha).substring(0, 10);
  } else if (vuelo && vuelo.FechaItinerado) {
    fechaInicial = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else {
    fechaInicial = new Date().toISOString().substring(0, 10);
  }

  const observacionInicial = comp.Observacion ? String(comp.Observacion).trim() : '';
  const agenteActual = (user && user.usuario) ? String(user.usuario).trim() : '';
  const noVueloActivo = (vuelo && vuelo.novuelo) ? String(vuelo.novuelo).trim() : '';
  const destinoActivo = (vuelo && (vuelo.Destino || vuelo.destino)) ? String(vuelo.Destino || vuelo.destino).trim() : '';

  const initialErPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    fecha: fechaInicial,
    noVuelo: noVueloActivo,
    destinoVuelo: destinoActivo,
    agenteActual,
    observaciones: observacionInicial,
    detalles
  };
%>

<form id="formCapturaER" novalidate>
  <input type="hidden" id="erFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="erItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="erEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. ENCABEZADO DEL FORMATO (ControlEquipajeAVSECAMX) -->
  <div class="card">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-x-ray"></i> Encabezado — Control de Equipaje en Revisión AVSEC/SGDAIA Banda de Salida (Rayos X)
      </h3>
      <div style="display: flex; align-items: center; gap: 10px;">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px;">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="erBadgeEstadoEncabezado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
      <div class="form-group">
        <label for="erFecha"><i class="far fa-calendar-alt"></i> Fecha de Inspección <span style="color: var(--danger);">*</span></label>
        <input type="date" id="erFecha" class="form-control" value="<%= fechaInicial %>" required>
      </div>

      <div class="form-group">
        <label for="erNoVuelo"><i class="fas fa-plane-departure"></i> No. de Vuelo <span style="color: var(--danger);">*</span></label>
        <input type="text" id="erNoVuelo" class="form-control" value="<%= noVueloActivo %>" readonly style="background-color: var(--bg); font-weight: 700; color: var(--brand-deep);">
      </div>

      <div class="form-group">
        <label for="erDestinoOperacion"><i class="fas fa-map-pin"></i> Destino del Vuelo</label>
        <input type="text" id="erDestinoOperacion" class="form-control" value="<%= destinoActivo || 'N/A' %>" readonly style="background-color: var(--bg); font-weight: 600;">
      </div>

      <div class="form-group">
        <label for="erAgenteSeguridadHeader"><i class="fas fa-user-shield"></i> Nombre de Seguridad Aerolínea (LoginSEC) <span style="color: var(--danger);">*</span></label>
        <input type="text" id="erAgenteSeguridadHeader" class="form-control" value="<%= agenteActual %>" readonly style="background-color: var(--bg); font-weight: 700; color: var(--brand);">
      </div>
    </div>
  </div>

  <!-- 2. PANEL DE CAPTURA RÁPIDA ("Ingrese los Datos" - cntDatos_17 en Power Apps) -->
  <div class="card" style="border-top: 3px solid var(--brand);">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <h3 class="cp-section-title">
        <i class="fas fa-Suitcase-rolling fa-luggage-cart"></i> Ingrese los Datos del Equipaje Revisado
      </h3>
      <span style="font-size: 11px; color: var(--text-3);">
        Los campos marcados con <strong style="color: var(--danger);">*</strong> son obligatorios
      </span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; align-items: end;">
      <div class="form-group" style="grid-column: span 2; min-width: 240px;">
        <label for="erInputPasajero"><i class="fas fa-user"></i> Nombre del Pasajero <span style="color: var(--danger);">*</span></label>
        <input type="text" id="erInputPasajero" class="form-control" maxlength="200" placeholder="Ej: JUAN PÉREZ LÓPEZ" autocomplete="off">
      </div>

      <div class="form-group">
        <label for="erInputSecuencia"><i class="fas fa-sort-numeric-up"></i> Secuencia <span style="color: var(--danger);">*</span></label>
        <input type="number" id="erInputSecuencia" class="form-control" min="1" step="1" inputmode="numeric" placeholder="Ej: 45">
      </div>

      <div class="form-group">
        <label for="erInputColilla"><i class="fas fa-barcode"></i> No. de Colilla / Marbete <span style="color: var(--danger);">*</span></label>
        <input type="number" id="erInputColilla" class="form-control" min="1" step="1" inputmode="numeric" placeholder="Ej: 0139485721">
      </div>

      <div class="form-group">
        <label for="erInputDestino"><i class="fas fa-globe-americas"></i> Destino <span style="color: var(--text-3); font-weight: 400;">(Opcional)</span></label>
        <input type="text" id="erInputDestino" class="form-control" maxlength="100" value="<%= destinoActivo %>" placeholder="Ej: <%= destinoActivo || 'MEX' %>">
      </div>

      <div class="form-group">
        <label for="erInputHoraRevision"><i class="far fa-clock"></i> Hora de Revisión <span style="color: var(--danger);">*</span></label>
        <div class="cp-time-row">
          <input type="time" id="erInputHoraRevision" class="form-control">
          <button type="button" id="btnRelojHoraER" class="cp-clock-btn" title="Capturar hora actual">
            <i class="far fa-clock"></i> Ahora
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="erInputAgenteAVSEC"><i class="fas fa-id-badge"></i> Nombre Agente AVSEC (Inspección) <span style="color: var(--danger);">*</span></label>
        <input type="text" id="erInputAgenteAVSEC" class="form-control" maxlength="150" placeholder="Nombre del agente AVSEC/SGDAIA" autocomplete="off">
      </div>

      <div class="form-group">
        <label for="erInputAgenteSeguridad"><i class="fas fa-user-check"></i> Agente de Seguridad <%= vuelo.operador %> <span style="color: var(--danger);">*</span></label>
        <input type="text" id="erInputAgenteSeguridad" class="form-control" maxlength="150" value="<%= agenteActual %>" placeholder="Agente de seguridad <%= vuelo.operador %>">
      </div>
    </div>

    <div style="margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border-2); display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px;">
      <button type="button" id="btnAgregarFilaVaciaER" class="btn btn-secondary">
        <i class="fas fa-table"></i> + Insertar Fila en Blanco en Cuadrícula
      </button>
      <button type="button" id="btnAgregarEquipajeER" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Agregar Equipaje a la Cuadrícula
      </button>
    </div>
  </div>

  <!-- 3. CUADRÍCULA FLUIDA DE EQUIPAJES REVISADOS (ColPasajeros / DetalleControlER) -->
  <div class="card" id="erCardCuadricula">
    <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-th-list"></i> Cuadrícula Fluida — Equipajes en Revisión AVSEC / SGDAIA
        </h3>
        <small style="color: var(--text-3); font-size: 11px;">
          Puede editar directamente cualquier celda de la cuadrícula. Todos los campos con <span style="color: var(--danger); font-weight: 700;">*</span> son obligatorios para guardar.
        </small>
      </div>

      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px;">
        <div style="position: relative; min-width: 240px;">
          <i class="fas fa-search" style="position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--text-3); font-size: 12px;"></i>
          <input type="search" id="erBuscarPasajero" class="form-control" style="padding-left: 32px; padding-top: 7px; padding-bottom: 7px; font-size: 12px;" placeholder="Buscar pasajero, secuencia, colilla...">
        </div>

        <div class="er-total-counter-badge">
          <span>Recuento Total de equipajes revisados:</span>
          <strong id="erRecuentoTotal"><%= detalles.length %></strong>
        </div>
      </div>
    </div>

    <div class="er-fluid-grid-wrapper" id="erGridWrapper">
      <table class="er-fluid-table" id="erTablaCuadricula">
        <thead>
          <tr>
            <th style="width: 52px; text-align: center;">NO.</th>
            <th style="min-width: 200px;">NOMBRE DEL PASAJERO <span class="er-req-star">*</span></th>
            <th style="width: 115px; text-align: center;">SECUENCIA <span class="er-req-star">*</span></th>
            <th style="width: 145px; text-align: center;">NO. DE COLILLA <span class="er-req-star">*</span></th>
            <th style="width: 95px; text-align: center;">VUELO</th>
            <th style="width: 110px; text-align: center;">DESTINO</th>
            <th style="width: 155px; text-align: center;">HORA DE REVISIÓN <span class="er-req-star">*</span></th>
            <th style="min-width: 185px;">NOMBRE AGENTE AVSEC QUE REALIZA INSPECCIÓN <span class="er-req-star">*</span></th>
            <th style="min-width: 185px;">AGENTE DE SEGURIDAD <%= String(vuelo.operador || '').toUpperCase() %> DURANTE LA INSPECCIÓN <span class="er-req-star">*</span></th>
            <th style="width: 68px; text-align: center;">ACCIÓN</th>
          </tr>
        </thead>
        <tbody id="erTbodyRegistros">
          <!-- Renderizado dinámico y seguro por public/js/formato-er.js -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4. OBSERVACIONES Y FIRMA DIGITAL DE SEGURIDAD -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 20px;">
    <div class="card">
      <div class="card-header">
        <h3 class="cp-section-title"><i class="fas fa-comment-dots"></i> Observaciones</h3>
        <span style="font-size: 11px; color: var(--text-3);">Opcional</span>
      </div>
      <div class="form-group">
        <label for="erObservaciones">Observaciones y Novedades de Revisión en Banda de Salida (Rayos X)</label>
        <textarea id="erObservaciones" class="form-control" rows="5" maxlength="2000" placeholder="(Opcional) Ingrese cualquier observación relevante durante la inspección de equipaje..."><%= observacionInicial %></textarea>
      </div>
    </div>

    <div class="card">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 class="cp-section-title">
          <i class="fas fa-signature"></i> Firma de Seguridad Aerolínea
          <% if (esNuevo) { %>
            <span style="color: var(--danger);">*</span>
          <% } %>
        </h3>
        <button type="button" id="btnLimpiarFirmaER" class="btn btn-secondary" style="padding: 4px 10px; font-size: 11px;">
          <i class="fas fa-eraser"></i> Limpiar Firma
        </button>
      </div>

      <% if (!esNuevo && encabezadoId) { %>
        <div id="erNoticeFirmaExistente" style="background-color: var(--success-light); border: 1px solid #BBF7D0; color: var(--success); padding: 8px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
          <i class="fas fa-check-circle"></i>
          <span>Registro #<%= encabezadoId %> ya validado en base de datos. Puede trazar una nueva firma si desea actualizar la Vista Preliminar / PDF.</span>
        </div>
      <% } %>

      <div class="signature-box" id="erSignatureBox">
        <canvas id="erCanvasFirma"></canvas>
      </div>
      <p style="font-size: 11px; color: var(--text-3); text-align: center; margin-top: 4px;">
        Agente firmante: <strong style="color: var(--text);"><%= agenteActual %></strong> — Trace su firma dentro del recuadro.
      </p>
    </div>
  </div>

  <!-- 5. BOTONES DE ACCIÓN (Vista Preliminar + Guardar Definitivo) -->
  <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; margin-bottom: 40px;">
    <button type="button" id="btnVistaPreliminarER" class="btn btn-secondary" style="padding: 12px 24px;">
      <i class="fas fa-eye"></i> Vista Preliminar (Formato Oficial <%= vuelo.operador %>)
    </button>
    <button type="button" id="btnGuardarDefinitivoER" class="btn btn-primary" style="padding: 12px 28px;">
      <i class="fas fa-save"></i> Guardar Formato Definitivo
    </button>
  </div>
</form>

<script type="application/json" id="erInitialStateJson"><%- JSON.stringify(initialErPayload).replace(/</g, '\\u003c') %></script>
