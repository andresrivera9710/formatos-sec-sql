<%
  const comp = (erState && erState.complemento) ? erState.complemento : {};
  const detalles = (erState && Array.isArray(erState.detalles)) ? erState.detalles : [];

  // Regla de Negocio: Origen único de la Fecha = Fecha del Itinerario (tarjeta de operación elegida), bloqueada contra edición
  let fechaItinerario = '';
  if (vuelo && vuelo.FechaItinerado) {
    fechaItinerario = String(vuelo.FechaItinerado instanceof Date ? vuelo.FechaItinerado.toISOString() : vuelo.FechaItinerado).substring(0, 10);
  } else if (comp.Fecha) {
    fechaItinerario = String(comp.Fecha instanceof Date ? comp.Fecha.toISOString() : comp.Fecha).substring(0, 10);
  } else {
    fechaItinerario = new Date().toISOString().substring(0, 10);
  }

  const observacionInicial = comp.Observacion ? String(comp.Observacion).trim() : '';
  const isAmxER = Boolean(formato && formato.id === 'amx-er');
  const nombreCompletoSesion = (user && (user.nombreCompleto || user.usuario))
    ? String(user.nombreCompleto || user.usuario).trim()
    : '';
  const agenteSesion = (user && user.usuario) ? String(user.usuario).trim() : '';
  const agenteActual = (!esNuevo && comp.CreadoPor)
    ? String(comp.CreadoPor).trim()
    : (isAmxER ? nombreCompletoSesion : agenteSesion);
  const agenteSeguridadInspeccion = isAmxER ? nombreCompletoSesion : '';
  const noVueloActivo = (vuelo && vuelo.novuelo) ? String(vuelo.novuelo).trim() : '';
  const destinoActivo = (vuelo && (vuelo.Destino || vuelo.destino)) ? String(vuelo.Destino || vuelo.destino).trim() : '';

  const opUpper = String((vuelo && vuelo.operador) || '').toUpperCase();
  const siglaAgenteSeguridad = opUpper.includes('AEROMEXICO') ? 'AMX'
    : opUpper.includes('DELTA') ? 'DL'
      : opUpper.includes('ARAJET') ? 'ARAJET'
        : opUpper.includes('CANADA') ? 'AC'
          : (opUpper || 'AMX');

  const initialErPayload = {
    formatoId: formato.id,
    formatoNombre: formato.nombre,
    itinerarioId: vuelo.itinerarioId,
    encabezadoId: encabezadoId || null,
    esNuevo: Boolean(esNuevo),
    isAmxER,
    fecha: fechaItinerario,
    noVuelo: noVueloActivo,
    destinoVuelo: destinoActivo,
    agenteActual,
    agenteSeguridadInspeccion,
    siglaAgenteSeguridad,
    observaciones: observacionInicial,
    detalles
  };
%>

<form id="formCapturaER" novalidate>
  <input type="hidden" id="erFormatoId" value="<%= formato.id %>">
  <input type="hidden" id="erItinerarioId" value="<%= vuelo.itinerarioId %>">
  <input type="hidden" id="erEncabezadoId" value="<%= encabezadoId || '' %>">

  <!-- 1. FORMATO Y FECHA (btnFondoFormato_15 + lblFecha_18 + dteFechaFormato_18 en DisplayMode.Disabled) -->
  <div class="card">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-file-alt"></i> FORMATO: <%= formato.nombre %>
      </h3>
      <div class="sio-card-header-meta">
        <% if (!esNuevo && encabezadoId) { %>
          <a href="/formatos/<%= encodeURIComponent(formato.id) %>?nuevo=1" class="btn btn-secondary sio-btn-sm">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Registro
          </a>
        <% } %>
        <span class="badge badge-brand" id="erBadgeEstadoEncabezado">
          <%= (!esNuevo && encabezadoId) ? `REGISTRO CARGADO #${encabezadoId}` : 'NUEVA CAPTURA' %>
        </span>
      </div>
    </div>

    <div class="sio-date-narrow">
      <div class="form-group">
        <label for="erFecha"><i class="far fa-calendar-alt"></i> Fecha: <i class="fas fa-lock input-lock-icon" title="Fecha vinculada al itinerario (Solo lectura)"></i></label>
        <input
          type="date"
          id="erFecha"
          name="fecha"
          class="form-control input-locked er-cell-readonly"
          value="<%= fechaItinerario %>"
          readonly
          disabled
          tabindex="-1"
          aria-readonly="true"
          title="Fecha vinculada estrictamente al itinerario de la operación seleccionada"
        >
      </div>
    </div>
  </div>

  <!-- 2. INGRESE LOS DATOS (Orden exacto 1:1 de ControlEquipajeAVSECAMX: btnFondoDatos_25 + btnFondoDatos1_15 + btnAgregarAMatriz_1 + lblVerDatos_1) -->
  <div class="card sio-card-accent">
    <div class="card-header sio-card-header-flex">
      <h3 class="cp-section-title">
        <i class="fas fa-luggage-cart"></i> Ingrese los Datos:
      </h3>
    </div>

    <!-- Bloque 1 (btnFondoDatos_25): Pasajero, Secuencia, Colilla, NoVuelo, Destino, Hora de Revisión -->
    <div class="sio-grid-auto er-capture-group">
      <!-- 1. Nombre del Pasajero: (txtNamePassenger_5) -->
      <div class="form-group sio-grid-span-2">
        <label for="erInputPasajero">Nombre del Pasajero: <span class="sio-required-star">*</span></label>
        <input
          type="text"
          id="erInputPasajero"
          class="form-control"
          maxlength="200"
          placeholder="Escriba el nombre del pasajero"
          autocomplete="off"
        >
      </div>

      <% if (!formato || formato.id !== 'dl-er') { %>
      <!-- 2. Secuencia: (txtSecuenciaCP) -->
      <div class="form-group" id="erGrupoInputSecuencia">
        <label for="erInputSecuencia">Secuencia: <span class="sio-required-star">*</span></label>
        <input
          type="number"
          id="erInputSecuencia"
          class="form-control"
          min="1"
          step="1"
          inputmode="numeric"
          placeholder="Ingrese la secuencia"
        >
      </div>
      <% } %>

      <!-- 3. Colilla: (txtSecuenciaCP_1) -->
      <div class="form-group">
        <label for="erInputColilla">Colilla: <span class="sio-required-star">*</span></label>
        <input
          type="number"
          id="erInputColilla"
          class="form-control"
          min="1"
          step="1"
          inputmode="numeric"
          placeholder="Ingrese la colilla"
        >
      </div>

      <!-- 4. NoVuelo: (lblNoVuelo_18 + lblNoVuelo1_18 = noVueloIti) -->
      <div class="form-group">
        <label for="erNoVuelo">NoVuelo: <i class="fas fa-lock input-lock-icon" title="Número de vuelo vinculado al itinerario (Solo lectura)"></i></label>
        <input
          type="text"
          id="erNoVuelo"
          class="form-control input-locked er-cell-readonly"
          value="<%= noVueloActivo %>"
          readonly
          disabled
          tabindex="-1"
          aria-readonly="true"
        >
      </div>

      <!-- 5. Destino: (txtSecuenciaCP_2) -->
      <div class="form-group">
        <label for="erInputDestino">Destino:</label>
        <input
          type="text"
          id="erInputDestino"
          class="form-control"
          maxlength="100"
          value=""
          placeholder="Ingrese el destino"
          autocomplete="off"
        >
      </div>

      <!-- 6. Hora de Revisión: (txtHoraRev_14 + icoHoraRev_16) -->
      <div class="form-group">
        <label for="erInputHoraRevision">Hora de Revisión: <span class="sio-required-star">*</span></label>
        <div class="cp-time-row">
          <input
            type="time"
            id="erInputHoraRevision"
            class="form-control"
            placeholder="Ingrese hora de Revisión"
          >
          <button type="button" id="btnRelojHoraER" class="cp-clock-btn" title="Capturar hora actual">
            <i class="far fa-clock"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Bloque 2 (btnFondoDatos1_15): Agente AVSEC y Agente de Seguridad AMX -->
    <div class="sio-grid-auto er-capture-group er-capture-agents">
      <!-- 7. Nombre Agente AVSEC que realiza inspección: (txtNombreAVSEC_1) -->
      <div class="form-group">
        <label for="erInputAgenteAVSEC">Nombre Agente AVSEC que realiza inspección: <span class="sio-required-star">*</span></label>
        <input
          type="text"
          id="erInputAgenteAVSEC"
          class="form-control"
          maxlength="150"
          value=""
          placeholder="Escriba el nombre del Agente"
          autocomplete="off"
        >
      </div>

      <!-- 8. Agente de seguridad AMX durante la inspección: (txtNombreAVSEC_2) -->
      <div class="form-group">
        <label for="erInputAgenteSeguridad">
          Agente de seguridad <%= siglaAgenteSeguridad %> durante la inspección:
          <% if (isAmxER) { %>
            <i class="fas fa-lock input-lock-icon" title="Vinculado al usuario autenticado en sesión (Solo lectura)"></i>
          <% } else { %>
            <span class="sio-required-star">*</span>
          <% } %>
        </label>
        <input
          type="text"
          id="erInputAgenteSeguridad"
          class="form-control <%= isAmxER ? 'input-locked er-cell-readonly' : '' %>"
          maxlength="150"
          value="<%= agenteSeguridadInspeccion %>"
          <%= isAmxER ? 'readonly tabindex="-1" aria-readonly="true"' : 'placeholder="Escriba el nombre del Agente"' %>
          autocomplete="off"
        >
      </div>
    </div>

    <div class="sio-section-actions">
      <button type="button" id="btnAgregarEquipajeER" class="btn btn-primary sio-btn-wide-sm">
        <i class="fas fa-plus-circle"></i> Agregar
      </button>

      <a href="#erCardCuadricula" class="btn btn-secondary" id="btnVerDatosAgregadosER">
        <i class="fas fa-eye"></i> Ver Datos Agregados
        <span class="er-btn-count-badge" id="erVerDatosCount"><%= detalles.length %></span>
      </a>
    </div>
  </div>

  <!-- 3. PASAJEROS / VER DATOS AGREGADOS (grpVerPasajeros: txtBuscadorCP_6 + Icon4_13 + Gallery1_2 ColPasajeros) -->
  <div class="card" id="erCardCuadricula">
    <div class="card-header sio-card-header-flex">
      <div>
        <h3 class="cp-section-title">
          <i class="fas fa-users"></i> PASAJEROS (Ver Datos Agregados)
        </h3>
      </div>

      <div class="sio-search-inline">
        <div class="sio-search-input-wrap">
          <i class="fas fa-search sio-search-icon"></i>
          <input
            type="search"
            id="erBuscarPasajero"
            class="form-control sio-search-input-sm"
            placeholder="Ingrese dato a buscar"
          >
        </div>
        <button type="button" id="btnLimpiarBusquedaER" class="btn btn-secondary sio-btn-sm" title="Reiniciar búsqueda">
          <i class="fas fa-sync-alt"></i>
        </button>
      </div>
    </div>

    <div class="er-fluid-grid-wrapper er-pasajeros-wrapper" id="erGridWrapper">
      <table class="er-fluid-table er-pasajeros-table <%= (formato && formato.id === 'dl-er') ? 'er-table-no-secuencia' : '' %>" id="erTablaCuadricula">
        <thead>
          <tr>
            <th class="er-th-num">No.</th>
            <th class="er-th-pasajero">NOMBRE DEL PASAJERO <span class="er-req-star">*</span></th>
            <% if (!formato || formato.id !== 'dl-er') { %>
            <th class="er-th-secuencia">SECUENCIA <span class="er-req-star">*</span></th>
            <% } %>
            <th class="er-th-colilla">NO. DE COLILLA <span class="er-req-star">*</span></th>
            <th class="er-th-vuelo">No. VUELO</th>
            <th class="er-th-destino">DESTINO</th>
            <th class="er-th-hora">HORA DE REVISIÓN <span class="er-req-star">*</span></th>
            <th class="er-th-avsec">NOMBRE DE AGENTE AVSEC QUE REALIZA LA INSPECCIÓN <span class="er-req-star">*</span></th>
            <th class="er-th-seguridad">AGENTE DE SEGURIDAD <%= siglaAgenteSeguridad %> DURANTE LA INSPECCIÓN <span class="er-req-star">*</span></th>
            <th class="er-th-accion">ACCIÓN</th>
          </tr>
        </thead>
        <tbody id="erTbodyRegistros">
          <!-- Renderizado dinámico por public/js/formato-er.js -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4. FIRMA, NOMBRE DE SEGURIDAD AEROLÍNEA, RECUENTO TOTAL Y OBSERVACIONES (Orden exacto de ControlEquipajeAVSECAMX) -->
  <div class="sio-grid-split">
    <!-- Columna Izquierda: FIRMA: + Nombre de Seguridad Aerolínea: -->
    <div class="card">
      <div class="card-header sio-card-header-flex">
        <h3 class="cp-section-title">
          <i class="fas fa-signature"></i> FIRMA:
          <% if (esNuevo) { %>
            <span class="sio-required-star">*</span>
          <% } %>
        </h3>
        <button type="button" id="btnLimpiarFirmaER" class="btn btn-secondary sio-btn-xs">
          <i class="fas fa-eraser"></i> Limpiar Firma
        </button>
      </div>

      <% if (!esNuevo && encabezadoId) { %>
        <div id="erNoticeFirmaExistente" class="sio-notice-success">
          <i class="fas fa-check-circle"></i>
          <span>Registro #<%= encabezadoId %> ya validado en base de datos. Puede trazar una nueva firma si desea actualizar la Vista Preliminar / PDF.</span>
        </div>
      <% } %>

      <div class="signature-box" id="erSignatureBox">
        <canvas id="erCanvasFirma"></canvas>
      </div>

      <!-- Nombre de Seguridad Aerolínea: (lblNameSeguridadAerolinea_5 + cmbNameSeguridadAerolinea_5 en DisplayMode.View) -->
      <div class="form-group sio-mt-14">
        <label for="erAgenteSeguridadHeader"><i class="fas fa-user-shield"></i> Nombre de Seguridad Aerolínea: <i class="fas fa-lock input-lock-icon" title="Vinculado al usuario autenticado (Solo lectura)"></i></label>
        <input
          type="text"
          id="erAgenteSeguridadHeader"
          class="form-control input-locked er-cell-readonly"
          value="<%= agenteActual %>"
          readonly
          disabled
          tabindex="-1"
          aria-readonly="true"
        >
      </div>
    </div>

    <!-- Columna Derecha: Recuento Total de equipajes revisados: + Observaciones: -->
    <div class="card">
      <div class="card-header sio-card-header-flex">
        <h3 class="cp-section-title"><i class="fas fa-calculator"></i> Recuento y Observaciones</h3>
        <div class="er-total-counter-badge">
          <span>Recuento Total de equipajes revisados:</span>
          <strong id="erRecuentoTotal"><%= detalles.length %></strong>
        </div>
      </div>

      <div class="form-group">
        <label for="erObservaciones">Observaciones:</label>
        <textarea
          id="erObservaciones"
          class="form-control"
          rows="6"
          maxlength="2000"
          placeholder="(Opcional)"
        ><%= observacionInicial %></textarea>
      </div>
    </div>
  </div>

  <!-- 5. BOTONES DE ACCIÓN (Vista Preliminar + Crear Formato) -->
  <div class="sio-bottom-actions">
    <button type="button" id="btnVistaPreliminarER" class="btn btn-secondary sio-btn-action">
      <i class="fas fa-eye"></i> Vista Preliminar
    </button>
    <button type="button" id="btnGuardarDefinitivoER" class="btn btn-primary sio-btn-action-primary">
      <i class="fas fa-save"></i> Crear Formato
    </button>
  </div>
</form>

<script type="application/json" id="erInitialStateJson"><%- JSON.stringify(initialErPayload).replace(/</g, '\\u003c') %></script>
