<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: 'Iniciar Sesión | SIO Formatos SEC LAATS' }) %>
<body style="background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;">

  <div style="
    display: flex;
    width: 100%;
    max-width: 900px;
    min-height: 540px;
    background: var(--surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
    overflow: hidden;
  ">
    <!-- Panel Izquierdo Corporativo LAATS -->
    <div style="
      flex: 1;
      background: linear-gradient(135deg, var(--brand-deep) 0%, var(--brand) 100%);
      padding: 48px 40px;
      color: #FFFFFF;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      border-right: 4px solid var(--gold);
    ">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(212, 175, 55, 0.2); border: 1px solid var(--gold); padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; color: var(--gold); text-transform: uppercase;">
          <i class="fas fa-shield-alt"></i> Seguridad Operacional
        </div>
        <h1 style="color: #FFFFFF; font-size: 32px; margin-top: 16px; font-weight: 800; line-height: 1.2;">
          FORMAT SEC
        </h1>
        <p style="color: #CBD5E1; font-size: 13px; margin-top: 12px; line-height: 1.6;">
          Sistema de información y gestión de formatos de inspección para aeronaves comerciales y de carga.
        </p>
      </div>

      <div style="border-top: 1px solid rgba(255, 255, 255, 0.15); padding-top: 20px;">
        <div style="font-size: 11px; color: var(--gold); font-weight: 600;">PLATAFORMA CORPORATIVA SIO</div>
        <div style="font-size: 13px; font-weight: 700; color: #FFFFFF;">Latin American Airport Technical Services</div>
      </div>
    </div>

    <!-- Panel Derecho Formulario de PIN -->
    <div style="
      flex: 1;
      padding: 50px 45px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background-color: var(--surface);
    ">
      <div style="text-align: center; margin-bottom: 32px;">
        <div style="font-size: 38px; color: var(--brand); margin-bottom: 8px;">
          <i class="fas fa-key"></i>
        </div>
        <h2 style="font-size: 22px; color: var(--brand-deep);">Acceso al Sistema</h2>
        <p style="font-size: 12px; color: var(--text-3); margin-top: 4px;">Ingrese su PIN de usuario asignado</p>
      </div>

      <% if (errorMessage) { %>
        <div style="background-color: var(--danger-light); border-left: 4px solid var(--danger); padding: 12px 16px; border-radius: 4px; margin-bottom: 20px; font-size: 12px; color: var(--danger); font-weight: 600;">
          <i class="fas fa-exclamation-circle"></i> <%= errorMessage %>
        </div>
      <% } %>

      <form id="formLogin" method="POST" action="/login">
        <!-- Campo Honeypot Oculto (Capa 6 de Seguridad Anti-Bots) -->
        <input type="text" name="hp_token_website" style="display:none !important;" tabindex="-1" autocomplete="off">

        <div class="form-group" style="margin-bottom: 24px;">
          <label for="pinInput" style="font-weight: 600; color: var(--text-2); font-size: 13px;">PIN DE ACCESO</label>
          <div style="position: relative;">
            <input 
              type="password" 
              id="pinInput" 
              name="pin" 
              class="form-control" 
              placeholder="••••••••" 
              maxlength="20" 
              required
              autofocus
              style="text-align: center; font-size: 20px; letter-spacing: 4px; height: 50px; font-weight: 700;"
            >
            <button 
              type="button" 
              id="togglePinView" 
              style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-3); cursor: pointer; font-size: 14px;"
            >
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <button type="submit" id="btnLoginSubmit" class="btn btn-primary" style="width: 100%; height: 48px; font-size: 14px; letter-spacing: 0.5px;">
          <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
        </button>
      </form>

      <div style="margin-top: 32px; text-align: center; font-size: 11px; color: var(--text-muted);">
        Versión del Sistema: <span style="font-weight: 700; color: var(--brand);"><%= version %></span><br>
        ¿Problemas para acceder? Comuníquese con Supervisor o IT.
      </div>
    </div>
  </div>

  <script>
    // Visibilidad de PIN
    const toggleBtn = document.getElementById('togglePinView');
    const pinInput = document.getElementById('pinInput');
    if (toggleBtn && pinInput) {
      toggleBtn.addEventListener('click', () => {
        const isPass = pinInput.type === 'password';
        pinInput.type = isPass ? 'text' : 'password';
        toggleBtn.innerHTML = isPass ? '<i class="fas fa-eye-slash"></i>' : '<i class="fas fa-eye"></i>';
      });
    }

    // Manejo de Login Asíncrono con SweetAlert2
    const formLogin = document.getElementById('formLogin');
    formLogin.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pin = pinInput.value.trim();
      const hp = formLogin.querySelector('input[name="hp_token_website"]').value;

      if (!pin) {
        Swal.fire({
          icon: 'warning',
          title: 'PIN Requerido',
          text: 'Por favor ingrese su PIN para continuar.',
          confirmButtonColor: '#275B88'
        });
        return;
      }

      const btn = document.getElementById('btnLoginSubmit');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Validando credenciales...';

      try {
        const response = await fetch('/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ pin, hp_token_website: hp })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: '¡SESIÓN EXITOSA!',
            text: 'Bienvenido a SIO Formatos SEC.',
            showConfirmButton: false,
            timer: 1200
          }).then(() => {
            window.location.href = data.redirectUrl || '/operaciones';
          });
        } else {
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Iniciar Sesión';
          Swal.fire({
            icon: 'error',
            title: 'Acceso Denegado',
            text: data.message || 'Credenciales inválidas.',
            confirmButtonColor: '#275B88'
          });
        }
      } catch (err) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Iniciar Sesión';
        Swal.fire({
          icon: 'error',
          title: 'Error de Servidor',
          text: 'No se pudo comunicar con el servidor.',
          confirmButtonColor: '#275B88'
        });
      }
    });
  </script>
</body>
</html>
