<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: 'Iniciar Sesión | SIO Formatos SEC - SQL LAATS' }) %>
<style>
  /* Estilos Autónomos de Alta Prioridad para la Pantalla de Login (Web & Móvil) */
  .login-body {
    background: #F4F7FB;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    margin: 0;
    box-sizing: border-box;
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  [data-theme="dark"] .login-body,
  body.dark-mode.login-body {
    background: #0B192C;
  }

  .login-wrapper {
    width: 100%;
    max-width: 880px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-card {
    display: flex;
    flex-direction: row;
    width: 100%;
    background: #FFFFFF;
    border-radius: 16px;
    box-shadow: 0 15px 35px rgba(15, 39, 68, 0.12);
    border: 1px solid rgba(15, 39, 68, 0.08);
    overflow: hidden;
  }

  [data-theme="dark"] .login-card,
  body.dark-mode .login-card {
    background: #132238;
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
  }

  /* Panel Izquierdo Corporativo */
  .login-brand-panel {
    flex: 1.1;
    background: linear-gradient(135deg, #0F2744 0%, #1A3E66 50%, #275B88 100%);
    padding: 48px 40px;
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    border-right: 4px solid #D4AF37;
  }

  .login-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(212, 175, 55, 0.2);
    border: 1px solid #D4AF37;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    color: #D4AF37;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .login-brand-title {
    color: #FFFFFF;
    font-size: 30px;
    margin-top: 18px;
    margin-bottom: 0;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .login-brand-desc {
    color: #CBD5E1;
    font-size: 13px;
    margin-top: 12px;
    line-height: 1.6;
    margin-bottom: 0;
  }

  .login-brand-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 20px;
    margin-top: 32px;
  }

  .login-brand-platform {
    font-size: 11px;
    color: #D4AF37;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .login-brand-company {
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
    margin-top: 2px;
    letter-spacing: 0.2px;
  }

  /* Panel Derecho Formulario */
  .login-form-panel {
    flex: 1;
    padding: 48px 42px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: #FFFFFF;
  }

  [data-theme="dark"] .login-form-panel,
  body.dark-mode .login-form-panel {
    background-color: #132238;
  }

  .login-form-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .login-key-icon {
    font-size: 38px;
    color: #275B88;
    margin-bottom: 8px;
  }

  [data-theme="dark"] .login-key-icon,
  body.dark-mode .login-key-icon {
    color: #D4AF37;
  }

  .login-form-title {
    font-size: 22px;
    color: #0F2744;
    font-weight: 700;
    margin: 0;
  }

  [data-theme="dark"] .login-form-title,
  body.dark-mode .login-form-title {
    color: #FFFFFF;
  }

  .login-form-subtitle {
    font-size: 12px;
    color: #64748B;
    margin-top: 4px;
    margin-bottom: 0;
  }

  [data-theme="dark"] .login-form-subtitle,
  body.dark-mode .login-form-subtitle {
    color: #94A3B8;
  }

  .login-error-alert {
    background-color: #FEE2E2;
    border-left: 4px solid #DC2626;
    border-radius: 4px;
    padding: 12px 16px;
    margin-bottom: 20px;
    font-size: 12px;
    color: #DC2626;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .login-form-group {
    margin-bottom: 24px;
  }

  .login-label {
    font-weight: 700;
    color: #334155;
    font-size: 12px;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    display: block;
    text-align: left;
  }

  [data-theme="dark"] .login-label,
  body.dark-mode .login-label {
    color: #CBD5E1;
  }

  .login-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .login-input {
    text-align: center;
    font-size: 20px;
    letter-spacing: 4px;
    height: 50px;
    font-weight: 700;
    border-radius: 8px;
    border: 1.5px solid #CBD5E1;
    background-color: #FFFFFF;
    color: #0F2744;
    padding: 0 44px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  [data-theme="dark"] .login-input,
  body.dark-mode .login-input {
    background-color: #0B192C;
    border-color: #275B88;
    color: #FFFFFF;
  }

  .login-input:focus {
    border-color: #275B88;
    box-shadow: 0 0 0 3px rgba(39, 91, 136, 0.18);
    outline: none;
  }

  [data-theme="dark"] .login-input:focus,
  body.dark-mode .login-input:focus {
    border-color: #D4AF37;
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
  }

  .login-toggle-pin {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #64748B;
    cursor: pointer;
    font-size: 15px;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .login-toggle-pin:hover {
    color: #275B88;
  }

  [data-theme="dark"] .login-toggle-pin:hover,
  body.dark-mode .login-toggle-pin:hover {
    color: #D4AF37;
  }

  .login-submit-btn {
    width: 100%;
    height: 48px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 8px;
    background: linear-gradient(135deg, #0F2744 0%, #275B88 100%);
    color: #FFFFFF;
    border: none;
    box-shadow: 0 4px 12px rgba(15, 39, 68, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  }

  .login-submit-btn:hover {
    opacity: 0.95;
    box-shadow: 0 6px 16px rgba(15, 39, 68, 0.28);
  }

  .login-submit-btn:active {
    transform: scale(0.99);
  }

  /* Adaptación Responsiva para Móvil (Mismo diseño y colores corporativos) */
  @media (max-width: 768px) {
    .login-body {
      padding: 16px;
      align-items: center;
    }

    .login-wrapper {
      max-width: 440px;
      margin: auto;
    }

    .login-card {
      flex-direction: column;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(15, 39, 68, 0.16);
    }

    .login-brand-panel {
      border-right: none;
      border-bottom: 4px solid #D4AF37;
      padding: 26px 20px;
      text-align: center;
      background: linear-gradient(135deg, #0F2744 0%, #1A3E66 50%, #275B88 100%);
    }

    .login-badge {
      margin: 0 auto;
    }

    .login-brand-title {
      font-size: 22px;
      margin-top: 10px;
    }

    .login-brand-desc {
      font-size: 12px;
      margin-top: 6px;
      line-height: 1.5;
    }

    .login-brand-footer {
      display: block;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 12px;
      margin-top: 16px;
    }

    .login-brand-platform {
      font-size: 10px;
    }

    .login-brand-company {
      font-size: 11px;
    }

    .login-form-panel {
      padding: 28px 22px;
    }

    .login-form-header {
      margin-bottom: 20px;
    }

    .login-key-icon {
      font-size: 32px;
      margin-bottom: 6px;
    }

    .login-form-title {
      font-size: 20px;
    }

    .login-input {
      height: 48px;
      font-size: 18px;
      letter-spacing: 4px;
    }

    .login-submit-btn {
      height: 48px;
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .login-body {
      padding: 10px;
    }

    .login-brand-panel {
      padding: 22px 16px;
    }

    .login-brand-title {
      font-size: 20px;
    }

    .login-form-panel {
      padding: 24px 18px;
    }

    .login-input {
      letter-spacing: 3px;
      padding: 0 38px;
    }
  }
</style>
<body class="login-body">

  <div class="login-wrapper">
    <div class="login-card">
      <!-- Panel Izquierdo / Superior Corporativo LAATS -->
      <div class="login-brand-panel">
        <div>
          <div class="login-badge">
            <i class="fas fa-shield-alt"></i> Seguridad Operacional
          </div>
          <h1 class="login-brand-title">
            FORMATOS SEC - SQL
          </h1>
          <p class="login-brand-desc">
            Sistema de información y gestión de formatos de inspección para aeronaves comerciales y de carga.
          </p>
        </div>

        <div class="login-brand-footer">
          <div class="login-brand-platform">PLATAFORMA CORPORATIVA SIO</div>
          <div class="login-brand-company">Latin American Airport Technical Services</div>
        </div>
      </div>

      <!-- Panel Derecho / Inferior Formulario de PIN -->
      <div class="login-form-panel">
        <div class="login-form-header">
          <div class="login-key-icon">
            <i class="fas fa-key"></i>
          </div>
          <h2 class="login-form-title">Acceso al Sistema</h2>
          <p class="login-form-subtitle">Ingrese su PIN de usuario asignado</p>
        </div>

        <% if (errorMessage) { %>
          <div class="login-error-alert" role="alert">
            <i class="fas fa-exclamation-circle"></i> <%= errorMessage %>
          </div>
        <% } %>

        <form id="formLogin" method="POST" action="/login">
          <div class="form-group login-form-group">
            <label for="pinInput" class="login-label">PIN DE ACCESO</label>
            <div class="login-input-wrap">
              <input 
                type="password" 
                id="pinInput" 
                name="pin" 
                class="form-control login-input" 
                placeholder="••••••••" 
                maxlength="20" 
                required
                autofocus
                autocomplete="current-password"
                inputmode="numeric"
              >
              <button 
                type="button" 
                id="togglePinView" 
                class="login-toggle-pin"
                aria-label="Mostrar u ocultar PIN"
              >
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- Campo Honeypot Oculto anti-bots posicionado después del password para evitar autofill -->
          <input type="text" name="hp_token_website" style="display:none !important; position:absolute !important; left:-9999px !important; width:0 !important; height:0 !important; opacity:0 !important; visibility:hidden !important; pointer-events:none !important;" tabindex="-1" autocomplete="off" aria-hidden="true">

          <button type="submit" id="btnLoginSubmit" class="btn btn-primary login-submit-btn">
            <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Pantalla Global de Carga Corporativa LAATS -->
  <div id="sioLoadingOverlay" class="sio-loading-overlay" role="status" aria-live="polite" aria-hidden="true">
    <div class="sio-loading-card">
      <div class="sio-spinner-wrap">
        <div class="sio-spinner-ring"></div>
        <i class="fas fa-shield-alt sio-spinner-icon"></i>
      </div>
      <div id="sioLoadingTitle" class="sio-loading-title">Validando Credenciales...</div>
      <div id="sioLoadingSubtitle" class="sio-loading-subtitle">Verificando PIN y perfil SEC en Azure SQL Server...</div>
    </div>
  </div>

  <script src="/js/login.js?v=1.0.12"></script>
</body>
</html>
