<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: title }) %>
<body>
  <div class="app-container app-container-full">
    <div class="workspace workspace-full">
      <main class="content-body content-body-operaciones">
        <!-- Banner de Contexto de Vuelo Seleccionado -->
        <div class="flight-context-banner">
          <div class="flight-context-info">
            <div class="flight-context-eyebrow">
              <i class="fas fa-shield-alt"></i> OPERACIÓN ACTIVA — FORMATOS SEC
            </div>
            <h1 class="flight-context-title">
              <%= vuelo.operador %> — Vuelo <%= vuelo.novuelo %>
            </h1>
            <div class="flight-context-tags">
              <span class="flight-tag">Correlativo: #<%= vuelo.nocorrelativo %></span>
              <span class="flight-tag">Ruta: <%= vuelo.Procedencia %> ➔ <%= vuelo.Destino %></span>
              <span class="flight-tag">Matrícula: <%= vuelo.Matricula || 'Pendiente' %></span>
              <span class="flight-tag">Puerta: <%= vuelo.puertaposicion || '--' %></span>
            </div>
          </div>
          <div class="flight-context-actions">
            <a href="/operaciones" class="btn btn-change-flight">
              <i class="fas fa-exchange-alt"></i> Cambiar Operación
            </a>
          </div>
        </div>

        <div class="formatos-section-header">
          <div>
            <h2 class="formatos-section-title">Formatos Disponibles para <%= vuelo.operador %></h2>
            <p class="formatos-section-subtitle">Seleccione un formato de inspección para diligenciar o auditar.</p>
          </div>
          <span class="badge badge-gold">
            Rol Activo: <%= user.puestoSec %>
          </span>
        </div>

        <!-- Grid de Formatos -->
        <div id="formatsGrid" class="formats-grid">
          <% if (formatos && formatos.length > 0) { %>
            <% formatos.forEach(fmt => { %>
              <div class="format-card" data-formato-id="<%= fmt.id %>" data-formato-nombre="<%= fmt.nombre %>" data-itinerario-id="<%= vuelo.itinerarioId %>">
                <div>
                  <div class="format-card-icon">
                    <i class="fas fa-<%= fmt.icono || 'file-signature' %>"></i>
                  </div>
                  <h4><%= fmt.nombre %></h4>
                  <p>Inspección y registro oficial de seguridad en rampa y operaciones para <%= fmt.aerolinea %>.</p>
                </div>

                <div class="format-card-footer">
                  <span class="format-card-permiso">
                    Permiso: <%= fmt.rangos.join(', ') %>
                  </span>
                  <button type="button" class="btn btn-primary format-card-btn">
                    <i class="fas fa-pencil-alt"></i> Diligenciar
                  </button>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="op-empty-state">
              <i class="fas fa-lock fa-3x op-empty-icon-muted"></i>
              <h3 class="op-empty-title">Sin formatos autorizados</h3>
              <p class="op-empty-desc">Su usuario (<%= user.puestoSec %>) no cuenta con formatos asignados para <%= vuelo.operador %>.</p>
            </div>
          <% } %>
        </div>
      </main>

      <%- include('partials/tab-bar', { activeTab: 'formatos', user: user, vueloActivo: vuelo }) %>
      <%- include('partials/footer') %>
    </div>
  </div>

  <!-- Modal: FORMATOS EXISTENTES (Reanudar vs Crear Nuevo) -->
  <div id="modalReanudar" class="modal-overlay">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-eyebrow">
          DOCUMENTOS PREVIOS DETECTADOS
        </div>
        <h3 id="modalFormatoNombre">Formatos Existentes</h3>
      </div>
      <div class="modal-body">
        <p class="modal-desc">
          Se han encontrado registros previos para este vuelo. ¿Desea <strong>reanudar</strong> uno de los formatos seleccionándolo de la lista, o prefiere <strong>crear uno nuevo</strong>?
        </p>

        <div id="listaFormatosExistentes">
          <!-- Inyectado dinámicamente vía app.js -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" id="btnCancelarModalReanudar" class="btn btn-secondary">Cancelar</button>
        <button type="button" id="btnCrearNuevoFormato" class="btn btn-gold">
          <i class="fas fa-plus-circle"></i> Crear Nuevo
        </button>
      </div>
    </div>
  </div>
</body>
</html>
