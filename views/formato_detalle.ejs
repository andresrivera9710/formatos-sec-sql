<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: title }) %>
<body>
  <div class="app-container app-container-full">
    <div class="workspace workspace-full">
      <main class="content-body content-body-operaciones">
        <!-- Navegación Superior y Título del Formato -->
        <div class="fmt-top-nav">
          <div class="fmt-top-nav-left">
            <a href="/formatos" class="btn btn-secondary">
              <i class="fas fa-arrow-left"></i> Volver a Formatos
            </a>
            <h1 class="fmt-page-title"><%= formato.nombre %></h1>
          </div>

          <div>
            <span class="badge <%= esNuevo ? 'badge-success' : 'badge-gold' %>" id="sioFormatoModeBadge">
              <%= esNuevo ? 'MODO: NUEVO REGISTRO' : `MODO: REANUDANDO BORRADOR #${encabezadoId}` %>
            </span>
          </div>
        </div>

        <!-- Encabezado de Vuelo de Referencia -->
        <div class="card fmt-flight-ref-card">
          <div class="fmt-ref-grid">
            <div>
              <span class="fmt-ref-label">Aerolínea / Operador</span>
              <strong class="fmt-ref-operador"><%= vuelo.operador %></strong>
            </div>
            <div>
              <span class="fmt-ref-label">No. Vuelo</span>
              <strong class="fmt-ref-vuelo"><%= vuelo.novuelo %></strong>
            </div>
            <div>
              <span class="fmt-ref-label">Correlativo</span>
              <strong class="fmt-ref-correlativo">#<%= vuelo.nocorrelativo %></strong>
            </div>
            <div>
              <span class="fmt-ref-label">Ruta</span>
              <strong class="fmt-ref-val"><%= vuelo.Procedencia %> ➔ <%= vuelo.Destino %></strong>
            </div>
            <div>
              <span class="fmt-ref-label">Matrícula</span>
              <strong class="fmt-ref-val"><%= vuelo.Matricula || 'Pendiente' %></strong>
            </div>
          </div>
        </div>

        <% if (formato && formato.id && formato.id.endsWith('-cp')) { %>
          <%- include('partials/formato_cp') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-er')) { %>
          <%- include('partials/formato_er') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-eb')) { %>
          <%- include('partials/formato_eb') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-cec')) { %>
          <%- include('partials/formato_cec') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-ciec')) { %>
          <%- include('partials/formato_ciec') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-mecd')) { %>
          <%- include('partials/formato_mecd') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-po')) { %>
          <%- include('partials/formato_po') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-cfr')) { %>
          <%- include('partials/formato_cfr') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-rx')) { %>
          <%- include('partials/formato_rx') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-cll')) { %>
          <%- include('partials/formato_cll') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-sp')) { %>
          <%- include('partials/formato_sp') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-dal')) { %>
          <%- include('partials/formato_dal') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-sel')) { %>
          <%- include('partials/formato_sel') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-ass')) { %>
          <%- include('partials/formato_ass') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-anexoa')) { %>
          <%- include('partials/formato_anexoa') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-anexob')) { %>
          <%- include('partials/formato_anexob') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-liadc')) { %>
          <%- include('partials/formato_liadc') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-ccda')) { %>
          <%- include('partials/formato_ccda') %>
        <% } else if (formato && formato.id && formato.id.endsWith('-lisa')) { %>
          <%- include('partials/formato_lisa') %>
        <% } else { %>
        <!-- Formulario de Inspección de Seguridad -->
        <form id="formCapturaFormato">
          <input type="hidden" name="formatoId" value="<%= formato.id %>">
          <input type="hidden" name="itinerarioId" value="<%= vuelo.itinerarioId %>">
          <input type="hidden" name="encabezadoId" value="<%= encabezadoId || '' %>">

          <div class="card">
            <div class="card-header">
              <h3 class="cp-section-title"><i class="fas fa-clipboard-check"></i> Datos Generales de la Inspección</h3>
            </div>

            <div class="fmt-form-grid">
              <div class="form-group">
                <label for="campoFecha"><i class="far fa-calendar-alt"></i> Fecha de Inspección</label>
                <input type="date" id="campoFecha" name="fecha" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
              </div>

              <div class="form-group">
                <label for="campoAgente"><i class="fas fa-user-shield"></i> Agente Responsable</label>
                <input type="text" id="campoAgente" name="agente" class="form-control" value="<%= user.usuario || user.nombreCompleto %>" readonly>
              </div>

              <div class="form-group">
                <label for="campoSupervisor"><i class="fas fa-user-tie"></i> Supervisor de Turno (LoginSEC)</label>
                <select id="campoSupervisor" name="supervisor" class="form-control" required>
                  <option value="">-- Seleccione el Supervisor --</option>
                  <% (supervisores || []).forEach(sup => { %>
                    <option value="<%= sup.Usuario %>"><%= sup.Usuario %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label for="campoHoraInicio"><i class="far fa-clock"></i> Hora Inicio</label>
                <input type="time" id="campoHoraInicio" name="horaInicio" class="form-control" required>
              </div>

              <div class="form-group">
                <label for="campoHoraFin"><i class="far fa-clock"></i> Hora Fin</label>
                <input type="time" id="campoHoraFin" name="horaFin" class="form-control">
              </div>
            </div>
          </div>

          <!-- Sección de Parámetros Específicos -->
          <div class="card">
            <div class="card-header">
              <h3 class="cp-section-title"><i class="fas fa-tasks"></i> Parámetros Operativos del Formato</h3>
            </div>

            <div class="fmt-form-grid">
              <div class="form-group">
                <label for="campoUbicacion"><i class="fas fa-map-marker-alt"></i> Posición / Puerta</label>
                <input type="text" id="campoUbicacion" name="posicion" class="form-control" value="<%= vuelo.puertaposicion || 'Posición Rampa' %>">
              </div>

              <div class="form-group">
                <label for="campoUnidad"><i class="fas fa-truck"></i> No. Unidad / Equipo</label>
                <input type="text" id="campoUnidad" name="noUnidad" class="form-control" placeholder="Ej: UNIDAD-12">
              </div>

              <div class="form-group">
                <label for="campoEstadoInspeccion"><i class="fas fa-check-double"></i> Resultado de Inspección</label>
                <select id="campoEstadoInspeccion" name="resultado" class="form-control">
                  <option value="CONFORME">CONFORME (Sin Novedad)</option>
                  <option value="CON_NOVEDAD">CON NOVEDAD (Registrar en observaciones)</option>
                  <option value="OBSERVADO">OBSERVADO / EN PROCESO</option>
                </select>
              </div>
            </div>

            <div class="form-group fmt-obs-group">
              <label for="campoObservaciones"><i class="fas fa-comment-alt"></i> Observaciones Detalladas y Novedades</label>
              <textarea id="campoObservaciones" name="observaciones" rows="3" class="form-control" placeholder="Ingrese las novedades encontradas durante la inspección o verificación..."></textarea>
            </div>
          </div>

          <!-- Firma Digital de Auditoría -->
          <div class="card">
            <div class="card-header">
              <h3 class="cp-section-title"><i class="fas fa-pen-nib"></i> Firma Digital del Agente / Supervisor</h3>
              <button type="button" id="btnLimpiarFirma" class="btn btn-secondary fmt-clear-sig-btn">
                <i class="fas fa-eraser"></i> Limpiar Firma
              </button>
            </div>

            <div class="signature-box">
              <canvas id="canvasFirma"></canvas>
            </div>
            <p class="fmt-sig-caption">Dibuje su firma en el recuadro superior para avalar la inspección digital.</p>
          </div>

          <!-- Botones de Acción -->
          <div class="fmt-bottom-actions">
            <button type="button" id="btnVistaPreliminar" class="btn btn-secondary fmt-action-btn">
              <i class="fas fa-eye"></i> Vista Preliminar (Auditoría)
            </button>
            <button type="button" id="btnGuardarDefinitivo" class="btn btn-primary fmt-action-btn">
              <i class="fas fa-save"></i> Guardar Definitivo
            </button>
          </div>
        </form>
        <% } %>
      </main>

      <script type="application/json" id="sioFirmasRepoStateJson"><%- JSON.stringify(typeof firmasRepo !== 'undefined' ? firmasRepo : null).replace(/</g, '\\u003c') %></script>
      <script type="application/json" id="sioOfflineContextJson"><%- JSON.stringify({
        formatoId: formato ? formato.id : '',
        formatoNombre: formato ? formato.nombre : '',
        cliente: vuelo ? (vuelo.operador || '') : '',
        itinerarioId: vuelo ? (vuelo.itinerarioId || 0) : 0,
        correlativo: vuelo ? String(vuelo.nocorrelativo || vuelo.itinerarioId || '') : '',
        encabezadoId: typeof encabezadoId !== 'undefined' && encabezadoId ? encabezadoId : null,
        esNuevo: Boolean(esNuevo),
        vuelo: vuelo || {},
        user: user ? {
          usuario: user.usuario || user.nombreCompleto || '',
          nombreCompleto: user.nombreCompleto || user.usuario || '',
          puestoSec: user.puestoSec || ''
        } : {}
      }).replace(/</g, '\\u003c') %></script>
      <%- include('partials/tab-bar', { activeTab: 'formatos', user: user, vueloActivo: vuelo }) %>
      <%- include('partials/footer') %>
    </div>
  </div>

  <script src="/js/formato-validator.js?v=1.0.28"></script>
  <script src="/js/baggage-matrix.js?v=1.0.28"></script>
  <% if (formato && formato.id && formato.id.endsWith('-cp')) { %>
    <script src="/js/formato-cp.js?v=1.0.29"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-er')) { %>
    <script src="/js/formato-er.js?v=1.0.28"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-eb')) { %>
    <script src="/js/formato-eb.js?v=1.0.28"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-cec')) { %>
    <script src="/js/formato-cec.js?v=1.0.28"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-ciec')) { %>
    <script src="/js/formato-ciec.js?v=1.0.29"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-mecd')) { %>
    <script src="/js/formato-mecd.js?v=1.0.24"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-po')) { %>
    <script src="/js/formato-po.js?v=1.0.24"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-cfr')) { %>
    <script src="/js/formato-cfr.js?v=1.0.29"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-rx')) { %>
    <script src="/js/formato-rx.js?v=1.0.28"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-cll')) { %>
    <script src="/js/formato-cll.js?v=1.0.28"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-sp')) { %>
    <script src="/js/formato-sp.js?v=1.0.28"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-dal')) { %>
    <script src="/js/formato-dal.js?v=1.0.28"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-sel')) { %>
    <script src="/js/formato-sel.js?v=1.0.28"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-ass')) { %>
    <script src="/js/formato-ass.js?v=1.0.21"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-anexoa')) { %>
    <script src="/js/formato-anexoa.js?v=1.0.21"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-anexob')) { %>
    <script src="/js/formato-anexob.js?v=1.0.21"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-liadc')) { %>
    <script src="/js/formato-liadc.js?v=1.0.21"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-ccda')) { %>
    <script src="/js/formato-ccda.js?v=1.0.21"></script>
  <% } else if (formato && formato.id && formato.id.endsWith('-lisa')) { %>
    <script src="/js/formato-lisa.js?v=1.0.21"></script>
  <% } else { %>
    <script src="/js/formato-detalle.js?v=1.0.21"></script>
  <% } %>
</body>
</html>
