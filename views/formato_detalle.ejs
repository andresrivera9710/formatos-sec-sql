<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: title }) %>
<body>
  <div class="app-container">
    <%- include('partials/sidebar', { activeTab: 'formatos', currentUser: user }) %>

    <div class="workspace">
      <%- include('partials/header', { pageTitle: formato.nombre, vueloActivo: vuelo }) %>

      <main class="content-body">
        <!-- Navegación y Retorno -->
        <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
          <a href="/formatos" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver a Formatos
          </a>

          <div>
            <span class="badge <%= esNuevo ? 'badge-success' : 'badge-gold' %>">
              <%= esNuevo ? 'MODO: NUEVO REGISTRO' : `MODO: REANUDANDO BORRADOR #${encabezadoId}` %>
            </span>
          </div>
        </div>

        <!-- Encabezado de Vuelo de Referencia -->
        <div class="card" style="border-left: 4px solid var(--brand);">
          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; font-size: 12px;">
            <div>
              <span style="color: var(--text-3); display: block; font-size: 11px; text-transform: uppercase;">Aerolínea / Operador</span>
              <strong style="font-size: 16px; color: var(--brand-deep);"><%= vuelo.operador %></strong>
            </div>
            <div>
              <span style="color: var(--text-3); display: block; font-size: 11px; text-transform: uppercase;">No. Vuelo</span>
              <strong style="font-size: 16px; color: var(--brand);"><%= vuelo.novuelo %></strong>
            </div>
            <div>
              <span style="color: var(--text-3); display: block; font-size: 11px; text-transform: uppercase;">Correlativo</span>
              <strong style="font-size: 16px; color: var(--danger);">#<%= vuelo.nocorrelativo %></strong>
            </div>
            <div>
              <span style="color: var(--text-3); display: block; font-size: 11px; text-transform: uppercase;">Ruta</span>
              <strong style="font-size: 15px;"><%= vuelo.Procedencia %> ➔ <%= vuelo.Destino %></strong>
            </div>
            <div>
              <span style="color: var(--text-3); display: block; font-size: 11px; text-transform: uppercase;">Matrícula</span>
              <strong style="font-size: 15px;"><%= vuelo.Matricula || 'Pendiente' %></strong>
            </div>
          </div>
        </div>

        <!-- Formulario de Inspección de Seguridad -->
        <form id="formCapturaFormato">
          <input type="hidden" name="formatoId" value="<%= formato.id %>">
          <input type="hidden" name="itinerarioId" value="<%= vuelo.itinerarioId %>">
          <input type="hidden" name="encabezadoId" value="<%= encabezadoId || '' %>">

          <div class="card">
            <div class="card-header">
              <h3 style="font-size: 15px;"><i class="fas fa-clipboard-check"></i> Datos Generales de la Inspección</h3>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
              <div class="form-group">
                <label for="campoFecha"><i class="far fa-calendar-alt"></i> Fecha de Inspección</label>
                <input type="date" id="campoFecha" name="fecha" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
              </div>

              <div class="form-group">
                <label for="campoAgente"><i class="fas fa-user-shield"></i> Agente Responsable</label>
                <input type="text" id="campoAgente" name="agente" class="form-control" value="<%= user.nombreCompleto %>" readonly>
              </div>

              <div class="form-group">
                <label for="campoSupervisor"><i class="fas fa-user-tie"></i> Supervisor de Turno</label>
                <input type="text" id="campoSupervisor" name="supervisor" class="form-control" placeholder="Nombre del Supervisor" required>
              </div>

              <div class="form-group">
                <label for="campoHoraInicio"><i class="far fa-clock"></i> Hora Inicio</label>
                <input type="time" id="campoHoraInicio" name="horaInicio" class="form-control" required>
              </div>

              <div class="form-group">
                <label for="campoHoraFin"><i class="far fa-clock"></i> Hora Fin</label>
                <input type="time" id="campoHoraFin" name="horaFin" class="form-control">
              </div>
            </div>
          </div>

          <!-- Sección de Parámetros Específicos -->
          <div class="card">
            <div class="card-header">
              <h3 style="font-size: 15px;"><i class="fas fa-tasks"></i> Parámetros Operativos del Formato</h3>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
              <div class="form-group">
                <label for="campoUbicacion"><i class="fas fa-map-marker-alt"></i> Posición / Puerta</label>
                <input type="text" id="campoUbicacion" name="posicion" class="form-control" value="<%= vuelo.puertaposicion || 'Posición Rampa' %>">
              </div>

              <div class="form-group">
                <label for="campoUnidad"><i class="fas fa-truck"></i> No. Unidad / Equipo</label>
                <input type="text" id="campoUnidad" name="noUnidad" class="form-control" placeholder="Ej: UNIDAD-12">
              </div>

              <div class="form-group">
                <label for="campoEstadoInspeccion"><i class="fas fa-check-double"></i> Resultado de Inspección</label>
                <select id="campoEstadoInspeccion" name="resultado" class="form-control">
                  <option value="CONFORME">CONFORME (Sin Novedad)</option>
                  <option value="CON_NOVEDAD">CON NOVEDAD (Registrar en observaciones)</option>
                  <option value="OBSERVADO">OBSERVADO / EN PROCESO</option>
                </select>
              </div>
            </div>

            <div class="form-group" style="margin-top: 16px;">
              <label for="campoObservaciones"><i class="fas fa-comment-alt"></i> Observaciones Detalladas y Novedades</label>
              <textarea id="campoObservaciones" name="observaciones" rows="3" class="form-control" placeholder="Ingrese las novedades encontradas durante la inspección o verificación..."></textarea>
            </div>
          </div>

          <!-- Firma Digital de Auditoría -->
          <div class="card">
            <div class="card-header">
              <h3 style="font-size: 15px;"><i class="fas fa-pen-nib"></i> Firma Digital del Agente / Supervisor</h3>
              <button type="button" class="btn btn-secondary" style="padding: 4px 10px; font-size: 11px;" onclick="limpiarFirma()">
                <i class="fas fa-eraser"></i> Limpiar Firma
              </button>
            </div>

            <div class="signature-box">
              <canvas id="canvasFirma"></canvas>
            </div>
            <p style="font-size: 11px; color: var(--text-3); text-align: center;">Dibuje su firma en el recuadro superior para avalar la inspección digital.</p>
          </div>

          <!-- Botones de Acción -->
          <div style="display: flex; justify-content: flex-end; gap: 14px; margin-bottom: 40px;">
            <button type="button" class="btn btn-secondary" onclick="procesarFormato(false)" style="padding: 12px 24px;">
              <i class="fas fa-eye"></i> Vista Preliminar (Auditoría)
            </button>
            <button type="button" class="btn btn-primary" onclick="procesarFormato(true)" style="padding: 12px 28px;">
              <i class="fas fa-save"></i> Guardar Definitivo
            </button>
          </div>
        </form>
      </main>

      <%- include('partials/footer') %>
    </div>
  </div>

  <script>
    let sigPad;
    window.addEventListener('load', () => {
      const canvas = document.getElementById('canvasFirma');
      if (canvas && window.SioSignaturePad) {
        sigPad = new SioSignaturePad(canvas);
      }
    });

    function limpiarFirma() {
      if (sigPad) sigPad.clear();
    }

    async function procesarFormato(guardar) {
      const form = document.getElementById('formCapturaFormato');
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      payload.guardar = guardar;
      payload.datos = {
        fecha: payload.fecha,
        agente: payload.agente,
        supervisor: payload.supervisor,
        horaInicio: payload.horaInicio,
        horaFin: payload.horaFin,
        posicion: payload.posicion,
        noUnidad: payload.noUnidad,
        resultado: payload.resultado,
        observaciones: payload.observaciones,
        firma: (sigPad && !sigPad.isEmpty()) ? sigPad.toDataURL() : null
      };

      Swal.fire({
        title: guardar ? 'Guardando Formato...' : 'Generando Auditoría Preliminar...',
        text: 'Por favor espere un momento.',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      try {
        const response = await fetch('/api/formatos/procesar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const res = await response.json();

        if (res.success) {
          if (!guardar) {
            Swal.fire({
              icon: 'info',
              title: 'Vista Preliminar Aprobada',
              html: `
                <div style="text-align: left; font-size: 13px;">
                  <p><strong>Formato:</strong> ${res.resumen.formato}</p>
                  <p><strong>Aerolínea:</strong> ${res.resumen.aerolinea}</p>
                  <p><strong>Resultado:</strong> ${payload.datos.resultado}</p>
                  <p><strong>Supervisor:</strong> ${payload.datos.supervisor}</p>
                  <p style="margin-top: 10px; color: var(--success); font-weight: 700;">El formato cumple las validaciones de negocio en memoria.</p>
                </div>
              `,
              confirmButtonColor: '#275B88'
            });
          } else {
            Swal.fire({
              icon: 'success',
              title: '¡Guardado Exitoso!',
              text: res.mensaje || 'Formato registrado con éxito en la base de datos.',
              confirmButtonColor: '#275B88'
            }).then(() => {
              window.location.href = '/formatos';
            });
          }
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error de Validación',
            text: res.message || 'No se pudo guardar el formato.'
          });
        }
      } catch (err) {
        Swal.fire({
          icon: 'error',
          title: 'Error de Red',
          text: 'Fallo al comunicar con el servidor.'
        });
      }
    }
  </script>
</body>
</html>

