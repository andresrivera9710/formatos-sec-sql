<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: 'Tarjetas de Operaciones | SIO Formatos SEC' }) %>
<body>
  <div class="app-container app-container-full">
    <div class="workspace workspace-full">
      <main class="content-body content-body-operaciones">
        <!-- Encabezado Corporativo Simétrico -->
        <header class="op-hero-header">
          <div class="op-hero-brand">
            <div class="op-hero-emblem" aria-hidden="true">
              <i class="fas fa-shield-alt"></i>
            </div>
            <div>
              <div class="op-hero-eyebrow">SIO — LAATS • Seguridad Operacional (SEC)</div>
              <h1 class="op-hero-title">Tarjetas de Operaciones</h1>
            </div>
          </div>

          <% if (typeof vueloActivo !== 'undefined' && vueloActivo) { %>
            <div class="op-hero-meta">
              <a href="/formatos" class="op-active-flight-pill" title="Ir a los formatos del vuelo activo">
                <i class="fas fa-plane"></i>
                <span><%= vueloActivo.operador %> (<%= vueloActivo.novuelo %>) | Matrícula: <%= vueloActivo.Matricula || 'S/N' %></span>
              </a>
            </div>
          <% } %>
        </header>

        <!-- Barra de Filtros de Itinerario -->
        <form id="formFiltrosOperaciones" class="filter-bar">
          <div class="form-group form-group-date">
            <label for="filtroFecha1"><i class="far fa-calendar-alt"></i> Fecha de Operación</label>
            <input type="date" id="filtroFecha1" name="fecha" class="form-control" required>
          </div>

          <div class="form-group form-group-date is-hidden" id="grupoFecha2">
            <label for="filtroFecha2"><i class="far fa-calendar-alt"></i> Hasta (Rango)</label>
            <input type="date" id="filtroFecha2" name="fecha2" class="form-control">
          </div>

          <div class="form-group">
            <label for="filtroOperador"><i class="fas fa-plane"></i> Aerolínea / Operador</label>
            <select id="filtroOperador" name="operadorId" class="form-control">
              <option value="">-- Seleccione una aerolínea / operador --</option>
              <% if (operadores && operadores.length > 0) { %>
                <% operadores.forEach(op => { %>
                  <option value="<%= op.OperadorId %>"><%= op.Nombre %></option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="filter-range-toggle">
            <input type="checkbox" id="checkRangoFechas" class="filter-range-checkbox">
            <label for="checkRangoFechas" class="filter-range-label">
              Activar Rango
            </label>
          </div>

          <button type="submit" id="btnConsultarOperaciones" class="btn btn-primary filter-submit-btn">
            <i class="fas fa-search"></i> Consultar
          </button>
        </form>

        <!-- Barra de estado de resultados -->
        <div id="barraResumenOperaciones" class="op-summary-bar is-hidden">
          <span id="textoResumenOperaciones"><i class="fas fa-info-circle op-summary-icon"></i> Listo</span>
        </div>

        <!-- Contenedor de Resultados -->
        <div id="gridOperaciones" class="operations-grid">
          <div class="op-empty-state">
            <i class="fas fa-search-location fa-3x op-empty-icon"></i>
            <h3 class="op-empty-title">Itinerarios sin vuelos cargados</h3>
            <p class="op-empty-desc">Seleccione una fecha y busque una aerolínea / operador en el cuadro combinado, luego presione Consultar para visualizar los vuelos.</p>
          </div>
        </div>
      </main>

      <%- include('partials/tab-bar', { activeTab: 'operaciones', user: user, vueloActivo: vueloActivo }) %>
      <%- include('partials/footer') %>
    </div>
  </div>
</body>
</html>
