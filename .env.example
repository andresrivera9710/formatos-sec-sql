# -------------------------------------------------------------
# CONFIGURACIÓN DEL ENTORNO - SIO FORMATOS SEC (LAATS)
# Copia este archivo a .env y completa con tus credenciales
# Para Azure App Service, configura estas claves en:
# Configuration > Application Settings (Environment variables)
# -------------------------------------------------------------

# Puerto y Entorno
# En local usa PORT=3000 y NODE_ENV=development
# En Azure App Service Linux usa PORT=8080 (o WEBSITES_PORT=8080) y NODE_ENV=production
PORT=3000
NODE_ENV=development

# Conexión Azure SQL Server (TLS obligatorio en producción)
DB_SERVER=tu-servidor.database.windows.net
DB_PORT=1433
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_password_seguro
DB_DATABASE=tu_base_datos_sio
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

# Seguridad de Sesión (Mínimo 32 caracteres aleatorios en producción)
SESSION_SECRET=laats_sec_session_secret_ultra_secure_key_2026_dev

# CORS (Orígenes permitidos separados por coma; WEBSITE_HOSTNAME de Azure se permite automáticamente)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tu-app-service.azurewebsites.net

# Repositorio permanente de Firmas Digitales en GitHub (Opcional; requiere Personal Access Token con permiso contents:write)
GITHUB_TOKEN=
GITHUB_SIGNATURES_OWNER=andresrivera9710
GITHUB_SIGNATURES_REPO=formatos-sec-sql
GITHUB_SIGNATURES_BRANCH=main
GITHUB_SIGNATURES_DIR=firmas

# Integración SharePoint Online vía Microsoft Entra ID / Microsoft Graph (Sites.ReadWrite.All)
# App de recursos Microsoft Graph: 00000003-0000-0000-c000-000000000000
# ID de permiso (Sites.ReadWrite.All): 9492366f-7969-46a4-8d15-ed1a20078fff
SHAREPOINT_ENABLED=true
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://laatsnet.sharepoint.com/sites/ArchivosOperativosSEC
SHAREPOINT_RESOURCE_APP_ID=00000003-0000-0000-c000-000000000000
SHAREPOINT_PERMISSION_ID=9492366f-7969-46a4-8d15-ed1a20078fff
SHAREPOINT_DRIVE_NAME=
SHAREPOINT_BASE_FOLDER=
SHAREPOINT_SYNC_INTERVAL_MS=60000
